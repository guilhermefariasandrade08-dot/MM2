--==============================================================--
--                    FLOAT DRAG SYSTEM                         --
--==============================================================--

local DraggingFloat = false
local FloatDragInput = nil
local FloatDragStart = nil
local FloatGrabOffset = nil
local FloatWasDragged = false

local FLOAT_DRAG_THRESHOLD = 8

local function ClampFloatButton(Position)

	local Camera = workspace.CurrentCamera

	if not Camera then
		return Position
	end

	local ViewportSize = Camera.ViewportSize
	local ButtonSize = FloatButton.AbsoluteSize

	local HalfX = ButtonSize.X / 2
	local HalfY = ButtonSize.Y / 2

	return Vector2.new(
		math.clamp(Position.X,HalfX,ViewportSize.X-HalfX),
		math.clamp(Position.Y,HalfY,ViewportSize.Y-HalfY)
	)
end

FloatButton.InputBegan:Connect(function(Input)

	local InputType = Input.UserInputType

	if InputType ~= Enum.UserInputType.MouseButton1
	and InputType ~= Enum.UserInputType.Touch then
		return
	end

	FloatDragInput = Input

	FloatDragStart = Vector2.new(
		Input.Position.X,
		Input.Position.Y
	)

	local AbsolutePosition = FloatButton.AbsolutePosition

	FloatGrabOffset =
		FloatDragStart -
		Vector2.new(
			AbsolutePosition.X,
			AbsolutePosition.Y
		)

	DraggingFloat = false
	FloatWasDragged = false
end)

UserInputService.InputChanged:Connect(function(Input)

	if not FloatDragInput then
		return
	end

	local InputType = Input.UserInputType

	if InputType ~= Enum.UserInputType.MouseMovement
	and InputType ~= Enum.UserInputType.Touch then
		return
	end

	local CurrentPosition = Vector2.new(
		Input.Position.X,
		Input.Position.Y
	)

	local Delta = CurrentPosition - FloatDragStart

	if FloatMovementLocked then
		return
	end

	if not DraggingFloat then
		if Delta.Magnitude < FLOAT_DRAG_THRESHOLD then
			return
		end

		DraggingFloat = true
		FloatWasDragged = true
	end

	local NewPosition = CurrentPosition - FloatGrabOffset
	local ClampedPosition = ClampFloatButton(NewPosition)

	FloatButton.Position = UDim2.fromOffset(
		math.floor(ClampedPosition.X+.5),
		math.floor(ClampedPosition.Y+.5)
	)
end)

UserInputService.InputEnded:Connect(function(Input)

	if Input == FloatDragInput then
		FloatDragInput = nil
		DraggingFloat = false
	end
end)

--==============================================================--
--                    SHOW / HIDE WINDOW                         --
--==============================================================--

ShowWindow = function()

	if WindowAnimating or WindowOpen or ScriptClosed then
		return
	end

	WindowAnimating = true
	WindowOpen = true

	Window.Visible = true

	Window.Size = UDim2.fromOffset(380,280)

	local Tween = TweenService:Create(
		Window,
		TweenInfo.new(
			.3,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(
				DEFAULT_WIDTH,
				DEFAULT_HEIGHT
			)
		}
	)

	Tween:Play()

	task.delay(.3,function()
		WindowAnimating = false
	end)
end

HideWindow = function()

	if WindowAnimating or not WindowOpen or ScriptClosed then
		return
	end

	WindowAnimating = true
	WindowOpen = false

	local Tween = TweenService:Create(
		Window,
		TweenInfo.new(
			.25,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),
		{
			Size = UDim2.fromOffset(380,280)
		}
	)

	Tween:Play()

	Tween.Completed:Connect(function()

		Window.Visible = false

		Window.Size = UDim2.fromOffset(
			DEFAULT_WIDTH,
			DEFAULT_HEIGHT
		)

		WindowAnimating = false
	end)
end

FloatButton.Activated:Connect(function()

	if ScriptClosed then
		return
	end

	if FloatWasDragged then
		FloatWasDragged = false
		return
	end

	if WindowOpen then
		HideWindow()
	else
		ShowWindow()
	end
end)

