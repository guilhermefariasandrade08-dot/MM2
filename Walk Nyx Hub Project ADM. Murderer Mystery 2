--==============================================================--
--                    CREATE LUCIDE ICON                        --
--==============================================================--

local function CreateLucideIcon(Parent,Name,Color,Size)

	Size = Size or 18

	if not Icons then
		return nil
	end

	local Success, Data = pcall(function()
		return Icons.Icon2(Name,"lucide")
	end)

	if not Success or type(Data) ~= "table" or not Data[1] then
		return nil
	end

	local Image = Instance.new("ImageLabel")

	Image.Name = "Icon"
	Image.AnchorPoint = Vector2.new(.5,.5)
	Image.Position = UDim2.fromScale(.5,.5)
	Image.Size = UDim2.fromOffset(Size,Size)

	Image.BackgroundTransparency = 1
	Image.BorderSizePixel = 0

	Image.Image = Data[1]
	Image.ImageColor3 = Color
	Image.ScaleType = Enum.ScaleType.Fit
	Image.ZIndex = 50

	if Data[2] then
		if Data[2].ImageRectSize then
			Image.ImageRectSize = Data[2].ImageRectSize
		end

		if Data[2].ImageRectPosition then
			Image.ImageRectOffset = Data[2].ImageRectPosition
		end
	end

	Image.Parent = Parent

	return Image
end

