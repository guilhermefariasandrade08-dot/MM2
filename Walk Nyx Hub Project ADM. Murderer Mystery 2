local KeyMap = {}

for _,KeyCode in ipairs(Enum.KeyCode:GetEnumItems()) do
	KeyMap[string.lower(KeyCode.Name)] = KeyCode
end

KeyBox.FocusLost:Connect(function()

	local Text = KeyBox.Text

	Text = string.gsub(Text,"%s+","")

	if Text == "" then

		KeyBox.Text = "RShift"
		OpenKey = Enum.KeyCode.RightShift

		return
	end

	local Lower = string.lower(Text)

	local Found

	if Lower == "rshift" then

		Found = Enum.KeyCode.RightShift

	elseif Lower == "lshift" then

		Found = Enum.KeyCode.LeftShift

	elseif Lower == "rctrl"
	or Lower == "rightctrl" then

		Found = Enum.KeyCode.RightControl

	elseif Lower == "lctrl"
	or Lower == "leftctrl" then

		Found = Enum.KeyCode.LeftControl

	elseif Lower == "space" then

		Found = Enum.KeyCode.Space

	else

		Found = KeyMap[Lower]
	end

	if Found then

		OpenKey = Found
		KeyBox.Text = Found.Name

	else

		KeyBox.Text = "RShift"
		OpenKey = Enum.KeyCode.RightShift
	end
end)

