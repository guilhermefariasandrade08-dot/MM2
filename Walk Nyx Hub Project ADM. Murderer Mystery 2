local function UpdateFloatSize(Value)

	Value = math.clamp(
		Value,
		MIN_FLOAT_SIZE,
		MAX_FLOAT_SIZE
	)

	Value = math.floor(Value+.5)

	FloatButtonSize = Value
	SizeValue.Text = tostring(Value)

	local Alpha =
		(Value-MIN_FLOAT_SIZE)/
		(MAX_FLOAT_SIZE-MIN_FLOAT_SIZE)

	SizeFill.Size = UDim2.new(Alpha,0,1,0)

	FloatButton.Size = UDim2.fromOffset(Value,Value)
end

local SizeDragging = false
local SizeInputConnections = {}

local function ClearSizeDragConnections()

	for _,Conn in ipairs(SizeInputConnections) do
		Conn:Disconnect()
	end

	SizeInputConnections = {}
end

local function UpdateSizeFromInput(Input)

	local SliderPosition = SizeSlider.AbsolutePosition
	local SliderWidth = SizeSlider.AbsoluteSize.X

	if SliderWidth <= 0 then
		return
	end

	local Alpha = math.clamp(
		(
			Input.Position.X-
			SliderPosition.X
		)/
		SliderWidth,
		0,
		1
	)

	local Value =
		MIN_FLOAT_SIZE+
		(MAX_FLOAT_SIZE-MIN_FLOAT_SIZE)*
		Alpha

	UpdateFloatSize(Value)
end

SizeSlider.InputBegan:Connect(function(Input)

	if Input.UserInputType ~= Enum.UserInputType.MouseButton1
	and Input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	SizeDragging = true

	ClearSizeDragConnections()
	UpdateSizeFromInput(Input)

	local MoveConn =
		UserInputService.InputChanged:Connect(function(Change)

			if not SizeDragging then
				return
			end

			if Change.UserInputType ~= Enum.UserInputType.MouseMovement
			and Change.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			UpdateSizeFromInput(Change)
		end)

	local EndConn =
		UserInputService.InputEnded:Connect(function(EndedInput)

			if EndedInput.UserInputType ==
				Enum.UserInputType.MouseButton1
				or
				EndedInput.UserInputType ==
				Enum.UserInputType.Touch then

				SizeDragging = false
				ClearSizeDragConnections()
			end
		end)

	table.insert(SizeInputConnections,MoveConn)
	table.insert(SizeInputConnections,EndConn)
end)

