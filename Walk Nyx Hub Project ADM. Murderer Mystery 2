--                   SIDEBAR EXPAND                             --
--==============================================================--

local function SetSidebarExpanded(State)

	SidebarExpanded = State

	local Width =
		State and SIDEBAR_EXPANDED or SIDEBAR_COMPACT

	local ContentX =
		State and 156 or 63

	local ContentWidth =
		State and -162 or -66

	TweenService:Create(
		Sidebar,
		TweenInfo.new(
			.25,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.new(
				0,
				Width,
				1,
				0
			)
		}
	):Play()

	TweenService:Create(
		Content,
		TweenInfo.new(
			.25,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.fromOffset(
				ContentX,
				0
			),

			Size = UDim2.new(
				1,
				ContentWidth,
				1,
				-10
			)
		}
	):Play()

	for _,Button in ipairs(TabButtons) do

		local Label =
			Button:FindFirstChild("Name")

		if Label then

			TweenService:Create(
				Label,
				TweenInfo.new(
					.18,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out
				),
				{
					TextTransparency =
						State and 0 or 1
				}
			):Play()
		end
	end
end

