--                         CLOSE                                --
--==============================================================--

CloseButton.Activated:Connect(function()

	if WindowAnimating or ScriptClosed then
		return
	end

	ColorMenu.Visible = false
	ConfirmOverlay.Visible = true

	ConfirmCard.Size = UDim2.fromOffset(240,115)

	TweenService:Create(
		ConfirmCard,
		TweenInfo.new(
			.22,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(280,135)
		}
	):Play()
end)

--==============================================================--
--                         CANCEL                               --
--==============================================================--

ConfirmNo.Activated:Connect(function()

	ConfirmOverlay.Visible = false

	ConfirmCard.Size = UDim2.fromOffset(280,135)

end)

--==============================================================--
--                       CONFIRM CLOSE                          --
--==============================================================--

ConfirmYes.Activated:Connect(function()

	ScriptClosed = true

	if ScreenGui then
		ScreenGui:Destroy()
	end

	if FloatGui then
		FloatGui:Destroy()
	end
end)

--==============================================================--
--                         KEY INPUT                             --
--==============================================================--

UserInputService.InputBegan:Connect(function(Input,GameProcessed)

	if GameProcessed or ScriptClosed then
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	if Input.KeyCode == OpenKey then

		if WindowOpen then
			HideWindow()
		else
			ShowWindow()
		end
	end
end)

