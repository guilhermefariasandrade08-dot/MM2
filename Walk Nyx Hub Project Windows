local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local ESPConfig = {
    Active = false,
    Mode = "Highlight"
}

local Highlights = {}
local DadosCargos = {}
local UltimaChecagemCargo = 0

local function LimparEsp()
    for _, highlight in pairs(Highlights) do
        if highlight then highlight:Destroy() end
    end
    table.clear(Highlights)
end

local function PegarCargos()
    if tick() - UltimaChecagemCargo < 2 then return end
    UltimaChecagemCargo = tick()
    task.spawn(function()
        local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if not R then return end
        local ok, d = pcall(function()
            return R:InvokeServer()
        end)
        if ok and d then
            DadosCargos = d
        end
    end)
end

local function ObterCorCargo(nomeJogador)
    local Info = DadosCargos[nomeJogador]
    local Cor = Color3.fromRGB(255, 255, 255) -- Branco para Lobby / Fora da partida
    
    if Info and not Info.Killed and not Info.Dead then
        if Info.Role == "Murderer" then
            Cor = Color3.fromRGB(220, 50, 50) -- Vermelho
        elseif Info.Role == "Sheriff" then
            Cor = Color3.fromRGB(0, 85, 255) -- Azul
        elseif Info.Role == "Hero" then
            Cor = Color3.fromRGB(255, 215, 0) -- Amarelo
        elseif Info.Role == "Innocent" then
            Cor = Color3.fromRGB(60, 200, 80) -- Verde
        end
    end
    return Cor
end

local function AtualizarEspJogador(p)
    if p == LocalPlayer then return end
    
    if Highlights[p] then
        Highlights[p]:Destroy()
        Highlights[p] = nil
    end

    if not ESPConfig.Active then return end

    local char = p.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local cor = ObterCorCargo(p.Name)

    local highlight = Instance.new("Highlight")
    highlight.Name = "WalkNyx_ESP"
    highlight.Adornee = char
    highlight.FillColor = cor
    highlight.OutlineColor = cor
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    if ESPConfig.Mode == "Highlight" then
        highlight.FillTransparency = 0.4        
        highlight.OutlineTransparency = 0       
    else 
        highlight.FillTransparency = 1          
        highlight.OutlineTransparency = 0       
    end

    highlight.Parent = char
    Highlights[p] = highlight
end

RunService.RenderStepped:Connect(function()
    if not ESPConfig.Active then return end
    PegarCargos()
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local highlight = Highlights[p]
            if not highlight or highlight.Parent ~= p.Character then
                AtualizarEspJogador(p)
            else
                local novaCor = ObterCorCargo(p.Name)
                highlight.FillColor = novaCor
                highlight.OutlineColor = novaCor
                
                if ESPConfig.Mode == "Highlight" then
                    highlight.FillTransparency = 0.4        
                    highlight.OutlineTransparency = 0       
                else 
                    highlight.FillTransparency = 1          
                    highlight.OutlineTransparency = 0       
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if Highlights[p] then
        Highlights[p]:Destroy()
        Highlights[p] = nil
    end
end)


