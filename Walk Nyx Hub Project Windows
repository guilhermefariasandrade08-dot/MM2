-- 2. VARIÁVEIS E FUNÇÕES DO SISTEMA 2: GRAB & TELEPORT GUN
-- =========================================================================
local GrabButtonGui = nil
local isDraggingGrab = false
local GrabPressed = false

local currentGrabBtnRef = nil
local currentGrabCornerRef = nil
local tamanhoGrabBase = 250
local formatoGrabAtual = "Retangulo"
local modoGrabAtual = "Grab"

local function GetGunDrop()
    local MapContainer = workspace:FindFirstChild("CoinContainer", true) and workspace:FindFirstChild("CoinContainer", true).Parent
    local mapToSearch = MapContainer or workspace
    local gunDrop = mapToSearch:FindFirstChild("GunDrop", true) or workspace:FindFirstChild("GunDrop", true)
    if gunDrop and gunDrop:IsA("BasePart") then
        return gunDrop
    end
    return nil
end

local function AtualizarTextoGrab(TextoLabel, customText)
    if not TextoLabel or not TextoLabel.Parent then return end
    if customText then
        TextoLabel.Text = customText
    else
        if modoGrabAtual == "Grab" then
            TextoLabel.Text = "Grab Gun"
        else
            TextoLabel.Text = "Teleport to Gun"
        end
    end
end

local function TriggerGrabGun(TextoLabel)
    if GrabPressed then return end
    
    local Char = LocalPlayer.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end
    
    local gunDrop = GetGunDrop()
    
    if not gunDrop then
        AtualizarTextoGrab(TextoLabel, "No Drop!")
        task.delay(1.2, function()
            AtualizarTextoGrab(TextoLabel)
        end)
        return
    end
    
    GrabPressed = true
    
    if modoGrabAtual == "Grab" then
        gunDrop.CFrame = Char.HumanoidRootPart.CFrame
        AtualizarTextoGrab(TextoLabel, "Grabbed!")
        task.delay(1.2, function()
            AtualizarTextoGrab(TextoLabel)
            GrabPressed = false
        end)
        
    elseif modoGrabAtual == "Teleport" then
        local posOriginal = Char.HumanoidRootPart.CFrame
        Char.HumanoidRootPart.CFrame = gunDrop.CFrame
        task.wait(0.08)
        
        if Char and Char:FindFirstChild("HumanoidRootPart") then
            Char.HumanoidRootPart.CFrame = posOriginal
        end
        
        AtualizarTextoGrab(TextoLabel, "Teleported!")
        task.delay(1.2, function()
            AtualizarTextoGrab(TextoLabel)
            GrabPressed = false
        end)
    end
end

local function AplicarFormatoGrab()
    if not currentGrabBtnRef or not currentGrabCornerRef then return end
    local val = tamanhoGrabBase
    if formatoGrabAtual == "Retangulo" then
        currentGrabBtnRef.Size = UDim2.new(0, val, 0, val / 2.5)
        currentGrabCornerRef.CornerRadius = UDim.new(0, 8)
    elseif formatoGrabAtual == "Quadrado" then
        currentGrabBtnRef.Size = UDim2.new(0, val, 0, val)
        currentGrabCornerRef.CornerRadius = UDim.new(0, 8)
    elseif formatoGrabAtual == "Circulo" then
        currentGrabBtnRef.Size = UDim2.new(0, val, 0, val)
        currentGrabCornerRef.CornerRadius = UDim.new(1, 0)
    end
end

local function CreateGrabButton()
    if GrabButtonGui then return end
    
    local ParentGui = CoreGui
    pcall(function() if not CoreGui then ParentGui = LocalPlayer:WaitForChild("PlayerGui") end end)
    
    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "Sheriff_GrabGunGui"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = ParentGui
    
    local Btn = Instance.new("ImageButton")
    Btn.AnchorPoint = Vector2.new(0.5, 0.5)
    Btn.Position = UDim2.new(0.5, 0, 0.45, 0)
    Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Btn.BackgroundTransparency = 0.4
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.Parent = GuiBtn
    
    currentGrabBtnRef = Btn
    
    local Corner = Instance.new("UICorner")
    Corner.Parent = Btn
    currentGrabCornerRef = Corner
    
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(255, 255, 255)
    Borda.Thickness = 1.5
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn
    
    local Texto = Instance.new("TextLabel")
    Texto.Name = "GrabText"
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.TextColor3 = Color3.fromRGB(255, 255, 255)
    Texto.Font = Enum.Font.SourceSans
    Texto.Parent = Btn
    
    AtualizarTextoGrab(Texto)
    AplicarFormatoGrab()
    Texto.TextSize = math.clamp(math.floor(tamanhoGrabBase / 12.5), 12, 24)
    
    local dragStart, startPos
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingGrab = false
            dragStart = input.Position
            startPos = Btn.AbsolutePosition
        end
    end)
    
    Btn.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) and dragStart then
            local delta = input.Position - dragStart
            if delta.Magnitude > 10 then
                isDraggingGrab = true
                Btn.Position = UDim2.new(0, startPos.X + delta.X + (Btn.AbsoluteSize.X / 2), 0, startPos.Y + delta.Y + (Btn.AbsoluteSize.Y / 2))
            end
        end
    end)
    
    Btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not isDraggingGrab then
                TriggerGrabGun(Texto)
            end
            dragStart = nil
            isDraggingGrab = false
        end
    end)
    
    GrabButtonGui = GuiBtn
end

local function RemoveGrabButton()
    if GrabButtonGui then
        GrabButtonGui:Destroy()
        GrabButtonGui = nil
        currentGrabBtnRef = nil
        currentGrabCornerRef = nil
    end
end

