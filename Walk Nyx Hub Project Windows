-- =========================================================================
-- 1. VARIÁVEIS E FUNÇÕES DO SISTEMA 1: SILENT AIM
-- =========================================================================
local SilentButtonGui = nil
local isDraggingSilent = false
local SilentPressed = false
local ShootPredictMultiplier = 1

local currentSilentBtnRef = nil
local currentSilentCornerRef = nil
local tamanhoSilentBase = 250
local formatoSilentAtual = "Retangulo"

local function GetPing()
    local ok, value = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and value or 100
end

local function GetMurderer()
    local DataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not DataRemote then return nil end
    local ok, Data = pcall(function() return DataRemote:InvokeServer() end)
    if not ok or not Data then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local Info = Data[p.Name]
            if Info and not Info.Killed and not Info.Dead then
                local isMurderer = false
                if Info.Role == "Murderer" or (Info.Role and string.lower(Info.Role) == "murderer") then
                    isMurderer = true
                end
                if isMurderer then return p end
            end
        end
    end
    return nil
end

local function ShootMurderer(TextoLabel)
    if SilentPressed then return end

    local Char = LocalPlayer.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end

    local Gun = Char:FindFirstChild("Gun") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
    
    if not Gun then
        if TextoLabel then
            TextoLabel.Text = "N o    D r o p"
            task.delay(1, function()
                if TextoLabel and TextoLabel.Parent then
                    TextoLabel.Text = "S i l e n t    A I M"
                end
            end)
        end
        return 
    end

    SilentPressed = true

    if Gun.Parent ~= Char then
        Gun.Parent = Char
        task.wait(0.05)
    end

    local Murderer = GetMurderer()
    if not Murderer or not Murderer.Character then 
        SilentPressed = false 
        return 
    end

    local TargetHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    local TargetTorso = Murderer.Character:FindFirstChild("Torso") or Murderer.Character:FindFirstChild("UpperTorso")
    if not TargetHRP or not TargetTorso then 
        SilentPressed = false 
        return 
    end

    local Ping = GetPing()
    local PredictionTime = (Ping / 1000) * (ShootPredictMultiplier or 1)
    local Velocity = TargetHRP.Velocity
    local PredictedPos = Velocity.Magnitude < 1 and TargetTorso.Position or TargetTorso.Position + (Velocity * PredictionTime)
    
    local MyPos = Char.HumanoidRootPart.Position
    local RayDirection = (PredictedPos - MyPos)
    
    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.FilterDescendantsInstances = {Char, Murderer.Character}
    RayParams.IgnoreWater = true

    local RayResult = workspace:Raycast(MyPos, RayDirection, RayParams)
    local OriginCFrame = RayResult and CFrame.new(RayResult.Position + (RayDirection.Unit * 1.5), PredictedPos) or CFrame.new(MyPos, PredictedPos)

    local ShootEvent = Gun:FindFirstChild("ShootEvent", true) or Gun:FindFirstChild("Shoot", true) or ReplicatedStorage:FindFirstChild("Shoot", true)
    if ShootEvent then
        if ShootEvent:IsA("RemoteEvent") then
            ShootEvent:FireServer(OriginCFrame, CFrame.new(PredictedPos))
        elseif ShootEvent:IsA("RemoteFunction") then
            ShootEvent:InvokeServer(OriginCFrame, CFrame.new(PredictedPos))
        end
    end

    task.wait(0.3)
    SilentPressed = false
end

