-- SISTEMA DE FPS BOOSTER / TUDO CINZA & ARMAS (AUTOMÁTICO)
-- ==================================
local Lighting = game:GetService("Lighting")
local Terrain = workspace:FindFirstChildOfClass("Terrain")

local fpsBoosterAtivo = false

local function PintarELevarPart(v)
    if v:IsA("BasePart") then
        -- Ignora o personagem do jogador para não deixar o seu avatar cinza (opcional, se quiser deixar o avatar cinza também, remova essa linha)
        local player = game:GetService("Players").LocalPlayer
        if player.Character and v:IsDescendantOf(player.Character) then return end

        v.Material = Enum.Material.SmoothPlastic
        v.Color = Color3.fromRGB(130, 130, 130) -- Deixa o objeto totalmente cinza (chão, paredes, armas, caixas, etc)
        v.CastShadow = false
        v.Reflectance = 0
    elseif v:IsA("Decal" or v:IsA("Texture")) then
        v:Destroy()
    elseif v:IsA("ParticleEmitter" or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles")) then
        v:Destroy()
    end
end

local function ExecutarFPSBoosterCompleto()
    fpsBoosterAtivo = true

    -- 1. Destruir efeitos de iluminação e brilho do sol
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("BloomEffect") then
            v:Destroy()
        end
    end

    -- 2. Configurar Iluminação totalmente plana e sem reflexos
    Lighting.GlobalShadows = false
    Lighting.Brightness = 0.5
    Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 140)
    Lighting.Ambient = Color3.fromRGB(120, 120, 120)

    -- 3. Limpar Terrain (Água/Grama)
    if Terrain then
        pcall(function()
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveTransparency = 0
            Terrain.WaterReflectance = 0
            Terrain.WaterTransparency = 0
            Terrain.Decoration = false
        end)
    end

    -- 4. Pintar tudo o que já existe no jogo agora (mapa atual, caixas, armas, etc)
    for _, v in ipairs(workspace:GetDescendants()) do
        PintarELevarPart(v)
    end

    -- 5. Monitorar se o mapa muda ou se novas coisas (armas, caixas, rounds novos) aparecem
    workspace.DescendantAdded:Connect(function(v)
        if fpsBoosterAtivo then
            task.spawn(function()
                task.wait(0.05) -- Pequeno delay para garantir que a peça carregou
                PintarELevarPart(v)
            end)
        end
    end)

    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end

