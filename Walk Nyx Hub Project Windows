local function RestaurarColisoes()
    local char = game:GetService("Players").LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = (part.Name == "HumanoidRootPart" or part.Name == "Head" or part.Name == "UpperTorso" or part.Name == "LowerTorso")
            end
        end
    end
end

FarmCoin:Toggle({
    Title = "Auto Farm Coins",
    Value = false,
    Callback = function(state)
        CONFIG_FARM.Active = state
        if not state then
            RestaurarColisoes()
        end
    end,
})

