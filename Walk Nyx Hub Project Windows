-- ==================================
-- ANIMAÇÃO DE CLIQUE (ENCOLHER E VOLTAR)
-- ==================================
FloatingButton.MouseButton1Click:Connect(function()
    local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    -- Encolhe levemente
    local shrink = TweenService:Create(FloatingButton, tweenInfo, {Size = UDim2.new(0, tamanhoAtual * 0.9, 0, (tamanhoAtual * 0.35) * 0.9)})
    shrink:Play()
    
    shrink.Completed:Connect(function()
        -- Volta ao tamanho original
        local expand = TweenService:Create(FloatingButton, tweenInfo, {Size = UDim2.new(0, tamanhoAtual, 0, formatoAtual == "Quadrado" and tamanhoAtual or (tamanhoAtual * 0.35))})
        expand:Play()
    end)
    
    -- Coloque aqui a função do seu Silent AIM se quiser ativar/desativar ao clicar no botão:
    print("Silent AIM acionado pelo botão flutuante!")
end)

-- Sistema simples para poder arrastar o botão pela tela no celular/PC
local dragging, dragInput, dragStart, startPos
FloatingButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = FloatingButton.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

FloatingButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        FloatingButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)


