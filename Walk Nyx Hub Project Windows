FarmCoin:Button({
    Title = "Copiar Posição e Mapa",
    Desc = "Copia para o clipboard o nome do mapa atual e suas coordenadas exatas.",
    Callback = function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if not hrp then
            WindUI:Notify({ Title = "Erro", Content = "Personagem não encontrado!", Duration = 3 })
            return
        end

        local mapName = "Desconhecido"
        local coinContainer = Workspace:FindFirstChild("CoinContainer", true)
        if coinContainer and coinContainer.Parent then
            mapName = coinContainer.Parent.Name
        end

        local pos = hrp.Position
        local resultString = string.format('["%s"] = Vector3.new(%.2f, %.2f, %.2f),', mapName, pos.X, pos.Y, pos.Z)
        
        if setclipboard then
            setclipboard(resultString)
            WindUI:Notify({ Title = "Sucesso!", Content = "Copiado: " .. resultString, Duration = 4 })
        else
            WindUI:Notify({ Title = "Aviso", Content = "Seu executor não suporta setclipboard automático.", Duration = 4 })
            print("[Walk Nyx Hub] Posição: " .. resultString)
        end
    end,
})

