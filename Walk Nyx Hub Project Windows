--==============================================================--
--                SISTEMA DE TRACERS (LINHAS ESP)               --
--==============================================================--

local TracersConfig = {
    Active = false,
    Position = "Bottom",
    Thickness = 1
}

local TracersList = {}

local function LimparTracers()
    for _, line in pairs(TracersList) do
        if line then line:Remove() end
    end
    table.clear(TracersList)
end

RunService.RenderStepped:Connect(function()
    TracersConfig_Active_Check = TracersConfig.Active
    if not TracersConfig.Active then
        LimparTracers()
        return
    end

    local screenSize = Camera.ViewportSize
    local originPoint = Vector2.new(screenSize.X / 2, screenSize.Y)

    if TracersConfig.Position == "Top" then
        originPoint = Vector2.new(screenSize.X / 2, 0)
    elseif TracersConfig.Position == "Middle" then
        originPoint = Vector2.new(screenSize.X / 2, screenSize.Y / 2)
    elseif TracersConfig.Position == "Bottom" then
        originPoint = Vector2.new(screenSize.X / 2, screenSize.Y)
    end

    local jogadoresAtivos = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                jogadoresAtivos[p] = true
                
                if not TracersList[p] then
                    local line = Drawing.new("Line")
                    line.Visible = false
                    TracersList[p] = line
                end

                local line = TracersList[p]
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    line.From = originPoint
                    line.To = Vector2.new(vector.X, vector.Y)
                    line.Color = ObterCorCargo(p.Name)
                    line.Thickness = TracersConfig.Thickness
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
        end
    end

    for p, line in pairs(TracersList) do
        if not jogadoresAtivos[p] or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
            if line then line:Remove() end
            TracersList[p] = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if TracersList[p] then
        TracersList[p]:Remove()
        TracersList[p] = nil
    end
end)

--==============================================================--
--                     SISTEMA DE BOX ESP                       --
--==============================================================--

local BoxESPList = {}

local function LimparBoxESP()
    for _, boxObj in pairs(BoxESPList) do
        if boxObj then
            if boxObj.Box then boxObj.Box:Remove() end
            if boxObj.Lines then
                for _, line in ipairs(boxObj.Lines) do
                    if line then line:Remove() end
                end
            end
        end
    end
    table.clear(BoxESPList)
end

RunService.RenderStepped:Connect(function()
    if not BoxESPConfig.Active then
        LimparBoxESP()
        return
    end

    local jogadoresAtivos = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                jogadoresAtivos[p] = true
                
                -- Se o estilo mudou, destrói o antigo para recriar do jeito certo
                if BoxESPList[p] and BoxESPList[p].Style ~= BoxESPConfig.Style then
                    if BoxESPList[p].Box then BoxESPList[p].Box:Remove() end
                    if BoxESPList[p].Lines then
                        for _, l in ipairs(BoxESPList[p].Lines) do l:Remove() end
                    end
                    BoxESPList[p] = nil
                end

                if not BoxESPList[p] then
                    local boxParts = { Style = BoxESPConfig.Style }
                    if BoxESPConfig.Style == "Simple" then
                        boxParts.Box = Drawing.new("Square")
                        boxParts.Box.Visible = false
                        boxParts.Box.Filled = false
                        boxParts.Box.Thickness = BoxESPConfig.Thickness
                    else
                        boxParts.Lines = {}
                        for i = 1, 8 do
                            local line = Drawing.new("Line")
                            line.Visible = false
                            line.Thickness = BoxESPConfig.Thickness
                            table.insert(boxParts.Lines, line)
                        end
                    end
                    BoxESPList[p] = boxParts
                end

                local boxData = BoxESPList[p]
                local corCargo = ObterCorCargo(p.Name)
                local head = char:FindFirstChild("Head")
                
                if head then
                    local headPos, onScreenHead = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos, onScreenLeg = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    
                    if onScreenHead or onScreenLeg then
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height / 2
                        local pos = Vector2.new(headPos.X - width / 2, headPos.Y)

                        if BoxESPConfig.Style == "Simple" and boxData.Box then
                            boxData.Box.Size = Vector2.new(width, height)
                            boxData.Box.Position = pos
                            boxData.Box.Color = corCargo
                            boxData.Box.Thickness = BoxESPConfig.Thickness
                            boxData.Box.Visible = true
                            
                            if boxData.Lines then
                                for _, l in ipairs(boxData.Lines) do l.Visible = false end
                            end
                        elseif BoxESPConfig.Style == "Corner" and boxData.Lines then
                            if boxData.Box then boxData.Box.Visible = false end
                            
                            local w = width
                            local h = height
                            local x = pos.X
                            local y = pos.Y
                            local lengthX = w / 4
                            local lengthY = h / 4

                            local lines = boxData.Lines
                            for _, l in ipairs(lines) do 
                                l.Color = corCargo 
                                l.Thickness = BoxESPConfig.Thickness
                            end

                            lines[1].From = Vector2.new(x, y); lines[1].To = Vector2.new(x + lengthX, y)
                            lines[2].From = Vector2.new(x, y); lines[2].To = Vector2.new(x, y + lengthY)
                            
                            lines[3].From = Vector2.new(x + w, y); lines[3].To = Vector2.new(x + w - lengthX, y)
                            lines[4].From = Vector2.new(x + w, y); lines[4].To = Vector2.new(x + w, y + lengthY)
                            
                            lines[5].From = Vector2.new(x, y + h); lines[5].To = Vector2.new(x + lengthX, y + h)
                            lines[6].From = Vector2.new(x, y + h); lines[6].To = Vector2.new(x, y + h - lengthY)
                            
                            lines[7].From = Vector2.new(x + w, y + h); lines[7].To = Vector2.new(x + w - lengthX, y + h)
                            lines[8].From = Vector2.new(x + w, y + h); lines[8].To = Vector2.new(x + w, y + h - lengthY)

                            for _, l in ipairs(lines) do l.Visible = true end
                        end
                    else
                        if boxData.Box then boxData.Box.Visible = false end
                        if boxData.Lines then for _, l in ipairs(boxData.Lines) do l.Visible = false end end
                    end
                end
            end
        end
    end

    for p, boxObj in pairs(BoxESPList) do
        if not jogadoresAtivos[p] then
            if boxObj then
                if boxObj.Box then boxObj.Box:Remove() end
                if boxObj.Lines then for _, l in ipairs(boxObj.Lines) do l:Remove() end end
            end
            BoxESPList[p] = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if BoxESPList[p] then
        if BoxESPList[p].Box then BoxESPList[p].Box:Remove() end
        if BoxESPList[p].Lines then for _, l in ipairs(BoxESPList[p].Lines) do l:Remove() end end
        BoxESPList[p] = nil
    end
end)

