local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local collectedCoins = {}
local cachedCoinContainer = nil
local HitboxOriginal = {}
local StoppedUntilNewRound = false
local bagFullByEvent = false
local lastBagCheck = 0
local lastBagCheckResult = false
local safePlatformInstance = nil

task.spawn(function()
    local p = Instance.new("Part")
    p.Name = "SafePlatform_NyxHub"
    p.Size = Vector3.new(30, 1, 30)
    p.Position = Vector3.new(0, 5000, 0)
    p.Anchored = true
    p.CanCollide = true
    p.Transparency = 0.5
    p.Parent = Workspace
    safePlatformInstance = p
end)

local function GetMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local hasKnife = char:FindFirstChild("Knife") or (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife"))
                if p:GetAttribute("Role") == "Murderer" or hasKnife then return char end
            end
        end
    end
    return nil
end

local function ResetFarmState()
    table.clear(collectedCoins)
    cachedCoinContainer = nil
    table.clear(HitboxOriginal)
    StoppedUntilNewRound = false
    bagFullByEvent = false
    RestaurarColisoes()
    local c = Player.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
end

Player.CharacterAdded:Connect(ResetFarmState)

Player:GetAttributeChangedSignal("Alive"):Connect(function()
    if Player:GetAttribute("Alive") == true then
        ResetFarmState()
    end
end)

task.spawn(function()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes", true) or ReplicatedStorage:FindFirstChild("Gameplay", true)
    if remotes then
        for _, remote in ipairs(remotes:GetDescendants()) do
            if remote:IsA("RemoteEvent") and (string.find(string.lower(remote.Name), "coin") or string.find(string.lower(remote.Name), "collect")) then
                remote.OnClientEvent:Connect(function(collector, current, maximum)
                    if collector == Player or (typeof(collector) == "string" and collector == Player.Name) then
                        if tonumber(current) and tonumber(maximum) then
                            bagFullByEvent = (tonumber(current) >= tonumber(maximum))
                            if bagFullByEvent then
                                StoppedUntilNewRound = false
                            end
                        end
                    end
                end)
            end
        end
    end
end)

local function CheckBagFullText()
    if bagFullByEvent then return true end
    local now = os.clock()
    if now - lastBagCheck < 0.3 then return lastBagCheckResult end
    lastBagCheck = now

    local playerGui = Player:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local mainGui = playerGui:FindFirstChild("MainGUI") or playerGui:FindFirstChild("GUI")
    if not mainGui then return false end

    for _, gui in ipairs(mainGui:GetDescendants()) do
        if gui:IsA("TextLabel") and gui.Visible and gui.Text ~= "" then
            local text = string.lower(gui.Text)
            if (string.find(text, "bag") and string.find(text, "full")) or
               string.find(text, "full coin") or string.find(text, "max coins") or
               (string.find(text, "saco") and string.find(text, "cheio")) then
                lastBagCheckResult = true
                return true
            end
        end
    end
    lastBagCheckResult = false
    return false
end

local function InGame()
    local c = Player.Character
    if not c or not c:FindFirstChild("Humanoid") or c.Humanoid.Health <= 0 then return false end
    if not c:FindFirstChild("HumanoidRootPart") then return false end

    local aliveAttr = Player:GetAttribute("Alive")
    if aliveAttr ~= nil and aliveAttr == false then return false end

    if Workspace:FindFirstChild("Lobby") then
        local lobbyDist = (c.HumanoidRootPart.Position - Workspace.Lobby:GetPivot().Position).Magnitude
        if lobbyDist < 100 then return false end
    end
    return true
end

local function GetSafePlatformCFrame()
    if not safePlatformInstance or not safePlatformInstance.Parent then
        local p = Instance.new("Part")
        p.Name = "SafePlatform_NyxHub"
        p.Size = Vector3.new(30, 1, 30)
        p.Position = Vector3.new(0, 5000, 0)
        p.Anchored = true
        p.CanCollide = true
        p.Transparency = 0.5
        p.Parent = Workspace
        safePlatformInstance = p
    end
    return safePlatformInstance.CFrame + Vector3.new(0, 3.5, 0)
end

local function GetSafeMapSpawn()
    local coinContainer = Workspace:FindFirstChild("CoinContainer", true)
    if coinContainer and coinContainer.Parent then
        local map = coinContainer.Parent
        local mapName = map.Name

        if MAP_SAFE_POSITIONS[mapName] then
            local pos = MAP_SAFE_POSITIONS[mapName]
            return CFrame.new(pos) + Vector3.new(0, 3.5, 0)
        end
    end
    return nil
end

local function GetNearestCoin(myPos)
    local bestCoin, shortestDist = nil, math.huge
    if not cachedCoinContainer or not cachedCoinContainer.Parent then
        cachedCoinContainer = Workspace:FindFirstChild("CoinContainer", true)
    end
    if not cachedCoinContainer then return nil end

    local charMurderer = GetMurderer()
    local hrpMurderer = charMurderer and charMurderer:FindFirstChild("HumanoidRootPart")

    for _, coin in ipairs(cachedCoinContainer:GetChildren()) do
        if coin:IsA("BasePart") and coin.Name == "Coin_Server" and coin:FindFirstChild("TouchInterest") and not collectedCoins[coin] and not coin:GetAttribute("Collected") then
            if not HitboxOriginal[coin] then
                HitboxOriginal[coin] = coin.Size
                coin.Size = Vector3.new(5, 15, 5)
                coin.Transparency = 1
                coin.CanCollide = false
            end
            if hrpMurderer then
                if (coin.Position - hrpMurderer.Position).Magnitude <= CONFIG_FARM.MurdererDangerRadius then continue end
            end
            local distVal = (myPos - coin.Position).Magnitude
            if distVal < CONFIG_FARM.MaxDistance and distVal < shortestDist then
                shortestDist = distVal
                bestCoin = coin
            end
        end
    end
    return bestCoin
end

task.spawn(function()
    while true do
        task.wait(0.3)
        local isBagFull = CheckBagFullText()

        local currentCoinContainer = Workspace:FindFirstChild("CoinContainer", true)
        if currentCoinContainer ~= cachedCoinContainer then
            cachedCoinContainer = currentCoinContainer
            StoppedUntilNewRound = false
            bagFullByEvent = false
        end

        if not InGame() then
            StoppedUntilNewRound = false
        end

        if not StoppedUntilNewRound and InGame() and isBagFull then
            RestaurarColisoes()
            
            task.wait(0.3)

            if InGame() then
                local char = Player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                local finalDestination = nil
                if CONFIG_FARM.FullDestination == "Map" then
                    finalDestination = GetSafeMapSpawn()
                else
                    finalDestination = GetSafePlatformCFrame()
                end

                if finalDestination then
                    StoppedUntilNewRound = true
                    if hum then hum.PlatformStand = true end
                    
                    local holdStart = os.clock()
                    while os.clock() - holdStart < 0.5 and InGame() do
                        hrp.CFrame = finalDestination
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        RunService.Heartbeat:Wait()
                    end
                    
                    if hum and InGame() then
                        hum.PlatformStand = false
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        if CONFIG_FARM.Active and not StoppedUntilNewRound then
            local c = Player.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            local humanoid = c and c:FindFirstChildOfClass("Humanoid")

            if not InGame() or not hrp or not humanoid then
                RestaurarColisoes()
                if humanoid then humanoid.PlatformStand = false end
                task.wait(0.4)
                continue
            end

            if CheckBagFullText() then
                RestaurarColisoes()
                humanoid.PlatformStand = false
                task.wait(0.2)
                continue
            end

            local target = GetNearestCoin(hrp.Position)
            if target then
                while CONFIG_FARM.Active and not StoppedUntilNewRound and InGame() and target and target.Parent
                and not CheckBagFullText() and not target:GetAttribute("Collected") and not collectedCoins[target] do

                    humanoid.PlatformStand = true

                    local currentPos = hrp.Position
                    local nearestNow = GetNearestCoin(currentPos)
                    if nearestNow and nearestNow ~= target then
                        target = nearestNow
                    end

                    if not target:IsDescendantOf(Workspace) or target:GetAttribute("Collected") or CheckBagFullText() then
                        break
                    end

                    local heightOffset = (CONFIG_FARM.Posture == "Lying") and Vector3.new(0, 4, 0) or Vector3.new(0, 0, 0)
                    local targetPos = target.Position - heightOffset
                    local direction = (targetPos - currentPos)
                    local distance = direction.Magnitude

                    if CONFIG_FARM.Movement == "Tween" then
                        local travelSpeed = math.clamp(CONFIG_FARM.Speed, 1, 50)
                        local travelTime = distance / travelSpeed
                        if travelTime < 0.1 then travelTime = 0.1 end
                        
                        local targetCFrame = (CONFIG_FARM.Posture == "Lying") 
                            and (CFrame.new(targetPos) * CFrame.Angles(math.rad(90), 0, 0)) 
                            or CFrame.new(targetPos)

                        local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
                        tween:Play()

                        local startTime = os.clock()
                        while tween.PlaybackState == Enum.PlaybackState.Playing and CONFIG_FARM.Active and not StoppedUntilNewRound do
                            if not InGame() or not target.Parent or target:GetAttribute("Collected") or CheckBagFullText() then
                                tween:Cancel()
                                break
                            end
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            RunService.Heartbeat:Wait()
                            if os.clock() - startTime > (travelTime + 1) then
                                tween:Cancel()
                                break
                            end
                        end

                        collectedCoins[target] = true
                        break
                    else
                        if distance <= 0.8 then
                            local waitStart = os.clock()
                            local fixedRotation = (CONFIG_FARM.Posture == "Lying") 
                                and (CFrame.new(targetPos) * CFrame.Angles(math.rad(90), 0, 0)) 
                                or CFrame.new(targetPos)

                            while CONFIG_FARM.Active and not StoppedUntilNewRound and os.clock() - waitStart < 3 do
                                if not InGame() or not target.Parent or target:GetAttribute("Collected") or CheckBagFullText() then break end
                                hrp.CFrame = fixedRotation
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                RunService.Heartbeat:Wait()
                            end

                            collectedCoins[target] = true
                            break
                        end

                        local currentSpeed = math.clamp(CONFIG_FARM.Speed, 16, 25)
                        local dt = RunService.Heartbeat:Wait()
                        local step = math.min(currentSpeed * dt, distance)
                        local newPos = currentPos + (direction.Unit * step)

                        hrp.CFrame = (CONFIG_FARM.Posture == "Lying") 
                            and (CFrame.new(newPos) * CFrame.Angles(math.rad(90), 0, 0)) 
                            or CFrame.new(newPos)
                            
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end

                humanoid.PlatformStand = false
            else
                RestaurarColisoes()
                humanoid.PlatformStand = false
                task.wait(0.3)
            end
        else
            RestaurarColisoes()
            local c = Player.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            task.wait(0.4)
        end
    end
end)
