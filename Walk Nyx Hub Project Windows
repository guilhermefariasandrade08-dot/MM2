local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ThrowButtonGui = nil
local isDraggingThrow = false

local currentThrowBtnRef = nil
local currentThrowCornerRef = nil
local currentThrowStrokeRef = nil
local tamanhoThrowBase = 150 -- Valor inicial ajustado para 150
local formatoThrowAtual = "Retangulo"

-- Função para checar se o jogador tem a faca
local function PlayerTemFaca()
    local Char = LocalPlayer.Character
    if not Char then return false end
    if Char:FindFirstChild("Knife") then return true end
    if LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife") then return true end
    return false
end

-- Função para achar o alvo mais próximo na frente
local function GetClosestPlayerFrontCFrame()
    local closestCharacter = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil, nil end
    local myHRP = myChar.HumanoidRootPart
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                local targetHRP = p.Character.HumanoidRootPart
                local distance = (myHRP.Position - targetHRP.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestCharacter = p.Character
                end
            end
        end
    end
    
    if closestCharacter then
        local hrp = closestCharacter.HumanoidRootPart
        return hrp.CFrame + (hrp.CFrame.LookVector * 2), hrp.CFrame
    end
    return nil, nil
end

-- Função de Lançar Faca
local function ExecuteThrowKnife(TextoLabel)
    local Char = LocalPlayer.Character
    local knife = Char and Char:FindFirstChild("Knife") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife"))
    
    -- Verifica se tem faca e o evento de arremesso
    if knife and knife:FindFirstChild("Events") and knife.Events:FindFirstChild("KnifeThrown") then
        local frontTarget, exactTarget = GetClosestPlayerFrontCFrame()
        if frontTarget and exactTarget then
            local args = {frontTarget, exactTarget}
            knife.Events.KnifeThrown:FireServer(unpack(args))
        else
            if TextoLabel then
                TextoLabel.Text = "T a r g e t    N o t    F o u n d"
                task.delay(1, function()
                    if TextoLabel and TextoLabel.Parent then
                        TextoLabel.Text = "T h r o w    K a n i f"
                    end
                end)
            end
        end
    else
        -- Caso não tenha a faca/não seja murderer, avisa temporariamente por 1 segundo e volta
        if TextoLabel then
            TextoLabel.Text = "N o t    K a n i f"
            task.delay(1, function()
                if TextoLabel and TextoLabel.Parent then
                    TextoLabel.Text = "T h r o w    K a n i f"
                end
            end)
        end
    end
end

-- Aplicar Formato do Botão Flutuante
local function AplicarFormatoThrow()
    if not currentThrowBtnRef or not currentThrowCornerRef then return end
    local val = tamanhoThrowBase
    if formatoThrowAtual == "Retangulo" then
        currentThrowBtnRef.Size = UDim2.new(0, val, 0, val / 2.5)
        currentThrowCornerRef.CornerRadius = UDim.new(0, 8)
    elseif formatoThrowAtual == "Quadrado" then
        currentThrowBtnRef.Size = UDim2.new(0, val, 0, val)
        currentThrowCornerRef.CornerRadius = UDim.new(0, 8)
    elseif formatoThrowAtual == "Circulo" then
        currentThrowBtnRef.Size = UDim2.new(0, val, 0, val)
        currentThrowCornerRef.CornerRadius = UDim.new(1, 0)
    end
end

-- Criar o Botão Flutuante
local function CreateThrowButton()
    if ThrowButtonGui then return end
    
    local ParentGui = CoreGui
    pcall(function() if not CoreGui then ParentGui = LocalPlayer:WaitForChild("PlayerGui") end end)
    
    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "Murderer_ThrowKnifeGui"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = ParentGui
    
    local Btn = Instance.new("ImageButton")
    Btn.AnchorPoint = Vector2.new(0.5, 0.5)
    Btn.Position = UDim2.new(0.5, 0, 0.4, 0)
    Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Btn.BackgroundTransparency = 0.4
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.Parent = GuiBtn
    
    currentThrowBtnRef = Btn
    
    local Corner = Instance.new("UICorner")
    Corner.Parent = Btn
    currentThrowCornerRef = Corner
    
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(255, 255, 255)
    Borda.Thickness = 1.5
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn
    currentThrowStrokeRef = Borda
    
    local Texto = Instance.new("TextLabel")
    Texto.Name = "ThrowText"
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.Text = "T h r o w    K a n i f"
    Texto.TextColor3 = Color3.fromRGB(255, 255, 255)
    Texto.Font = Enum.Font.SourceSans
    Texto.Parent = Btn
    
    AplicarFormatoThrow()
    -- Proporção de tamanho de fonte idêntica ao Silent AIM (baseada no /12.5 ou /10.5)
    Texto.TextSize = math.clamp(math.floor(tamanhoThrowBase / 12.5), 12, 24)
    
    -- Loop apenas para estilizar a borda verde se tiver faca ou branca se não tiver
    task.spawn(function()
        while ThrowButtonGui and Btn and Texto and currentThrowStrokeRef do
            if PlayerTemFaca() then
                currentThrowStrokeRef.Color = Color3.fromRGB(0, 255, 100) -- Verde se tiver a faca
            else
                currentThrowStrokeRef.Color = Color3.fromRGB(255, 255, 255) -- Branco normal se não tiver
            end
            task.wait(0.4)
        end
    end)
    
    local dragStart, startPos
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingThrow = false
            dragStart = input.Position
            startPos = Btn.AbsolutePosition
        end
    end)
    
    Btn.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) and dragStart then
            local delta = input.Position - dragStart
            if delta.Magnitude > 10 then
                isDraggingThrow = true
                Btn.Position = UDim2.new(0, startPos.X + delta.X + (Btn.AbsoluteSize.X / 2), 0, startPos.Y + delta.Y + (Btn.AbsoluteSize.Y / 2))
            end
        end
    end)
    
    Btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not isDraggingThrow then
                ExecuteThrowKnife(Texto)
            end
            dragStart = nil
            isDraggingThrow = false
        end
    end)
    
    ThrowButtonGui = GuiBtn
end

local function RemoveThrowButton()
    if ThrowButtonGui then
        ThrowButtonGui:Destroy()
        ThrowButtonGui = nil
        currentThrowBtnRef = nil
        currentThrowCornerRef = nil
        currentThrowStrokeRef = nil
    end
end

