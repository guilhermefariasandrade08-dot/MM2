FarmCoin:Section({
    Title = "Auto Farm Coin"
})

FarmCoin:Toggle({
    Title = "Auto Farm Coins",
    Value = false,
    Callback = function(state)
        CONFIG_FARM.Active = state
        if not state then 
            RestaurarColisoes() 
        else
            if InGame() and CheckBagFullText() then
                StoppedUntilNewRound = true
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                local finalDestination = nil
                if CONFIG_FARM.FullDestination == "Map" then
                    finalDestination = GetSafeMapSpawn()
                elseif CONFIG_FARM.FullDestination == "Lobby" then
                    finalDestination = CFrame.new(LOBBY_SAFE_POS)
                else
                    finalDestination = GetSafePlatformCFrame()
                end

                if finalDestination and hrp then
                    if hum then hum.PlatformStand = true end
                    local holdStart = os.clock()
                    while os.clock() - holdStart < 1.0 and InGame() and CONFIG_FARM.Active do
                        hrp.CFrame = finalDestination
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        RunService.Heartbeat:Wait()
                    end
                    if hum and InGame() then
                        hum.PlatformStand = false
                    end
                end
            end
        end
    end,
})

