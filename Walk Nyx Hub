-- ==================================
local function HasGun()
    if not localPlayer then return false end
    local char = localPlayer.Character
    if not char then return false end

    local gunChar = char:FindFirstChild("Gun")  
    if not gunChar then  
        for _, item in ipairs(char:GetChildren()) do  
            if item:IsA("Tool") and item.Name:lower():find("gun") then  
                gunChar = item  
                break  
            end  
        end  
    end  
    if gunChar then return true end  

    local backpack = localPlayer:FindFirstChild("Backpack")  
    if backpack then  
        local gunBackpack = backpack:FindFirstChild("Gun")  
        if not gunBackpack then  
            for _, item in ipairs(backpack:GetChildren()) do  
                if item:IsA("Tool") and item.Name:lower():find("gun") then  
                    gunBackpack = item  
                    break  
                end  
            end  
        end  
        if gunBackpack then return true end  
    end  

    return false
end

local function GetMurderer()
    if not localPlayer then return nil end

    for _, p in ipairs(Players:GetPlayers()) do  
        if p ~= localPlayer and p.Character then  
            local char = p.Character  
            local hum = char:FindFirstChildOfClass("Humanoid")  
            local hrp = char:FindFirstChild("HumanoidRootPart")  
              
            if hum and hum.Health > 0 and hrp then  
                local hasKnife = char:FindFirstChild("Knife") or (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife"))  
                local isMurder = (p:GetAttribute("Role") == "Murderer") or (hasKnife ~= nil)  
                  
                if isMurder then  
                    return hrp  
                end  
            end  
        end  
    end  
    return nil
end

local function IsWithinFOV(position3D)
    local camera = workspace.CurrentCamera
    if not camera then return false end

    local screenPos, visible = camera:WorldToViewportPoint(position3D)  
    if not visible then return false end  

    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)  
    local target2D = Vector2.new(screenPos.X, screenPos.Y)  
      
    local pixelDist = (target2D - screenCenter).Magnitude  
    return pixelDist <= (FOVRadius / 2)
end

