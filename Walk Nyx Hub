    local function refreshPlayerList()
        PegarCargos() -- Atualiza os dados do servidor

        local activePlayerNames = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                activePlayerNames[p.Name] = p
            end
        end

        -- Remove jogadores que saíram
        for _, child in ipairs(PlayerListFrame:GetChildren()) do
            if child:IsA("TextButton") then
                local playerName = child.Name:gsub("PlayerBtn_", "")
                if not activePlayerNames[playerName] then
                    child:Destroy()
                    if selectedPlayerName == playerName then
                        selectedPlayerName = nil
                    end
                end
            end
        end

        -- Coleta dados e ordena
        local playerDataList = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local Cargo, Cor = ObterCargoECor(p)
                local Priority = 5
                if Cargo == "Murderer" then Priority = 1
                elseif Cargo == "Hero" then Priority = 2
                elseif Cargo == "Innocent" then Priority = 3
                elseif Cargo == "Sheriff" then Priority = 4
                end
                table.insert(playerDataList, {
                    Player = p,
                    Cargo = Cargo,
                    Cor = Cor,
                    Priority = Priority
                })
            end
        end

        table.sort(playerDataList, function(a, b)
            if a.Priority == b.Priority then
                return a.Player.Name < b.Player.Name
            end
            return a.Priority < b.Priority
        end)

        local count = 0
        for index, data in ipairs(playerDataList) do
            local p = data.Player
            local Cargo = data.Cargo
