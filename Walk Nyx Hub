-- LÓGICA DO SLIDER
local FarmSliding = false
local FarmActiveInput = nil
local FarmMin = 16
local FarmMax = 25
local FarmValue = 18

local function AtualizarFarmSlider(valor)
    valor = math.clamp(valor, FarmMin, FarmMax)
    FarmValue = math.floor(valor + 0.5)
    local porcentagem = (FarmValue - FarmMin) / (FarmMax - FarmMin)
    FarmSliderFill.Size = UDim2.new(porcentagem, 0, 1, 0)
    FarmSliderButton.Position = UDim2.new(porcentagem, 0, 0.5, 0)
    FarmSliderValue.Text = tostring(FarmValue)
    CONFIG_FARM.velocidade = FarmValue
end

AtualizarFarmSlider(FarmValue)

FarmSliderButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if FarmSliding then return end
        FarmSliding = true
        FarmActiveInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not FarmSliding then return end
    if FarmActiveInput
    and FarmActiveInput.UserInputType == Enum.UserInputType.Touch then
        if input.UserInputType ~= Enum.UserInputType.Touch then return end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local mouseX = input.Position.X
    local startX = FarmSliderBg.AbsolutePosition.X
    local width = FarmSliderBg.AbsoluteSize.X
    local porcentagem = math.clamp((mouseX - startX) / width, 0, 1)
    local valor = FarmMin + ((FarmMax - FarmMin) * porcentagem)
    AtualizarFarmSlider(valor)
end)

UserInputService.InputEnded:Connect(function(input)
    if input == FarmActiveInput
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        FarmSliding = false
        FarmActiveInput = nil
    end
end)

