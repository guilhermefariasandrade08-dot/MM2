-- 🔫 SYSTEM — GRAB GUN
-- ===========================================

local function GetGunDrop()
    local MapContainer = Workspace:FindFirstChild("CoinContainer", true) and Workspace:FindFirstChild("CoinContainer", true).Parent
    local mapToSearch = MapContainer or Workspace
    local gunDrop = mapToSearch:FindFirstChild("GunDrop", true) or Workspace:FindFirstChild("GunDrop", true)
    if gunDrop and gunDrop:IsA("BasePart") then
        return gunDrop
    end
    return nil
end

local function TriggerGrabGun()
    local Char = player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end

    local gunDrop = GetGunDrop()
    if gunDrop then
        gunDrop.CFrame = Char.HumanoidRootPart.CFrame
        if GrabButtonGui then
            local texto = GrabButtonGui:FindFirstChild("GrabText", true)
            if texto then
                texto.Text = "Grabbed!"
                task.delay(1.2, function()
                    if texto and texto.Parent then
                        texto.Text = "Grab Gun"
                    end
                end)
            end
        end
    else
        if GrabButtonGui then
            local texto = GrabButtonGui:FindFirstChild("GrabText", true)
            if texto then
                texto.Text = "No Drop!"
                task.delay(1.2, function()
                    if texto and texto.Parent then
                        texto.Text = "Grab Gun"
                    end
                end)
            end
        end
    end
end

