-- Atualizador em tempo real de FPS e Ping
local lastUpdate = 0
RunService.RenderStepped:Connect(function(dt)
    if not MostrarFpsPing then return end
    
    local agora = tick()
    if agora - lastUpdate >= 0.5 then -- Atualiza a cada meio segundo para evitar travamentos visuais
        lastUpdate = agora
        
        -- Calcular FPS
        local fps = math.floor(1 / dt)
        FpsLabel.Text = "FPS: " .. fps
        
        -- Calcular Ping
        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        PingLabel.Text = "Ping: " .. ping .. " ms"
    end
end)


