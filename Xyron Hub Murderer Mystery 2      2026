local function GetNativeButtonGradient()

    local success, gradient = pcall(function()

        local button = Window.OpenButtonMain.Button
        local stroke = button:FindFirstChild("UIStroke")

        if not stroke then
            return nil
        end

        return stroke:FindFirstChild("UIGradient")

    end)

    if success then
        return gradient
    end

    return nil
end

local function ApplyFloatingButtonStyle()

    local selectedColor =
        FloatingButtonColors[FloatingButtonTheme]

    if not selectedColor then
        return
    end

    local colorSequence = ColorSequence.new({
        ColorSequenceKeypoint.new(0, selectedColor),
        ColorSequenceKeypoint.new(0.5, BLACK),
        ColorSequenceKeypoint.new(1, selectedColor),
    })

    pcall(function()

        Window:EditOpenButton({
            Title = "Xyron Hub",
            Icon = "orbit",

            Enabled = true,
            Draggable = true,
            OnlyMobile = false,

            Scale = ButtonScale,
            CornerRadius = UDim.new(0,8),
            StrokeThickness = 2,

            Color = colorSequence,
        })

    end)

    local gradient = GetNativeButtonGradient()

    if gradient then
        gradient.Color = colorSequence
    end
end

