-- ========== FUNÇÕES DE CARGO ==========
local UltimaChecagemCargoFling = 0
local DadosCargosFling = {}

local function PegarCargosFling()
    if tick() - UltimaChecagemCargoFling < 2 then return end
    UltimaChecagemCargoFling = tick()
    task.spawn(function()
        local R = game:GetService("ReplicatedStorage"):FindFirstChild("GetPlayerData", true)
        if not R then return end
        local ok, d = pcall(function() return R:InvokeServer() end)
        if ok and d then DadosCargosFling = d end
    end)
end

local function CargoExisteFling(Role)
    PegarCargosFling()
    for _, Info in pairs(DadosCargosFling) do
        if Info and Info.Role == Role and not Info.Dead and not Info.Killed then
            return true
        end
    end
    return false
end

local function SeuCargoFling(Role)
    PegarCargosFling()
    local MeuNome = LocalPlayer.Name
    local MeusDados = DadosCargosFling[MeuNome]
    return MeusDados and MeusDados.Role == Role and not MeusDados.Dead and not MeusDados.Killed
end

local function GetPlayerPorCargoFling(Role)
    PegarCargosFling()
    for Nome, Info in pairs(DadosCargosFling) do
        if Info and Info.Role == Role and not Info.Dead and not Info.Killed then
            return Players:FindFirstChild(Nome)
        end
    end
    return nil
end

-- ========== VARIÁVEIS ==========
local FlingPorCargo_Ativo = false
local FlingPorCargo_CargoAlvo = nil
local FlingPorCargo_SalvoPosicao = nil
getgenv().FlingPorCargo_FPDH = workspace.FallenPartsDestroyHeight

-- ========== SISTEMA KILASIK ==========
local function SkidFlingPorCargo(TargetPlayer)
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    if not TCharacter or not RootPart then return end
    
    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")
    local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
    local Handle = Accessory and Accessory:FindFirstChild("Handle")
    
    if Character and Humanoid and RootPart then
        if not FlingPorCargo_SalvoPosicao then
            FlingPorCargo_SalvoPosicao = RootPart.CFrame
        end
        
        if THumanoid and THumanoid.Sit then return end
        
        if THead then
            workspace.CurrentCamera.CameraSubject = THead
        elseif Handle then
            workspace.CurrentCamera.CameraSubject = Handle
        elseif THumanoid and TRootPart then
            workspace.CurrentCamera.CameraSubject = THumanoid
        end
        
        local FPos = function(BasePart, Pos, Ang)
            RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
            Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
            RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end
        
        local SFBasePart = function(BasePart)
            local TimeToWait = 2
            local Time = tick()
            local Angle = 0
            repeat
                if RootPart and THumanoid and FlingPorCargo_Ativo then
                    if BasePart.Velocity.Magnitude < 50 then
                        Angle = Angle + 100
                        FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                    else
                        FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                        task.wait()
                    end
                end
            until Time + TimeToWait < tick() or not FlingPorCargo_Ativo
        end
        
        workspace.FallenPartsDestroyHeight = 0/0
        local BV = Instance.new("BodyVelocity")
        BV.Parent = RootPart
        BV.Velocity = Vector3.new(0, 0, 0)
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        
        if TRootPart then SFBasePart(TRootPart)
        elseif THead then SFBasePart(THead)
        elseif Handle then SFBasePart(Handle) end
        
        BV:Destroy()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        workspace.CurrentCamera.CameraSubject = Humanoid
    end
end

-- ========== VOLTAR À POSIÇÃO ORIGINAL ==========
local function VoltarParaPosicaoOriginal()
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    
    if FlingPorCargo_SalvoPosicao and RootPart and Humanoid then
        repeat
            RootPart.CFrame = FlingPorCargo_SalvoPosicao * CFrame.new(0, .5, 0)
            Character:SetPrimaryPartCFrame(FlingPorCargo_SalvoPosicao * CFrame.new(0, .5, 0))
            Humanoid:ChangeState("GettingUp")
            for _, part in pairs(Character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new()
                end
            end
            task.wait()
        until not RootPart or (RootPart.Position - FlingPorCargo_SalvoPosicao.p).Magnitude < 25
        workspace.FallenPartsDestroyHeight = getgenv().FlingPorCargo_FPDH
    end
    FlingPorCargo_SalvoPosicao = nil
end

-- ========== LOOP PRINCIPAL ==========
task.spawn(function()
    while true do
        task.wait(0.4)
        if FlingPorCargo_Ativo and FlingPorCargo_CargoAlvo then
            local Alvo = GetPlayerPorCargoFling(FlingPorCargo_CargoAlvo)
            if Alvo then
                SkidFlingPorCargo(Alvo)
            end
        elseif not FlingPorCargo_Ativo and FlingPorCargo_SalvoPosicao then
            VoltarParaPosicaoOriginal()
        end
    end
end)






 
