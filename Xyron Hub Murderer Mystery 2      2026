        end)

        if ReceiveInfo then

            ReceiveInfo:SetDesc(
                receiveSuccess
                and string.format("%.1f KB/s", receive)
                or "Unavailable"
            )

        end

        if SendInfo then

            SendInfo:SetDesc(
                sendSuccess
                and string.format("%.1f KB/s", send)
                or "Unavailable"
            )

        end

        if ServerPlayers then

            ServerPlayers:SetDesc(
                #Players:GetPlayers()
                .. " / "
                .. Players.MaxPlayers
            )

        end

        local elapsed = math.floor(os.clock() - SessionStart)

        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = elapsed % 60

        if SessionInfo then

            SessionInfo:SetDesc(
                string.format(
                    "%02d:%02d:%02d",
                    hours,
                    minutes,
                    seconds
                )
            )

        end
    end
end)


