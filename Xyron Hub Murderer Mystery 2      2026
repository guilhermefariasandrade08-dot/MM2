--==================================================
-- 03.2 NOTIFICATION SYSTEM
--==================================================

local function Notify(title, content, icon)

    if not NotificationsEnabled then
        return
    end

    WindUI:Notify({
        Title = title,
        Content = content,
        Icon = icon or "bell",
        Duration = NotificationDuration,
    })

end


--==================================================
-- 03.3 NOTIFICATION LOCK SYSTEM
--==================================================

local function SetControlLocked(control, locked)

    if not control then
        return
    end

    pcall(function()

        if locked then
            control:Lock()
        else
            control:Unlock()
        end

    end)

end


local function UpdateNotificationControls()

    for _, control in ipairs(NotificationControls) do
        SetControlLocked(control, not NotificationsEnabled)
    end

end


--==================================================
-- 03.4 BACKGROUND TRANSPARENCY SYSTEM
--==================================================

local function ApplyBackgroundTransparency()

    local transparency = 0

    if InterfaceTransparency then
        transparency = IMAGE_TRANSPARENCY
    end

    local success, err = pcall(function()

        Window:SetBackgroundImageTransparency(transparency)

    end)

    if not success then
        warn("Background transparency error: " .. tostring(err))
    end

end


--==================================================
-- 03.5 BACKGROUND IMAGE SYSTEM
--==================================================

local function ApplyBackgroundImage(imageName)

    SelectedBackground = imageName

    local selectedImage = BackgroundImages[imageName]

    if selectedImage then

        -- IMAGEM SELECIONADA:
        -- FORÇA O TEMA DARK

        WindUI:SetTheme("Dark")

        if ThemeDropdown then

            pcall(function()
                ThemeDropdown:Select("Dark")
            end)

            pcall(function()
                ThemeDropdown:Lock()
            end)

        end

        local success, err = pcall(function()

            Window:SetBackgroundImage(selectedImage)

            ApplyBackgroundTransparency()

        end)

        if success then

            Notify(
                "Background Applied",
                imageName .. " selecionada!",
                "image"
            )

        else

            warn("Background error: " .. tostring(err))

            Notify(
                "Background Error",
                "Não foi possível aplicar a imagem.",
                "alert-circle"
            )

        end

    else

        -- NONE:
        -- REMOVE A IMAGEM E LIBERA O TEMA

        pcall(function()
            Window:SetBackgroundImage("")
        end)

        if ThemeDropdown then

            pcall(function()
                ThemeDropdown:Unlock()
            end)

        end

        Notify(
            "Background Removed",
            "Theme selection unlocked.",
            "image-off"
        )

    end

end


--==================================================
-- 03.6 CONSOLE SYSTEM
--==================================================

local function ClearConsole()

    for _, paragraph in ipairs(ConsoleItems) do

        pcall(function()
            paragraph:Destroy()
        end)

    end

    table.clear(ConsoleItems)

    if EmptyConsole then

        pcall(function()
            EmptyConsole:Destroy()
        end)

        EmptyConsole = nil

    end

    EmptyConsole = ConsoleSection:Paragraph({
        Title = "Console Empty",
        Desc = "Aguardando mensagens...",
    })

end


local function AddConsoleMessage(message, messageType)

    if not ConsoleSection then
        return
    end

    if EmptyConsole then

        pcall(function()
            EmptyConsole:Destroy()
        end)

        EmptyConsole = nil

    end

    local typeName = tostring(messageType)

    if typeName:find("MessageError") then

        typeName = "ERROR"

    elseif typeName:find("MessageWarning") then

        typeName = "WARNING"

    else

        typeName = "INFO"

    end

    local newMessage = ConsoleSection:Paragraph({
        Title = typeName,
        Desc = tostring(message),
    })

    table.insert(ConsoleItems, newMessage)

    if typeName == "ERROR" and ErrorNotifications then

        Notify(
            "Console Error",
            tostring(message),
            "alert-circle"
        )

    end

    -- LIMPA AO ATINGIR 10 MENSAGENS

    if AutoClearConsole
    and #ConsoleItems >= MAX_CONSOLE_MESSAGES then

        ClearConsole()

    end

end


