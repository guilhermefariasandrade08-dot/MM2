        else
            ToggleHeroiRole:Lock("NÃO ENCONTRADO")
            ToggleHeroiRole:SetDesc("Herói não está no jogo")
        end
    else
        -- BLOQUEIA OS OUTROS QUANDO UM ESTÁ ATIVO
        if FlingPorCargo_CargoAlvo == "Murderer" then
            ToggleSheriffRole:Lock("OCUPADO")
            ToggleSheriffRole:SetDesc("Desative o Assassino primeiro")
            ToggleHeroiRole:Lock("OCUPADO")
