        elseif TemSheriff then
            ToggleSheriffRole:Unlock()
            ToggleSheriffRole:SetDesc("Ativa fling no Sheriff")
        else
            ToggleSheriffRole:Lock("NÃO ENCONTRADO")
            ToggleSheriffRole:SetDesc("Sheriff não está no jogo")
