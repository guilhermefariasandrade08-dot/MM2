    Desc = "Escolha a cor do degradê da borda.",

    Values = {
        "Dark",
        "Red",
        "Blue",
        "Purple",
        "Green",
    },

    Value = "Dark",

    Callback = function(value)

        if not FloatingButtonColors[value] then
            return
        end

        FloatingButtonTheme = value

        ApplyFloatingButtonStyle()

        Notify(
            "Floating Button",
            "Cor selecionada: " .. value,
            "palette"
        )

    end,
})

ButtonSettings:Slider({
    Title = "Open Button Size",
    Desc = "Aumenta ou diminui o botão nativo.",

    Step = 0.05,

    Value = {
        Min = 0.5,
        Max = 2.5,
        Default = 1,
    },

    IsTooltip = true,
    IsTextbox = true,

    Callback = function(value)

        ButtonScale = value
        ApplyFloatingButtonStyle()

    end,
})

ApplyFloatingButtonStyle()


