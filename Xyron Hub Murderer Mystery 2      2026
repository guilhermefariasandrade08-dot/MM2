task.spawn(function()

    while task.wait(1) do

        local currentFPS = FrameCount
        FrameCount = 0

        if FPSInfo then
            FPSInfo:SetDesc(tostring(currentFPS) .. " FPS")
        end

        if PingInfo then
            PingInfo:SetDesc(GetPing())
        end

        local receiveSuccess, receive = pcall(function()
            return Stats.DataReceiveKbps
        end)

        local sendSuccess, send = pcall(function()
            return Stats.DataSendKbps
        end)

        if ReceiveInfo then

            ReceiveInfo:SetDesc(
                receiveSuccess
                and string.format("%.1f KB/s", receive)
                or "Unavailable"
            )

        end

        if SendInfo then

            SendInfo:SetDesc(
                sendSuccess
                and string.format("%.1f KB/s", send)
                or "Unavailable"
            )

        end

        if ServerPlayers then

            ServerPlayers:SetDesc(
                #Players:GetPlayers()
                .. " / "
                .. Players.MaxPlayers
            )

        end

        local elapsed = math.floor(os.clock() - SessionStart)

        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = elapsed % 60

        if SessionInfo then

            SessionInfo:SetDesc(
                string.format(
                    "%02d:%02d:%02d",
                    hours,
                    minutes,
                    seconds
                )
            )

        end
    end
end)


