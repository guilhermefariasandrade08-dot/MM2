local function Notify(title, content, icon)

    if not NotificationsEnabled then
        return
    end

    WindUI:Notify({
        Title = title,
        Content = content,
        Icon = icon or "bell",
        Duration = NotificationDuration,
    })
end

local function SetControlLocked(control, locked)

    if not control then
        return
    end

    pcall(function()

        if locked then
            control:Lock()
        else
            control:Unlock()
        end

    end)
end

local function UpdateNotificationControls()

    for _, control in ipairs(NotificationControls) do
        SetControlLocked(control, not NotificationsEnabled)
    end
end


