local SelectedFlingTarget = nil

local function GetFlingPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    return names
end

local function ExecutarFling()
    if not SelectedFlingTarget or not SelectedFlingTarget.Character then
        Notify("Fling", "Nenhum alvo válido selecionado!", "alert-circle")
        return
    end

    local targetChar = SelectedFlingTarget.Character
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if not targetRoot or not myRoot then
        return
    end

    local originalPos = myRoot.CFrame
    Notify("Fling", "Iniciando em " .. SelectedFlingTarget.Name, "wind")

    task.spawn(function()
        local startTime = tick()
        local duration = 4

        while tick() - startTime < duration do
            if not SelectedFlingTarget.Character or not targetRoot then break end
            
            local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
            local isMoving = targetHumanoid and targetHumanoid.MoveDirection.Magnitude > 0.1

            if isMoving then
                myRoot.CFrame = targetRoot.CFrame + (targetHumanoid.MoveDirection * 3)
            else
                myRoot.CFrame = targetRoot.CFrame
            end

            myRoot.CFrame = myRoot.CFrame * CFrame.Angles(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
            task.wait(0.03)
        end

        myRoot.CFrame = originalPos
        local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
        if myHumanoid then
            myHumanoid.PlatformStand = true
        end
        
        task.wait(0.5)
        
        if myHumanoid then
            myHumanoid.PlatformStand = false
        end

        Notify("Fling", "Fling concluído!", "check")
    end)
end

