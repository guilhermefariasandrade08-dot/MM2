local function GetNativeButtonGradient()

    local success, gradient = pcall(function()

        local button = Window.OpenButtonMain.Button
        local stroke = button:FindFirstChild("UIStroke")

        if not stroke then
            return nil
        end

        return stroke:FindFirstChild("UIGradient")

    end)

    if success then
        return gradient
    end

    return nil
end

local function ApplyFloatingButtonStyle()

    local selectedColor =
        FloatingButtonColors[FloatingButtonTheme]

    if not selectedColor then
        return
    end

    local colorSequence = ColorSequence.new({
        ColorSequenceKeypoint.new(0, selectedColor),
        ColorSequenceKeypoint.new(0.5, BLACK),
        ColorSequenceKeypoint.new(1, selectedColor),
    })

    pcall(function()

        Window:EditOpenButton({
            Title = "Xyron Hub",
            Icon = "orbit",

            Enabled = true,
            Draggable = true,
            OnlyMobile = false,

            Scale = ButtonScale,
            CornerRadius = UDim.new(0,8),
            StrokeThickness = 2,

            Color = colorSequence,
        })

    end)

    local gradient = GetNativeButtonGradient()

    if gradient then
        gradient.Color = colorSequence
    end
end

task.spawn(function()

    local gradient

    repeat
        task.wait(0.25)
        gradient = GetNativeButtonGradient()
    until gradient or not Window

    if not gradient then
        return
    end

    while gradient.Parent do

        gradient.Offset = Vector2.new(-1,0)

        local tween = TweenService:Create(
            gradient,

            TweenInfo.new(
                2.5,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.InOut
            ),

            {
                Offset = Vector2.new(1,0)
            }
        )

        tween:Play()
        tween.Completed:Wait()

    end
end)


