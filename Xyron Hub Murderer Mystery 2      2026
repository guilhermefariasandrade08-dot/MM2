    Callback = function(value)
        NotificationDuration = value
    end,
})

local ErrorControl = NotificationSettings:Toggle({
    Title = "Error Notifications",
    Desc = "Notifica quando aparece um erro no console.",

    Value = true,

    Callback = function(value)
        ErrorNotifications = value
    end,
})

local PlayerControl = NotificationSettings:Toggle({
    Title = "Player Notifications",
    Desc = "Notifica quando alguém entra ou sai.",

    Value = false,

    Callback = function(value)
        PlayerNotifications = value
    end,
})

local TestNotificationButton = NotificationSettings:Button({
    Title = "Test Notification",
    Icon = "bell-ring",

    Callback = function()

        Notify(
            "Test",
            "Notifications are working!",
            "check-circle"
        )

    end,
})

NotificationControls = {
    DurationControl,
    ErrorControl,
    PlayerControl,
    TestNotificationButton,
}

UpdateNotificationControls()


--==================================================
-- 19. CONTROLES DO CONSOLE
--==================================================

ConsoleSection:Toggle({
    Title = "Auto Clear",
    Desc = "Limpa automaticamente ao chegar a 10 mensagens.",

    Value = false,

    Callback = function(value)

        AutoClearConsole = value

        if AutoClearConsole
        and #ConsoleItems >= MAX_CONSOLE_MESSAGES then
            ClearConsole()
        end

    end,
})

ConsoleSection:Button({
    Title = "Clear Console",
    Icon = "trash-2",

    Callback = function()

        ClearConsole()

        Notify(
            "Console",
            "All messages have been cleared.",
            "check"
        )

    end,
})


