local ToggleStates = {}
local ToggleCallbacks = {}

local function CreateToggle(
    tabName,
    toggleName,
    description,
    defaultState,
    callback
)
    local page = Pages[tabName]

    if not page then
        warn("[Xyron Hub] Aba não encontrada: " .. tostring(tabName))
        return
    end

    local toggleKey = tabName .. "_" .. toggleName

    if ToggleStates[toggleKey] ~= nil then
        warn("[Xyron Hub] Toggle duplicado: " .. toggleKey)
        return
