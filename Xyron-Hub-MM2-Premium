    OptionsPadding.PaddingBottom = UDim.new(0, 3)
    OptionsPadding.Parent = OptionsScroll

    local function GetSelectedText()
        if Multi then
            local Result = {}

            for _, Option in ipairs(Values) do
                if Selected[Option] then
                    table.insert(Result, tostring(Option))
                end
            end

            return #Result > 0 and table.concat(Result, ", ") or "Nenhuma"
        end

        for _, Option in ipairs(Values) do
            if Selected[Option] then
                return tostring(Option)
            end
        end

        return "Selecionar..."
    end

    local function FireCallback()
        if Multi then
            local Result = {}

            for _, Option in ipairs(Values) do
                if Selected[Option] then
                    table.insert(Result, Option)
                end
            end

            Callback(Result)
        else
            local Result

            for _, Option in ipairs(Values) do
                if Selected[Option] then
                    Result = Option
                    break
                end
            end

            Callback(Result)
        end
    end

    local function RefreshOptions()
        SelectedLabel.Text = GetSelectedText()

        for Option, Button in pairs(OptionButtons) do
            local IsSelected = Selected[Option] == true

            Button.BackgroundColor3 = IsSelected
                and Color3.fromRGB(35, 75, 125)
                or Color3.fromRGB(23, 23, 23)

            Button.TextColor3 = IsSelected
                and Color3.fromRGB(245, 245, 245)
                or Color3.fromRGB(205, 205, 205)
        end
    end

    local function CloseMenu()
        Opened = false
        Menu.Visible = false
        MenuLayer.Enabled = false
        ArrowUp.BackgroundTransparency = 1
        ArrowDown.BackgroundTransparency = 1
    end

    local function OpenMenu()
        if Opened or Destroyed then
            return
        end

        local AbsolutePosition = Selector.AbsolutePosition
        local AbsoluteSize = Selector.AbsoluteSize
        local Viewport = workspace.CurrentCamera.ViewportSize

        local Height = math.min(#Values * 32 + 8, 160)
        local X = math.clamp(
            AbsolutePosition.X,
            5,
            math.max(5, Viewport.X - MenuWidth - 5)
        )

        local BelowY = AbsolutePosition.Y + AbsoluteSize.Y + 5
        local AboveY = AbsolutePosition.Y - Height - 5

        local Y = BelowY
        if BelowY + Height > Viewport.Y and AboveY >= 5 then
            Y = AboveY
        end

        Menu.Position = UDim2.fromOffset(X, Y)
        Menu.Size = UDim2.new(0, MenuWidth, 0, Height)

        MenuLayer.Enabled = true
        Menu.Visible = true
        Opened = true
    end

    local function ToggleMenu()
        if Opened then
            CloseMenu()
        else
            OpenMenu()
        end
    end

    local function BuildOptions()
        for _, Child in ipairs(OptionsScroll:GetChildren()) do
            if Child:IsA("TextButton") then
                Child:Destroy()
            end
        end

        table.clear(OptionButtons)

        for Index, Option in ipairs(Values) do
            local Button = Instance.new("TextButton")
            Button.Name = "Option_" .. tostring(Index)
            Button.Size = UDim2.new(1, 0, 0, 29)
            Button.BackgroundColor3 = Color3.fromRGB(23, 23, 23)
            Button.BorderSizePixel = 0
            Button.AutoButtonColor = false
            Button.Font = Enum.Font.Gotham
            Button.Text = tostring(Option)
            Button.TextColor3 = Color3.fromRGB(205, 205, 205)
            Button.TextSize = 12
            Button.TextXAlignment = Enum.TextXAlignment.Left
            Button.LayoutOrder = Index
            Button.ZIndex = 22
            Button.Parent = OptionsScroll

            local Padding = Instance.new("UIPadding")
            Padding.PaddingLeft = UDim.new(0, 9)
            Padding.Parent = Button

            local ButtonCorner = Instance.new("UICorner")
            ButtonCorner.CornerRadius = UDim.new(0, 4)
            ButtonCorner.Parent = Button

            OptionButtons[Option] = Button

            Connect(Button.Activated, function()
                if Multi then
                    Selected[Option] = not Selected[Option]
                else
                    table.clear(Selected)
                    Selected[Option] = true
                    CloseMenu()
                end

                RefreshOptions()
                FireCallback()
            end)
        end

        RefreshOptions()
    end

    Connect(Selector.Activated, ToggleMenu)

    Connect(UserInputService.InputBegan, function(Input)
        if not Opened then
            return
        end

        if Input.UserInputType ~= Enum.UserInputType.MouseButton1
        and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local Position = Input.Position
        local MenuPosition = Menu.AbsolutePosition
        local MenuSize = Menu.AbsoluteSize
        local SelectorPosition = Selector.AbsolutePosition
        local SelectorSize = Selector.AbsoluteSize

        local InMenu =
            Position.X >= MenuPosition.X
            and Position.X <= MenuPosition.X + MenuSize.X
            and Position.Y >= MenuPosition.Y
            and Position.Y <= MenuPosition.Y + MenuSize.Y

        local InSelector =
            Position.X >= SelectorPosition.X
            and Position.X <= SelectorPosition.X + SelectorSize.X
            and Position.Y >= SelectorPosition.Y
            and Position.Y <= SelectorPosition.Y + SelectorSize.Y

        if not InMenu and not InSelector then
            CloseMenu()
        end
    end)

    BuildOptions()
    RefreshOptions()

    -- CALLBACK INICIAL
    if Default ~= nil or (Values[1] ~= nil and not AllowNone) then
        FireCallback()
    end

    return {
        SetValue = function(NewValue)
            table.clear(Selected)

            if Multi then
                if typeof(NewValue) == "table" then
                    for _, Option in ipairs(NewValue) do
                        if table.find(Values, Option) then
                            Selected[Option] = true
                        end
                    end
                elseif table.find(Values, NewValue) then
                    Selected[NewValue] = true
                end
            elseif table.find(Values, NewValue) then
                Selected[NewValue] = true
            end

            RefreshOptions()
            FireCallback()
        end,

        GetValue = function()
            if Multi then
                local Result = {}

                for _, Option in ipairs(Values) do
                    if Selected[Option] then
                        table.insert(Result, Option)
                    end
                end

                return Result
            end

            for _, Option in ipairs(Values) do
                if Selected[Option] then
                    return Option
                end
            end

            return nil
        end,

        Refresh = function(NewValues)
            Values = NewValues or Values
            BuildOptions()
            RefreshOptions()
        end,

        Open = OpenMenu,
        Close = CloseMenu,

        Destroy = function()
            Destroyed = true
            CloseMenu()

            for _, Connection in ipairs(Connections) do
                Connection:Disconnect()
            end

            MenuLayer:Destroy()
            Container:Destroy()
        end
    }
end

