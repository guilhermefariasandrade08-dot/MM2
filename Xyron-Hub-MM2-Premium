    Hitbox.Name = "SliderHitbox"
    Hitbox.Position = UDim2.new(0, -8, 0, -12)
    Hitbox.Size = UDim2.new(1, 16, 0, 28)
    Hitbox.BackgroundTransparency = 1
    Hitbox.Text = ""
    Hitbox.AutoButtonColor = false
    Hitbox.Active = true
    Hitbox.Parent = Bar

    -- ATUALIZAR VALOR E VISUAL
    local function UpdateSlider(newValue, callCallback)
        value = math.clamp(
            math.floor(newValue + 0.5),
            minValue,
            maxValue
        )

        local percent = 0

        if maxValue > minValue then
            percent = (value - minValue) / (maxValue - minValue)
        end

        Fill.Size = UDim2.new(percent, 0, 1, 0)
        Knob.Position = UDim2.new(percent, 0, 0.5, 0)
        ValueBox.Text = tostring(value)

        if callCallback and callback then
            local success, err = pcall(callback, value)

            if not success then
                warn("[Xyron Hub] Erro no slider:", err)
            end
        end
    end

    -- CALCULAR VALOR PELA POSIÇÃO DO DEDO/MOUSE
    local function UpdateFromPosition(screenX)
        local barLeft = Bar.AbsolutePosition.X
        local barWidth = Bar.AbsoluteSize.X

        if barWidth <= 0 then
            return
        end

        local percent = math.clamp(
            (screenX - barLeft) / barWidth,
            0,
            1
        )

        UpdateSlider(
            minValue + (maxValue - minValue) * percent,
            true
        )
    end

    -- ENCERRAR ARRASTO E DESCONECTAR EVENTOS
    local function StopDragging()
        dragging = false
        activeTouch = nil
        activeInputType = nil

        if moveConnection then
            moveConnection:Disconnect()
            moveConnection = nil
        end

        if endConnection then
            endConnection:Disconnect()
            endConnection = nil
        end
    end

    -- INICIAR ARRASTO COM UM ÚNICO DEDO
    Hitbox.InputBegan:Connect(function(input)
        if dragging then
            return
        end

        local inputType = input.UserInputType

        if inputType ~= Enum.UserInputType.Touch
            and inputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        dragging = true
        activeTouch = input
        activeInputType = inputType

        UpdateFromPosition(input.Position.X)

        moveConnection = UserInputService.InputChanged:Connect(
            function(changedInput)
                if not dragging then
                    return
                end

                if activeInputType == Enum.UserInputType.Touch then
                    -- Só aceita o dedo que iniciou o arrasto.
                    if changedInput ~= activeTouch then
                        return
                    end
                else
                    -- Com mouse, acompanha somente o movimento do mouse.
                    if changedInput.UserInputType
                        ~= Enum.UserInputType.MouseMovement then
                        return
                    end
                end

                UpdateFromPosition(changedInput.Position.X)
            end
        )

        endConnection = UserInputService.InputEnded:Connect(
            function(endedInput)
                if not dragging then
                    return
                end

                if activeInputType == Enum.UserInputType.Touch then
                    if endedInput == activeTouch then
                        StopDragging()
                    end
                elseif endedInput.UserInputType
                    == Enum.UserInputType.MouseButton1 then
                    StopDragging()
                end
            end
        )
    end)

    -- PERMITE DIGITAR O VALOR MANUALMENTE
    ValueBox.FocusLost:Connect(function()
        local typedValue = tonumber(ValueBox.Text)

        if typedValue then
            UpdateSlider(typedValue, true)
        else
            UpdateSlider(value, false)
        end
    end)

    -- ESTADO INICIAL
    UpdateSlider(defaultValue, false)

    -- CONTROLE EXTERNO
    local Controller = {}

    function Controller:Set(newValue)
        local numericValue = tonumber(newValue)

        if numericValue then
            UpdateSlider(numericValue, true)
        end
    end

    function Controller:Get()
        return value
    end

    function Controller:Destroy()
        StopDragging()
        Slider:Destroy()
    end

    return Controller
end

