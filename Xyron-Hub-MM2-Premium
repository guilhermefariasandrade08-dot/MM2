--                     SELECIONAR ABA                     --
--========================================================--

local function SelectTab(tabName)
    if not Pages[tabName] then
        return
    end

    CurrentTab = tabName
    SearchResults.Visible = false

    for name, page in pairs(Pages) do
        page.Visible = name == tabName
    end

    for name, objects in pairs(TabButtons) do
        local selected = name == tabName

        objects.Button.BackgroundTransparency = selected and 0 or 1
        objects.Button.BackgroundColor3 = selected
            and Color3.fromRGB(50, 50, 50)
            or BLACK

        objects.Text.TextColor3 = selected and WHITE or GRAY
        AnimateIcon(objects.Icon, selected)
    end
end

