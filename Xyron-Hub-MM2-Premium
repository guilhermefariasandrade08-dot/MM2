    local value = defaultValue

    SliderStates[sliderKey] = value
    SliderCallbacks[sliderKey] = callback

    -- BASE RETANGULAR PRETA
    local Container = Instance.new("Frame")
    Container.Name = sliderName .. "_Slider"
    Container.Size = UDim2.new(1, -4, 0, 88)
    Container.BackgroundColor3 = BLACK
