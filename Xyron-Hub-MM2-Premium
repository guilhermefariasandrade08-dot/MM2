    NumberBox.BorderSizePixel = 0
    NumberBox.Font = Enum.Font.Gotham
    NumberBox.Text = tostring(Default)
    NumberBox.TextColor3 = Color3.fromRGB(245, 245, 245)
    NumberBox.TextSize = 12
    NumberBox.ClearTextOnFocus = false
    NumberBox.Parent = Container

    local NumberCorner = Instance.new("UICorner")
    NumberCorner.CornerRadius = UDim.new(0, 5)
    NumberCorner.Parent = NumberBox

    local NumberStroke = Instance.new("UIStroke")
    NumberStroke.Color = Color3.fromRGB(55, 55, 55)
    NumberStroke.Thickness = 1
    NumberStroke.Parent = NumberBox

    -- SUBTÍTULO ABAIXO DO SLIDER
    local Subtitle = Instance.new("TextLabel")
    Subtitle.Name = "Subtitle"
    Subtitle.Position = UDim2.new(0, 12, 0, 53)
    Subtitle.Size = UDim2.new(1, -24, 0, 20)
    Subtitle.BackgroundTransparency = 1
    Subtitle.Font = Enum.Font.Gotham
    Subtitle.Text = SubtitleText
    Subtitle.TextColor3 = Color3.fromRGB(140, 140, 140)
    Subtitle.TextSize = 11
    Subtitle.TextXAlignment = Enum.TextXAlignment.Left
    Subtitle.TextTruncate = Enum.TextTruncate.AtEnd
    Subtitle.Parent = Container

    local function UpdateSlider(NewValue, FireCallback)
        NewValue = math.clamp(math.floor(NewValue), Min, Max)
        Value = NewValue

        local Percent
        if Max == Min then
            Percent = 0
        else
            Percent = (Value - Min) / (Max - Min)
        end

        Fill.Size = UDim2.new(Percent, 0, 1, 0)
        Knob.Position = UDim2.new(Percent, 0, 0.5, 0)
        NumberBox.Text = tostring(Value)

        if FireCallback then
            Callback(Value)
        end
    end

    local function SetFromPosition(X)
        local Width = Track.AbsoluteSize.X
        if Width <= 0 then
            return
        end

        local Percent = math.clamp(
            (X - Track.AbsolutePosition.X) / Width,
            0,
            1
        )

        UpdateSlider(Min + (Max - Min) * Percent, true)
    end

    -- ARRASTO COM MOUSE OU UM ÚNICO TOQUE
    Hitbox.InputBegan:Connect(function(Input)
        if ActiveInput then
            return
        end

        if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
            ActiveInput = Input
            Dragging = true
            SetFromPosition(Input.Position.X)
        end
    end)

    table.insert(Connections, UserInputService.InputChanged:Connect(function(Input)
        if not Dragging or not ActiveInput then
            return
        end

        if ActiveInput.UserInputType == Enum.UserInputType.MouseButton1 then
            if Input.UserInputType == Enum.UserInputType.MouseMovement then
                SetFromPosition(Input.Position.X)
            end
        elseif Input == ActiveInput then
            SetFromPosition(Input.Position.X)
        end
    end))

    table.insert(Connections, UserInputService.InputEnded:Connect(function(Input)
        if not ActiveInput then
            return
        end

        if Input == ActiveInput
        or (ActiveInput.UserInputType == Enum.UserInputType.MouseButton1
            and Input.UserInputType == Enum.UserInputType.MouseButton1) then
            Dragging = false
            ActiveInput = nil
        end
    end))

    -- ACEITA SOMENTE NÚMEROS NA CAIXA
    NumberBox:GetPropertyChangedSignal("Text"):Connect(function()
        local CleanText = NumberBox.Text:gsub("%D", "")

        if CleanText ~= NumberBox.Text then
            local Cursor = NumberBox.CursorPosition
            NumberBox.Text = CleanText

            if Cursor >= 0 then
                NumberBox.CursorPosition = math.min(Cursor, #CleanText + 1)
            end
        end
    end)

    NumberBox.FocusLost:Connect(function()
        local TextValue = NumberBox.Text

        if TextValue == "" then
            UpdateSlider(Value, false)
            return
        end

        local NumericValue = tonumber(TextValue)

        if not NumericValue then
            UpdateSlider(Value, false)
            return
        end

        UpdateSlider(NumericValue, true)
    end)

    UpdateSlider(Default, false)
    Callback(Default)

    return {
        SetValue = function(NewValue)
            UpdateSlider(NewValue, true)
        end,

        GetValue = function()
            return Value
        end,

        Destroy = function()
            for _, Connection in ipairs(Connections) do
                Connection:Disconnect()
            end

            Container:Destroy()
        end
    }
end

