    local function RefreshOptions()
        ClearOptions()

        if playerMode then
            local currentPlayers = Players:GetPlayers()

            table.sort(currentPlayers, function(a, b)
                return a.Name:lower() < b.Name:lower()
            end)

            for _, player in ipairs(currentPlayers) do
                AddOption(player.Name, player.UserId)
            end

            if selectedValue then
                local stillExists = false

                for _, player in ipairs(currentPlayers) do
                    if player.Name == selectedValue then
                        stillExists = true
                        break
                    end
                end

                if not stillExists then
                    selectedValue = nil
                    DropdownStates[dropdownKey].Value = nil
                    SelectedLabel.Text = "Selecionar..."
                end
            end
        else
            for _, option in ipairs(options) do
                AddOption(option)
            end
        end
    end

    --==================================================
    -- ATUALIZAÇÃO AUTOMÁTICA DE JOGADORES
    --==================================================

    if playerMode then
        table.insert(
            playerConnections,
            Players.PlayerAdded:Connect(function()
                task.defer(RefreshOptions)
            end)
        )

        table.insert(
            playerConnections,
            Players.PlayerRemoving:Connect(function(leavingPlayer)
                if selectedValue == leavingPlayer.Name then
                    selectedValue = nil
                    DropdownStates[dropdownKey].Value = nil
                    SelectedLabel.Text = "Selecionar..."
                end

                task.defer(RefreshOptions)
            end)
        )
    end

    RefreshOptions()

    --==================================================
    -- VALOR INICIAL
    --==================================================

    if selectedValue then
        SelectedLabel.Text = tostring(selectedValue)
    elseif playerMode then
        SelectedLabel.Text = "Selecionar jogador..."
    else
        SelectedLabel.Text = "Selecionar..."
    end

    --==================================================
    -- FUNÇÕES DE CONTROLE
    --==================================================

    Container.Destroying:Connect(function()
        ClearOptions()
        DropdownStates[dropdownKey] = nil
        DropdownCallbacks[dropdownKey] = nil
    end)

    return {
        Frame = Container,

        GetValue = function()
            return selectedValue
        end,

        SetValue = function(newValue)
            SelectOption(newValue)
        end,

        Refresh = function()
            RefreshOptions()
        end,

        Open = function()
            if not isOpen then
                OpenPopup()
            end
        end,

        Close = function()
            if isOpen then
                ClosePopup()
            end
        end
    }
end

