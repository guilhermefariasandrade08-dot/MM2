local function SearchFunctions(query)
    ClearSearchResults()
    query = string.lower(query or "")

    if query == "" then
        SearchResults.Visible = false
        SearchEmpty.Visible = false
        SelectTab(CurrentTab)
        return
    end

    SearchResults.Visible = true
    SearchEmpty.Visible = false

    for _, page in pairs(Pages) do
        page.Visible = false
    end

    local found = 0
    local alreadyAdded = {}

    -- Procura tanto botões quanto toggles e seus títulos.
    for tabName, page in pairs(Pages) do
        for _, object in ipairs(page:GetDescendants()) do
            local searchableObject
            local buttonText = ""
            local activationButton

            if object:IsA("Frame") and object.Name == "WindToggle" then
                searchableObject = object

                local title = object:FindFirstChild("Title")
                local description = object:FindFirstChild("Description")
                local hitbox = object:FindFirstChild("Switch")
                    and object.Switch:FindFirstChild("Hitbox")

                buttonText = title and title.Text or object.Name

                local descriptionText = description and description.Text or ""

                searchableObject:SetAttribute(
                    "SearchText",
                    buttonText .. " " .. descriptionText
                )

                activationButton = hitbox
            elseif object:IsA("TextButton") and object.Name ~= "Hitbox" then
                searchableObject = object

                local title = object:FindFirstChild("Title")
                    or object:FindFirstChild("ToggleLabel")
                    or object:FindFirstChild("TabLabel")

                buttonText = title and title.Text or object.Text or ""
                activationButton = object
            end

            if searchableObject and not alreadyAdded[searchableObject] then
                local extraText = searchableObject:GetAttribute("SearchText") or ""

                local searchable = string.lower(
                    buttonText .. " " .. searchableObject.Name .. " "
                    .. tabName .. " " .. extraText
                )

                if string.find(searchable, query, 1, true) then
                    alreadyAdded[searchableObject] = true
                    found += 1

                    local originalObject = searchableObject
                    local originalPage = page
                    local originalActivation = activationButton
                    local resultText = buttonText
                    local resultTabName = tabName

                    local result = Instance.new("TextButton")
                    result.Name = "SearchResult_" .. found
                    result.Size = UDim2.new(1, -4, 0, 42)
                    result.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                    result.BorderSizePixel = 0
                    result.AutoButtonColor = true
                    result.Text = ""
                    result.LayoutOrder = found
                    result.ZIndex = 6
                    result.Parent = SearchResults

                    Instance.new("UICorner", result).CornerRadius =
                        UDim.new(0, 8)

                    local resultStroke = Instance.new("UIStroke")
                    resultStroke.Color = Color3.fromRGB(55, 55, 55)
                    resultStroke.Thickness = 1
                    resultStroke.Parent = result

                    local resultName = Instance.new("TextLabel")
                    resultName.Size = UDim2.new(1, -20, 0, 20)
                    resultName.Position = UDim2.fromOffset(10, 3)
                    resultName.BackgroundTransparency = 1
                    resultName.Text = resultText ~= ""
                        and resultText or originalObject.Name
                    resultName.TextColor3 = WHITE
                    resultName.TextSize = 12
                    resultName.Font = Enum.Font.GothamMedium
                    resultName.TextXAlignment = Enum.TextXAlignment.Left
                    resultName.TextTruncate = Enum.TextTruncate.AtEnd
                    resultName.ZIndex = 7
                    resultName.Parent = result

                    local resultTab = Instance.new("TextLabel")
                    resultTab.Size = UDim2.new(1, -20, 0, 12)
                    resultTab.Position = UDim2.fromOffset(10, 24)
                    resultTab.BackgroundTransparency = 1
                    resultTab.Text = "Aba: " .. resultTabName
                    resultTab.TextColor3 = GRAY
                    resultTab.TextSize = 9
                    resultTab.Font = Enum.Font.Gotham
                    resultTab.TextXAlignment = Enum.TextXAlignment.Left
                    resultTab.ZIndex = 7
                    resultTab.Parent = result

                    result.Activated:Connect(function()
                        if not originalObject:IsDescendantOf(originalPage) then
                            return
                        end

                        SearchBox.Text = ""
                        SearchResults.Visible = false
                        SelectTab(resultTabName)

                        task.defer(function()
                            if originalActivation
                                and originalActivation.Parent
                                and originalActivation:IsDescendantOf(originalPage) then
                                originalActivation:Activate()
                            end
                        end)
                    end)
                end
            end
        end
    end

    SearchEmpty.Visible = found == 0
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
