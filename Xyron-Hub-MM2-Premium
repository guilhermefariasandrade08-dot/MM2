local Icons
local IconsReady = false

task.spawn(function()
    local ok, result = pcall(function()
        local source = game:HttpGet(
            "https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"
        )
        return assert(loadstring(source))()
    end)

    if ok and type(result) == "table" then
        Icons = result
        IconsReady = pcall(function()
            Icons.SetIconsType("lucide")
        end)
    else
        warn("[Xyron Hub] Falha ao carregar os ícones:", result)
    end
end)

local function GetIcon(name)
    if not IconsReady or not Icons then
        return nil
    end

    local ok, result = pcall(function()
        return Icons.Icon2(name, "lucide")
    end)

    if not ok or type(result) ~= "table" then
        return nil
    end

    if type(result[1]) ~= "string" or type(result[2]) ~= "table" then
        return nil
    end

    return result[1], result[2]
end

local function ApplyIcon(label, name)
    local image, data = GetIcon(name)

    if image and data then
        label.Image = image
        label.ImageRectSize = data.ImageRectSize or Vector2.zero
        label.ImageRectOffset = data.ImageRectPosition or Vector2.zero
        label.Visible = true
    else
        label.Visible = false
    end
end

local function AnimateIcon(icon, selected)
    TweenService:Create(
        icon,
        TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {
            Size = selected
                and UDim2.fromOffset(22, 22)
                or UDim2.fromOffset(18, 18),
            ImageColor3 = selected and WHITE or GRAY
        }
    ):Play()
end

