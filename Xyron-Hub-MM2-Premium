        or UDim2.new(0, 3, 0.5, 0)
    Knob.Size = UDim2.fromOffset(15, 15)
    Knob.BackgroundColor3 = WHITE
    Knob.BorderSizePixel = 0
    Knob.Parent = Switch

    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    -- ANIMAÇÃO E ESTADO
    local function SetState(state, instant)
        enabled = state == true
        ToggleStates[toggleKey] = enabled

        local switchColor = enabled
            and Color3.fromRGB(40, 130, 255)
            or Color3.fromRGB(55, 55, 55)

        local knobPosition = enabled
            and UDim2.new(1, -18, 0.5, 0)
            or UDim2.new(0, 3, 0.5, 0)

        if instant then
            Switch.BackgroundColor3 = switchColor
            Knob.Position = knobPosition
        else
            local info = TweenInfo.new(
                0.22,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            )

            TweenService:Create(Switch, info, {
                BackgroundColor3 = switchColor
            }):Play()

            TweenService:Create(Knob, info, {
                Position = knobPosition
            }):Play()
        end

        local toggleCallback = ToggleCallbacks[toggleKey]

        if toggleCallback then
            task.spawn(function()
                local success, err = pcall(toggleCallback, enabled)

                if not success then
                    warn(
                        "[Xyron Hub] Erro no toggle '" ..
                        toggleName .. "': " .. tostring(err)
                    )
                end
            end)
        end
    end

    Container.Activated:Connect(function()
        SetState(not enabled, false)
    end)

    -- APLICA O ESTADO INICIAL
    SetState(enabled, true)

    return {
        Button = Container,

        GetState = function()
            return enabled
        end,

        SetState = function(state)
            SetState(state, false)
        end
    }
end

