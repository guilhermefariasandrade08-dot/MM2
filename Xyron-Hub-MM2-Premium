local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local SliderStates = {}
local SliderCallbacks = {}

local BLUE = Color3.fromRGB(40, 130, 255)
local BLACK = Color3.fromRGB(5, 5, 5)
local WHITE = Color3.fromRGB(255, 255, 255)
local GRAY = Color3.fromRGB(65, 65, 65)
local DARK_GRAY = Color3.fromRGB(45, 45, 45)

local function CreateSlider(
    tabName,
    sliderName,
    description,
    minimum,
    maximum,
    defaultValue,
    callback
)
    local page = Pages[tabName]

    if not page then
        warn("A aba '" .. tabName .. "' não foi encontrada.")
        return
    end

    minimum = tonumber(minimum) or 0
    maximum = tonumber(maximum) or 100

    if maximum < minimum then
        minimum, maximum = maximum, minimum
    end

    minimum = math.floor(minimum)
    maximum = math.floor(maximum)

    defaultValue = math.clamp(
        math.floor(tonumber(defaultValue) or minimum),
        minimum,
        maximum
    )

    local sliderKey = tabName .. "_" .. sliderName

    if SliderStates[sliderKey] ~= nil then
        warn("Já existe um slider com esse nome: " .. sliderKey)
        return
