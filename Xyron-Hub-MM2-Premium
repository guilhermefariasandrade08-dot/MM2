    end

    minValue = tonumber(minValue) or 0
    maxValue = tonumber(maxValue) or 100
    defaultValue = math.clamp(
        tonumber(defaultValue) or minValue,
        minValue,
        maxValue
    )

    local value = defaultValue
    local dragging = false
    local activeTouch = nil
    local activeInputType = nil
    local moveConnection
    local endConnection

    local hasDescription = description ~= nil
        and tostring(description):match("%S") ~= nil

    -- CONTAINER
    local Slider = Instance.new("Frame")
    Slider.Name = "WindSlider"
    Slider.Size = UDim2.new(1, -4, 0, hasDescription and 82 or 64)
