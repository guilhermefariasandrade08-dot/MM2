--========================================================--

local function GetViewportSize()
    local camera = workspace.CurrentCamera

    if camera then
        return camera.ViewportSize
    end

    return Vector2.new(800, 600)
end

local function ClampPosition(object, position)
    local viewport = GetViewportSize()
    local size = object.AbsoluteSize
    local anchor = object.AnchorPoint

    local x = position.X.Scale * viewport.X + position.X.Offset
    local y = position.Y.Scale * viewport.Y + position.Y.Offset

    local minX = size.X * anchor.X
    local maxX = viewport.X - size.X * (1 - anchor.X)
    local minY = size.Y * anchor.Y
    local maxY = viewport.Y - size.Y * (1 - anchor.Y)

    x = math.clamp(x, minX, math.max(minX, maxX))
    y = math.clamp(y, minY, math.max(minY, maxY))

    -- x e y já representam a posição do AnchorPoint.
    return UDim2.fromOffset(x, y)
end

--========================================================--
--                 ARRASTAR BOTÃO E JANELA                --
--========================================================--

local function MakeDraggable(object, handle, onClick)
    local dragging = false
    local moved = false
    local activeInput = nil
    local startPointer = Vector2.zero
    local startPosition = UDim2.new()

    local changedConnection
    local endedConnection

    local function DisconnectDragConnections()
        if changedConnection then
            changedConnection:Disconnect()
            changedConnection = nil
        end

        if endedConnection then
            endedConnection:Disconnect()
            endedConnection = nil
        end
    end

    local function FinishDrag()
        if not dragging then
            return
        end

        local wasClick = not moved

        dragging = false
        activeInput = nil

        DisconnectDragConnections()

        if wasClick and onClick then
            onClick()
        end
    end

    handle.InputBegan:Connect(function(input)
        local inputType = input.UserInputType

        if inputType ~= Enum.UserInputType.Touch
            and inputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        if dragging then
            return
        end

        dragging = true
        moved = false
        activeInput = input

        startPointer = Vector2.new(input.Position.X, input.Position.Y)
        startPosition = object.Position

        DisconnectDragConnections()

        changedConnection = UserInputService.InputChanged:Connect(
            function(changedInput)
                if not dragging or not activeInput then
                    return
                end

                local isMouseMove =
                    activeInput.UserInputType
                        == Enum.UserInputType.MouseButton1
                    and changedInput.UserInputType
                        == Enum.UserInputType.MouseMovement

                -- Em dispositivos móveis, só acompanha o dedo original.
                local isTouchMove =
                    activeInput.UserInputType == Enum.UserInputType.Touch
                    and changedInput == activeInput

                if not isMouseMove and not isTouchMove then
                    return
                end

                local pointer = Vector2.new(
                    changedInput.Position.X,
                    changedInput.Position.Y
                )

                local delta = pointer - startPointer

                if delta.Magnitude >= DRAG_THRESHOLD then
                    moved = true
                end

                if not moved then
                    return
                end

                object.Position = ClampPosition(
                    object,
                    UDim2.new(
                        startPosition.X.Scale,
                        startPosition.X.Offset + delta.X,
                        startPosition.Y.Scale,
                        startPosition.Y.Offset + delta.Y
                    )
                )
            end
        )

        endedConnection = UserInputService.InputEnded:Connect(
            function(endedInput)
                if not dragging or not activeInput then
                    return
                end

                local finished

                if activeInput.UserInputType
                    == Enum.UserInputType.MouseButton1 then
                    finished = endedInput.UserInputType
                        == Enum.UserInputType.MouseButton1
                else
                    finished = endedInput == activeInput
                end

                if finished then
                    FinishDrag()
                end
            end
        )
    end)
end

--========================================================--
--                 REDIMENSIONAR A JANELA                  --
--========================================================--

local resizing = false
local resizeInput = nil
local resizeStartPointer = Vector2.zero
local resizeStartSize = Vector2.zero
local resizeStartPosition = UDim2.new()

local resizeChangedConnection
local resizeEndedConnection

local function DisconnectResizeConnections()
    if resizeChangedConnection then
        resizeChangedConnection:Disconnect()
        resizeChangedConnection = nil
    end

    if resizeEndedConnection then
        resizeEndedConnection:Disconnect()
        resizeEndedConnection = nil
    end
end

local function FinishResize()
    resizing = false
    resizeInput = nil
    DisconnectResizeConnections()
end

ResizeHandle.InputBegan:Connect(function(input)
    local inputType = input.UserInputType

    if inputType ~= Enum.UserInputType.Touch
        and inputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    if resizing then
        return
    end

    resizing = true
    resizeInput = input

    resizeStartPointer = Vector2.new(input.Position.X, input.Position.Y)
    resizeStartSize = Vector2.new(
        Window.AbsoluteSize.X,
        Window.AbsoluteSize.Y
    )
    resizeStartPosition = Window.Position

    DisconnectResizeConnections()

    resizeChangedConnection = UserInputService.InputChanged:Connect(
        function(changedInput)
            if not resizing or not resizeInput then
                return
            end

            local isMouseMove =
                resizeInput.UserInputType
                    == Enum.UserInputType.MouseButton1
                and changedInput.UserInputType
                    == Enum.UserInputType.MouseMovement

            local isTouchMove =
                resizeInput.UserInputType == Enum.UserInputType.Touch
                and changedInput == resizeInput

            if not isMouseMove and not isTouchMove then
                return
            end

            local pointer = Vector2.new(
                changedInput.Position.X,
                changedInput.Position.Y
            )

            local delta = pointer - resizeStartPointer
            local viewport = GetViewportSize()

            local maxWidth = math.max(MIN_WINDOW_WIDTH, viewport.X - 16)
            local maxHeight = math.max(MIN_WINDOW_HEIGHT, viewport.Y - 16)

            Window.Size = UDim2.fromOffset(
                math.clamp(
                    resizeStartSize.X + delta.X,
                    MIN_WINDOW_WIDTH,
                    maxWidth
                ),
                math.clamp(
                    resizeStartSize.Y + delta.Y,
                    MIN_WINDOW_HEIGHT,
                    maxHeight
                )
            )

            Window.Position = ClampPosition(Window, resizeStartPosition)
        end
    )

    resizeEndedConnection = UserInputService.InputEnded:Connect(
        function(endedInput)
            if not resizing or not resizeInput then
                return
            end

            local finished

            if resizeInput.UserInputType
                == Enum.UserInputType.MouseButton1 then
                finished = endedInput.UserInputType
                    == Enum.UserInputType.MouseButton1
            else
                finished = endedInput == resizeInput
            end

            if finished then
                FinishResize()
            end
        end
    )
end)

