    local timeout = os.clock() + 15

    repeat
        task.wait(0.1)
    until IconsReady or os.clock() >= timeout

    if not IconsReady then
        warn("[Xyron Hub] Tempo esgotado ao carregar os ícones.")
        return
    end

    ApplyIcon(SearchIcon, "search")

    for _, objects in pairs(TabButtons) do
