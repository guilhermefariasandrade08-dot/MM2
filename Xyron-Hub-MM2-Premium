    Title.TextColor3 = Color3.fromRGB(245, 245, 245)
    Title.TextSize = 13
    Title.Font = Enum.Font.GothamMedium
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.TextTruncate = Enum.TextTruncate.AtEnd
    Title.Parent = Slider

    -- CAMPO NUMÉRICO EDITÁVEL
    local ValueBox = Instance.new("TextBox")
    ValueBox.Name = "Value"
    ValueBox.Size = UDim2.fromOffset(58, 25)
    ValueBox.Position = UDim2.new(1, -69, 0, 5)
    ValueBox.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    ValueBox.BorderSizePixel = 0
    ValueBox.Text = tostring(value)
    ValueBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    ValueBox.TextSize = 12
    ValueBox.Font = Enum.Font.GothamMedium
    ValueBox.ClearTextOnFocus = false
    ValueBox.TextEditable = true
