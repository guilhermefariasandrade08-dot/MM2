    SwitchStroke.Color = enabled
        and Color3.fromRGB(255, 255, 255)
        or Color3.fromRGB(85, 85, 85)
    SwitchStroke.Thickness = 1.2
    SwitchStroke.Parent = Switch

    -- MARCA
    local Checkmark = Instance.new("TextLabel")
    Checkmark.Name = "Checkmark"
    Checkmark.Size = UDim2.fromScale(1, 1)
    Checkmark.BackgroundTransparency = 1
    Checkmark.Text = "✔"
    Checkmark.TextColor3 = Color3.fromRGB(0, 0, 0)
    Checkmark.TextSize = 15
    Checkmark.Font = Enum.Font.GothamBold
    Checkmark.TextTransparency = enabled and 0 or 1
    Checkmark.ZIndex = 6
    Checkmark.Parent = Switch

    -- BOTÃO CLICÁVEL
    local Hitbox = Instance.new("TextButton")
    Hitbox.Name = "Hitbox"
    Hitbox.Size = UDim2.fromScale(1, 1)
    Hitbox.BackgroundTransparency = 1
    Hitbox.Text = ""
    Hitbox.AutoButtonColor = false
    Hitbox.ZIndex = 7
    Hitbox.Parent = Switch

    -- AJUSTAR ALTURA DO CONTAINER AO TEXTO
    local function UpdateHeight()
        task.defer(function()
            if not Toggle.Parent or not TextArea.Parent then
                return
            end

            Toggle.Size = UDim2.new(
                1, -4,
                0, math.max(42, TextArea.AbsoluteSize.Y + 20)
            )
        end)
    end

    TextArea:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdateHeight)
    Title:GetPropertyChangedSignal("Text"):Connect(UpdateHeight)
    Description:GetPropertyChangedSignal("Text"):Connect(UpdateHeight)

    -- VISUAL DO ESTADO
    local function UpdateToggle(instant)
        local duration = instant and 0 or 0.2

        local info = TweenInfo.new(
            duration,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        )

        TweenService:Create(Switch, info, {
            BackgroundColor3 = enabled
                and Color3.fromRGB(255, 255, 255)
                or Color3.fromRGB(22, 22, 22)
        }):Play()

        TweenService:Create(SwitchStroke, info, {
            Color = enabled
                and Color3.fromRGB(255, 255, 255)
                or Color3.fromRGB(85, 85, 85)
        }):Play()

        TweenService:Create(Checkmark, info, {
            TextTransparency = enabled and 0 or 1
        }):Play()

        TweenService:Create(Stroke, info, {
            Color = enabled
                and Color3.fromRGB(255, 255, 255)
                or Color3.fromRGB(55, 55, 55)
        }):Play()
    end

    -- CLIQUE
    Hitbox.Activated:Connect(function()
        enabled = not enabled
        UpdateToggle(false)

        if callback then
            local success, err = pcall(callback, enabled)

            if not success then
                warn("[Xyron Hub] Erro no toggle:", err)
            end
        end
    end)

    UpdateHeight()
    UpdateToggle(true)

    -- CONTROLE EXTERNO
    local Controller = {}

    function Controller:Set(value)
        local newValue = value == true
        local changed = enabled ~= newValue

        enabled = newValue
        UpdateToggle(false)

        if changed and callback then
            local success, err = pcall(callback, enabled)

            if not success then
                warn("[Xyron Hub] Erro no toggle:", err)
            end
        end
    end

    function Controller:Get()
        return enabled
    end

    function Controller:Destroy()
        Toggle:Destroy()
    end

    return Controller
end

