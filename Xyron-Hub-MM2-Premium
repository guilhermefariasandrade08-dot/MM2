    TrackCorner.Parent = Track

    -- PARTE AZUL
    local Fill = Instance.new("Frame")
    Fill.Name = "Fill"
    Fill.Size = UDim2.new(0, 0, 1, 0)
    Fill.BackgroundColor3 = BLUE
    Fill.BorderSizePixel = 0
    Fill.Parent = Track

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = Fill

    -- BOLINHA BRANCA
    local Knob = Instance.new("Frame")
    Knob.Name = "Knob"
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Position = UDim2.new(0, 0, 0.5, 0)
    Knob.Size = UDim2.fromOffset(14, 14)
    Knob.BackgroundColor3 = WHITE
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 3
    Knob.Parent = Track

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local KnobStroke = Instance.new("UIStroke")
    KnobStroke.Color = Color3.fromRGB(220, 220, 220)
    KnobStroke.Thickness = 1
    KnobStroke.Parent = Knob

    -- ATUALIZAR VALOR E VISUAL
    local function UpdateSlider(newValue, instant, runCallback)
        newValue = tonumber(newValue)

        if not newValue then
            return
        end

        value = math.clamp(
            math.floor(newValue),
            minimum,
            maximum
        )

        SliderStates[sliderKey] = value
        ValueBox.Text = tostring(value)

        local range = maximum - minimum
        local percent = range == 0
            and 0
            or (value - minimum) / range

        local fillSize = UDim2.new(percent, 0, 1, 0)
        local knobPosition = UDim2.new(percent, 0, 0.5, 0)

        if instant then
            Fill.Size = fillSize
            Knob.Position = knobPosition
        else
            local info = TweenInfo.new(
                0.16,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            )

            TweenService:Create(Fill, info, {
                Size = fillSize
            }):Play()

            TweenService:Create(Knob, info, {
                Position = knobPosition
            }):Play()
        end

        if runCallback and SliderCallbacks[sliderKey] then
            task.spawn(function()
                local success, err = pcall(
                    SliderCallbacks[sliderKey],
                    value
                )

                if not success then
                    warn(
                        "Erro no slider '" ..
                        sliderName .. "': " .. tostring(err)
                    )
                end
            end)
        end
    end

    -- ARRASTAR COM PROTEÇÃO CONTRA MÚLTIPLOS TOQUES
    local dragging = false
    local activeTouch = nil
    local activeInputType = nil
    local inputChangedConnection = nil
    local inputEndedConnection = nil

    local function SetFromPointer(inputX)
        local trackStart = Track.AbsolutePosition.X
        local trackWidth = Track.AbsoluteSize.X

        if trackWidth <= 0 then
            return
        end

        local percent = math.clamp(
            (inputX - trackStart) / trackWidth,
            0,
            1
        )

        local newValue = minimum + percent * (maximum - minimum)
        UpdateSlider(newValue, false, true)
    end

    local function StopDragging()
        dragging = false
        activeTouch = nil
        activeInputType = nil

        if inputChangedConnection then
            inputChangedConnection:Disconnect()
            inputChangedConnection = nil
        end

        if inputEndedConnection then
            inputEndedConnection:Disconnect()
            inputEndedConnection = nil
        end
    end

    local DragButton = Instance.new("TextButton")
    DragButton.Name = "DragButton"
    DragButton.Size = UDim2.new(1, 0, 0, 25)
    DragButton.Position = UDim2.new(0, 0, 0, -10)
    DragButton.BackgroundTransparency = 1
    DragButton.Text = ""
    DragButton.AutoButtonColor = false
    DragButton.Active = true
    DragButton.ZIndex = 5
    DragButton.Parent = Track

    DragButton.InputBegan:Connect(function(input)
        local inputType = input.UserInputType

        if inputType ~= Enum.UserInputType.MouseButton1
            and inputType ~= Enum.UserInputType.Touch then
            return
        end

        if dragging then
            return
        end

        dragging = true
        activeTouch = input
        activeInputType = inputType

        SetFromPointer(input.Position.X)

        inputChangedConnection = UserInputService.InputChanged:Connect(
            function(changedInput)
                if not dragging or not activeTouch then
                    return
                end

                local isMouseMove =
                    activeInputType == Enum.UserInputType.MouseButton1
                    and changedInput.UserInputType
                        == Enum.UserInputType.MouseMovement

                local isTouchMove =
                    activeInputType == Enum.UserInputType.Touch
                    and changedInput == activeTouch

                if isMouseMove or isTouchMove then
                    SetFromPointer(changedInput.Position.X)
                end
            end
        )

        inputEndedConnection = UserInputService.InputEnded:Connect(
            function(endedInput)
                if not dragging or not activeTouch then
                    return
                end

                local finished = false

                if activeInputType == Enum.UserInputType.MouseButton1 then
                    finished =
                        endedInput.UserInputType
                        == Enum.UserInputType.MouseButton1
                elseif activeInputType == Enum.UserInputType.Touch then
                    finished = endedInput == activeTouch
                end

                if finished then
                    StopDragging()
                end
            end
        )
    end)

    Container.Destroying:Connect(function()
        StopDragging()
    end)

    -- CAMPO NUMÉRICO EDITÁVEL
    local editing = false

    ValueBox.Focused:Connect(function()
        editing = true
    end)

    ValueBox:GetPropertyChangedSignal("Text"):Connect(function()
        if not editing then
            return
        end

        local clean = ValueBox.Text:gsub("%D", "")

        if clean ~= ValueBox.Text then
            local cursor = ValueBox.CursorPosition
            ValueBox.Text = clean

            if cursor >= 1 then
                ValueBox.CursorPosition = math.min(
                    cursor,
                    #clean + 1
                )
            end
        end
    end)

    local function CommitValue()
        editing = false

        local typedValue = tonumber(ValueBox.Text)

        if not typedValue then
            UpdateSlider(value, false, false)
            return
        end

        UpdateSlider(typedValue, false, true)
    end

    ValueBox.FocusLost:Connect(function()
        CommitValue()
    end)

    -- APLICAR VALOR INICIAL
    UpdateSlider(value, true, true)

    -- CONTROLES DO SLIDER
    return {
        Frame = Container,

        GetValue = function()
            return value
        end,

        SetValue = function(newValue)
            UpdateSlider(newValue, false, true)
        end
    }
end

