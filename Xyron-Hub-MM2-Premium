    -- CAIXA NUMÉRICA À DIREITA
    local NumberBox = Instance.new("TextBox")
    NumberBox.Name = "NumberBox"
    NumberBox.AnchorPoint = Vector2.new(1, 0)
    NumberBox.Position = UDim2.new(1, -12, 0, 25)
    NumberBox.Size = UDim2.new(0, 65, 0, 24)
