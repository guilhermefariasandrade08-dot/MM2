local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local function CreateWindToggle(Parent, Config)
    Config = Config or {}

    local Title = Config.Title or "Exemplo de Toggle"
    local Description = Config.Description or "Ative ou desative esta opção."
    local Default = Config.Default or false
    local Callback = Config.Callback or function() end

    local Enabled = Default
    local Dragging = false
    local DragInput = nil
    local DragStart = nil
    local StartPosition = nil

    local ToggleWidth = 48
    local ToggleHeight = 26
    local KnobSize = 20

    -- CONTAINER
    local Container = Instance.new("Frame")
    Container.Name = "WindToggle"
    Container.Size = UDim2.new(1, -10, 0, 64)
    Container.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
