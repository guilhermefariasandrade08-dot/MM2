    Hitbox.AutoButtonColor = false
    Hitbox.ZIndex = 5
    Hitbox.Parent = Switch

    local function Animate(value)
        local knobPosition = value
            and UDim2.new(1, -23, 0.5, 0)
            or UDim2.new(0, 3, 0.5, 0)

        local knobColor = value and WHITE or Color3.fromRGB(155, 155, 155)

        -- Fundo azul quando ativado.
        local switchColor = value and BLUE or Color3.fromRGB(23, 23, 23)
        local borderColor = value and Color3.fromRGB(90, 175, 255)
            or Color3.fromRGB(65, 65, 65)

        TweenService:Create(
            Knob,
            TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {
                Position = knobPosition,
                BackgroundColor3 = knobColor
            }
        ):Play()

        TweenService:Create(
            Switch,
            TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {BackgroundColor3 = switchColor}
        ):Play()

        TweenService:Create(
            SwitchBorder,
            TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Color = borderColor}
        ):Play()
    end

    local function Set(value, fireCallback)
        Enabled = value == true
        Animate(Enabled)

        if fireCallback then
            local success, errorMessage = pcall(Callback, Enabled)
            if not success then
                warn("[XYRON HUB] Erro no callback do toggle: "
                    .. tostring(errorMessage))
            end
        end
    end

    Connect(Hitbox.Activated, function()
        Set(not Enabled, true)
    end)

    local ToggleAPI = {}

    function ToggleAPI:Set(value)
        Set(value, true)
    end

    function ToggleAPI:Get()
        return Enabled
    end

    function ToggleAPI:Destroy()
        for _, connection in ipairs(Connections) do
            connection:Disconnect()
        end
        Container:Destroy()
    end

    Animate(Enabled)
    return ToggleAPI
end

