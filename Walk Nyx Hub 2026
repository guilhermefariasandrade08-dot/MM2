local function CreateHeaderIcon(IconName, Parent)

	if not Icons then
		return nil
	end

	local Success, IconData = pcall(function()
		return Icons.Icon2(IconName, "lucide")
	end)

	if not Success then
		return nil
	end

	if type(IconData) ~= "table" then
		return nil
	end

	local ImageId = IconData[1]
	local IconInfo = IconData[2]

	if not ImageId then
		return nil
	end

	local Icon = Instance.new("ImageLabel")

	Icon.Name = "Icon"

	Icon.Size = UDim2.fromOffset(17, 17)

	Icon.Position = UDim2.new(
		0,
		8,
		0.5,
		-8.5
	)

	Icon.BackgroundTransparency = 1
	Icon.BorderSizePixel = 0

	Icon.Image = ImageId
	Icon.ImageColor3 = WHITE

	if IconInfo then

		if IconInfo.ImageRectSize then
			Icon.ImageRectSize = IconInfo.ImageRectSize
		end

		if IconInfo.ImageRectPosition then
			Icon.ImageRectOffset = IconInfo.ImageRectPosition
		end

	end

	Icon.ZIndex = 106
	Icon.Parent = Parent

	return Icon

end

