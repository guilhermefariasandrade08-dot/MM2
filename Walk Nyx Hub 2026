for TabName, Data in pairs(Tabs) do

	Data.Button.MouseButton1Click:Connect(function()

		if SelectedTab == TabName then
			return
		end

		SelectedTab = TabName

		for Name, PageData in pairs(Pages) do

			PageData.Page.Visible =
				Name == SelectedTab

		end

		UpdateTabs()

		PlayHubSound()

	end)

end

UpdateTabs()

--==============================================================--
-- DRAG DA INTERFACE
--==============================================================--

local DraggingWindow = false
local DragInput = nil
local DragStart = nil
local StartWindowPosition = nil

Header.InputBegan:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		DraggingWindow = true
		DragInput = Input
		DragStart = Input.Position
		StartWindowPosition = Window.Position

		Input.Changed:Connect(function()

			if Input.UserInputState ==
				Enum.UserInputState.End then

				DraggingWindow = false
				DragInput = nil

			end

		end)

	end

end)

Header.InputChanged:Connect(function(Input)

	if Input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or Input.UserInputType ==
		Enum.UserInputType.Touch then

		DragInput = Input

	end

end)

UserInputService.InputChanged:Connect(function(Input)

	if not DraggingWindow then
		return
	end

	if Input ~= DragInput then
		return
	end

	local Delta =
		Input.Position - DragStart

	local NewX =
		StartWindowPosition.X.Offset + Delta.X

	local NewY =
		StartWindowPosition.Y.Offset + Delta.Y

	Window.Position = UDim2.new(
		StartWindowPosition.X.Scale,
		NewX,
		StartWindowPosition.Y.Scale,
		NewY
	)

end)

--==============================================================--
-- ESTADO DA JANELA
--==============================================================--

local Opened = false
local Busy = false

local NORMAL_SIZE = UDim2.fromOffset(
	WINDOW_WIDTH,
	WINDOW_HEIGHT
)

local SavedWindowPosition = Window.Position

--==============================================================--
-- POSIÇÃO DE ABERTURA
--==============================================================--

local function GetBottomPosition()

	return UDim2.new(
		0.5,
		0,
		1,
		WINDOW_HEIGHT
	)

end

--==============================================================--
-- ABRIR
--==============================================================--

local function OpenWindow()

	if Busy or Opened then
		return
	end

	Busy = true
	Opened = true

	PlayHubSound()

	Window.Visible = true

	Window.Size = NORMAL_SIZE

	Window.Position =
		GetBottomPosition()

	Window.BackgroundTransparency = 1

	HubBackground.ImageTransparency = 1

	local WindowTween = TweenService:Create(

		Window,

		TweenInfo.new(
			0.45,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),

		{
			Position = SavedWindowPosition,
			BackgroundTransparency = 0
		}

	)

	local ImageTween = TweenService:Create(

		HubBackground,

		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			ImageTransparency = 0.18
		}

	)

	WindowTween:Play()
	ImageTween:Play()

	WindowTween.Completed:Once(function()

		Busy = false

	end)

end

--==============================================================--
-- FECHAR
--==============================================================--

local function CloseWindow()

	if Busy or not Opened then
		return
	end

	Busy = true
	Opened = false

	SavedWindowPosition = Window.Position

	PlayHubSound()

	local WindowTween = TweenService:Create(

		Window,

		TweenInfo.new(
			0.38,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),

		{
			Position = GetBottomPosition(),
			BackgroundTransparency = 1
		}

	)

	local ImageTween = TweenService:Create(

		HubBackground,

		TweenInfo.new(
			0.2,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		),

		{
			ImageTransparency = 1
		}

	)

	WindowTween:Play()
	ImageTween:Play()

	WindowTween.Completed:Once(function()

		Window.Visible = false

		Window.Position =
			SavedWindowPosition

		Window.Size =
			NORMAL_SIZE

		Window.BackgroundTransparency = 0

		HubBackground.ImageTransparency = 0.18

		Busy = false

	end)

end

--==============================================================--
-- BOTÃO FLUTUANTE
--==============================================================--

OpenButton.MouseButton1Click:Connect(function()

	if Busy then
		return
	end

	if Opened then
		CloseWindow()
	else
		OpenWindow()
	end

end)

--==============================================================--
-- RIGHT SHIFT
--==============================================================--

UserInputService.InputBegan:Connect(function(
	Input,
	GameProcessed
)

	if GameProcessed then
		return
	end

	if Input.KeyCode ==
		Enum.KeyCode.RightShift then

		if Busy then
			return
		end

		if Opened then
			CloseWindow()
		else
			OpenWindow()
		end

	end

end)

