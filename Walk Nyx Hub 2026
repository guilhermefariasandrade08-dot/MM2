		end

		SelectedTab = TabName

		for Name, Page in pairs(Pages) do

			Page.Visible =
				Name == SelectedTab

		end

		UpdateTabs()

		-- SOM AO TROCAR DE ABA
		PlayHubSound()

	end)

end

