--==============================================================--

local function UpdateTabs()

	for Name, Data in pairs(Tabs) do

		local Active = Name == SelectedTab

		Data.Indicator.Visible = Active

		if Active then

			Data.Button.BackgroundColor3 =
				TAB_ACTIVE

			if Data.Icon then

				TweenService:Create(

					Data.Icon,

					TweenInfo.new(
						0.18,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),

					{
						Size =
							UDim2.fromOffset(
								23,
								23
							),

						Position =
							UDim2.new(
								0.5,
								-11.5,
								0.5,
								-11.5
							),

						ImageColor3 =
							WHITE
					}

				):Play()

			end

		else

			Data.Button.BackgroundColor3 =
				TAB_COLOR

			if Data.Icon then

				TweenService:Create(

					Data.Icon,

					TweenInfo.new(
						0.18,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),

					{
						Size =
							UDim2.fromOffset(
								19,
								19
							),

						Position =
							UDim2.new(
								0.5,
								-9.5,
								0.5,
								-9.5
							),

						ImageColor3 =
							GRAY
					}

				):Play()

			end

		end

	end

end

