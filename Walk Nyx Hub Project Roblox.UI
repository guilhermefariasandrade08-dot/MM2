-- Sistema de Highlight
local Highlights = {}

local function LimparEsp()
    for _, highlight in pairs(Highlights) do
        if highlight then highlight:Destroy() end
    end
    table.clear(Highlights)
end

RunService.RenderStepped:Connect(function()
    if not ESPConfig.Active then
        LimparEsp()
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if ESPConfig.TargetType == "No my highlight" and p == Player then
            if Highlights[p] then
                Highlights[p]:Destroy()
                Highlights[p] = nil
            end
            continue
        end

        if p.Character then
            local highlight = Highlights[p]
            local cor = ObterCorCargo(p.Name)

            if not highlight or highlight.Parent ~= p.Character then
                if highlight then highlight:Destroy() end

                local newHighlight = Instance.new("Highlight")
                newHighlight.Name = "WalkNyx_ESP"
                newHighlight.Adornee = p.Character
                newHighlight.FillColor = cor
                newHighlight.OutlineColor = cor
                newHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

                if ESPConfig.Mode == "Highlight" then
                    newHighlight.FillTransparency = ESPConfig.Transparency
                    newHighlight.OutlineTransparency = 0
                else
                    newHighlight.FillTransparency = 1
                    newHighlight.OutlineTransparency = ESPConfig.Transparency
                end

                newHighlight.Parent = p.Character
                Highlights[p] = newHighlight
            else
                highlight.FillColor = cor
                highlight.OutlineColor = cor

                if ESPConfig.Mode == "Highlight" then
                    highlight.FillTransparency = ESPConfig.Transparency
                    highlight.OutlineTransparency = 0
                else
                    highlight.FillTransparency = 1
                    highlight.OutlineTransparency = ESPConfig.Transparency
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if Highlights[p] then
        Highlights[p]:Destroy()
        Highlights[p] = nil
    end
end)

-- Sistema de Tracers
local TracersList = {}

local function LimparTracers()
    for _, line in pairs(TracersList) do
        if line then line:Remove() end
    end
    table.clear(TracersList)
end

RunService.RenderStepped:Connect(function()
    TracersConfig_Active_Check = TracersConfig.Active
    if not TracersConfig.Active then
        LimparTracers()
        return
    end

    local screenSize = Camera.ViewportSize
    local originPoint = Vector2.new(screenSize.X / 2, screenSize.Y)

    if TracersConfig.Position == "Top" then
        originPoint = Vector2.new(screenSize.X / 2, 0)
    elseif TracersConfig.Position == "Middle" then
        originPoint = Vector2.new(screenSize.X / 2, screenSize.Y / 2)
    elseif TracersConfig.Position == "Bottom" then
        originPoint = Vector2.new(screenSize.X / 2, screenSize.Y)
    end

    local jogadoresAtivos = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if ESPConfig and ESPConfig.TargetType == "No my highlight" and p == Player then
            continue
        end

        if p.Character then
            local char = p.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                jogadoresAtivos[p] = true
                
                if not TracersList[p] then
                    local line = Drawing.new("Line")
                    line.Visible = false
                    TracersList[p] = line
                end

                local line = TracersList[p]
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    line.From = originPoint
                    line.To = Vector2.new(vector.X, vector.Y)
                    line.Color = ObterCorCargo(p.Name)
                    line.Thickness = TracersConfig.Thickness
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
        end
    end

    for p, line in pairs(TracersList) do
        if not jogadoresAtivos[p] or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
            if line then line:Remove() end
            TracersList[p] = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if TracersList[p] then
        TracersList[p]:Remove()
        TracersList[p] = nil
    end
end)

