-- Lógica do Noclip
function ToggleNoclip(state)
    NoclipActive = state

    if not NoclipActive then
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
        return
    end

    NoclipConnection = RunService.Stepped:Connect(function()
        if not NoclipActive then return end
        local char = Player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
end

Player.CharacterAdded:Connect(function()
    if NoclipActive then
        task.wait(1)
        ToggleNoclip(true)
    end
end)

-- ==============================================================--
-- SISTEMA DE LÓGICA DO WALK FLING E ANTI FLING
-- ==============================================================--

function ToggleWalkFling(state)
    WalkFlingAtivo = state

    if not WalkFlingAtivo then
        if FlingConnection then
            FlingConnection:Disconnect()
            FlingConnection = nil
        end
        return
    end

    FlingConnection = RunService.Heartbeat:Connect(function()
        if not WalkFlingAtivo then return end

        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if hrp and humanoid then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            local oldCFrame = hrp.CFrame
            local vel = hrp.AssemblyLinearVelocity

            hrp.CFrame = oldCFrame * CFrame.Angles(0, math.rad(math.random(1, 360)), 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, FlingPower, 0)

            RunService.RenderStepped:Wait()
            if hrp then
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                if humanoid.MoveDirection.Magnitude > 0 then
                    hrp.AssemblyLinearVelocity = vel
                else
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)
end

Player.CharacterAdded:Connect(function()
    if WalkFlingAtivo then
        task.wait(1.5)
        ToggleWalkFling(true)
    end
end)

task.spawn(function()
    while true do
        if getgenv().AntiFling then
            pcall(function()
                for _, OtherPlayer in ipairs(Players:GetPlayers()) do
                    if OtherPlayer ~= Player and OtherPlayer.Character then
                        for _, Part in ipairs(OtherPlayer.Character:GetChildren()) do
                            if Part:IsA("BasePart") then
                                Part.CanCollide = false
                                Part.AssemblyLinearVelocity = Vector3.zero
                                Part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    end
                end
            end)
        end
        RunService.Stepped:Wait()
    end
end)


-- ==============================================================--
-- SISTEMA DE LÓGICA DO FLY
-- ==============================================================--

local function StartFly()
    local c = Player.Character
    if not c then return end
    local h = c:FindFirstChild("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end

    if bv then bv:Destroy() end
    if bg then bg:Destroy() end

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.P = 3000
    bv.Parent = r

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 30000
    bg.D = 500
    bg.CFrame = r.CFrame
    bg.Parent = r

    h.PlatformStand = true

    if con then con:Disconnect() end
    con = RunService.Heartbeat:Connect(function()
        if not FlyAtivo or not bv or not bg then return end
        local cam = workspace.CurrentCamera
        
        if controls and typeof(controls.GetMoveVector) == "function" then
            local m = controls:GetMoveVector()
            local dir = (cam.CFrame.RightVector * m.X) + (cam.CFrame.LookVector * -m.Z)
            
            bv.Velocity = dir * FlyVelocidade
            bg.CFrame = cam.CFrame
        end
    end)
end

local function StopFly()
    FlyAtivo = false
    if con then con:Disconnect() con = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end

    local c = Player.Character
    if c and c:FindFirstChild("Humanoid") then
        c.Humanoid.PlatformStand = false
    end
end

function ToggleFly(state)
    FlyAtivo = state
    if FlyAtivo then
        StartFly()
    else
        StopFly()
    end
end

Player.CharacterAdded:Connect(function()
    task.wait(0.8)
    if FlyAtivo then 
        StartFly() 
    end
end)

