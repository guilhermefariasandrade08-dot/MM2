end)

-- =========================================================================
-- 👤 SISTEMA: LISTA DINÂMICA E TELEPORTE/PERSEGUIÇÃO DE JOGADORES
-- =========================================================================

-- Função para obter e ordenar os jogadores (Murderer em 1º, Sheriff em 2º, Resto depois)
local function ObterListaJogadoresOrdenada()
    local listaNomes = {}
    local dadosRoles = {}
    
    -- Tenta puxar os dados de roles do jogo (mesma lógica usada no Silent AIM)
    local DataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    local ok, Data = pcall(function() return DataRemote and DataRemote:InvokeServer() or nil end)
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local role = "Inocente"
            if ok and Data and Data[p.Name] then
                local info = Data[p.Name]
                if info.Role then
                    role = tostring(info.Role)
                end
            end
            
            -- Atribui pontuação de prioridade para a ordenação
            local prioridade = 3
            local lowerRole = string.lower(role)
            if string.find(lowerRole, "murderer") then
                prioridade = 1
            elseif string.find(lowerRole, "sheriff") then
                prioridade = 2
            end
            
            table.insert(dadosRoles, {player = p, name = p.Name, priority = prioridade})
        end
    end
    
    -- Ordena: Murderer (1) primeiro, Sheriff (2) segundo, e os demais por ordem alfabética ou de entrada
    table.sort(dadosRoles, function(a, b)
        if a.priority ~= b.priority then
            return a.priority < b.priority
        end
        return a.name < b.name
    end)
    
    for _, item in ipairs(dadosRoles) do
        table.insert(listaNomes, item.name)
    end
    
    return listaNomes
end

-- Função de Teleporte Direto
local function TeleportarParaPlayer(nomePlayer)
    local targetPlayer = Players:FindFirstChild(nomePlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    
    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    if not targetHRP or not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    
    -- Teleporta levemente atrás/perto do alvo
    myChar.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
end

-- Função de Perseguição Contínua (Toggle)
local function IniciarPerseguicao()
    if tpPerseguicaoConnection then return end
    
    tpPerseguicaoConnection = RunService.RenderStepped:Connect(function()
        if not tpPerseguicaoAtivo or not playerSelecionadoTeleport then return end
        
        local targetPlayer = Players:FindFirstChild(playerSelecionadoTeleport)
        if not targetPlayer or not targetPlayer.Character then return end
        
        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myChar = LocalPlayer.Character
        if not targetHRP or not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
        
        -- Mantém o personagem colado/perseguindo o alvo suavemente via CFrame
        myChar.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
    end)
end

local function PararPerseguicao()
    tpPerseguicaoAtivo = false
    if tpPerseguicaoConnection then
        tpPerseguicaoConnection:Disconnect()
        tpPerseguicaoConnection = nil
    end
end

-- =========================================================================
-- 🗺️ SISTEMA: DETETAR MAPA ATUAL E TELEPORTAR
-- =========================================================================

local function ObterMapaAtual()
    -- Procura no workspace por qualquer um dos mapas da tabela que esteja carregado
    for mapName, _ in pairs(MAP_SAFE_POSITIONS) do
        if workspace:FindFirstChild(mapName, true) then
            return mapName
        end
    end
    
    -- Método alternativo caso o mapa esteja dentro de uma pasta específica de ronda
    local CoinContainer = workspace:FindFirstChild("CoinContainer", true)
    if CoinContainer then
        local parentFolder = CoinContainer.Parent
        if parentFolder and parentFolder ~= workspace then
            if MAP_SAFE_POSITIONS[parentFolder.Name] then
                return parentFolder.Name
            end
        end
    end
    
    return nil
end

local function TeleportarParaSpawnDoMapa()
    local mapaAtual = ObterMapaAtual()
    if not mapaAtual then
        warn("[Teleport] Nenhum mapa conhecido foi detetado no momento!")
        return
    end
    
    local posVector = MAP_SAFE_POSITIONS[mapaAtual]
    local char = LocalPlayer.Character
    if posVector and char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(posVector)
        print("[Teleport] Teleportado com sucesso para o mapa: " .. mapaAtual)
    end
end

-- ============================
-- SEÇÃO: TELEPORT - PLAYER TAB CALLERS
-- ============================

-- 1. Dropdown Dinâmico com a lista de jogadores atualizada (Murderer em 1º, Sheriff em 2º)
local dropdownRef = CreateDropdown("Teleporte", "Selecionar Jogador", ObterListaJogadoresOrdenada(), "", function(selected)
    playerSelecionadoTeleport = selected
end)

-- Atualiza a lista automaticamente a cada 2 segundos para remover quem saiu e adicionar quem entrou
task.spawn(function()
    while true do
        task.wait(2)
        pcall(function()
            if dropdownRef and typeof(dropdownRef.Refresh) == "function" then
                dropdownRef:Refresh(ObterListaJogadoresOrdenada())
            end
        end)
    end
end)

-- 2. Botão de Clique para Teleportar Instantaneamente
CreateButton("Teleporte", "Teleportar para Jogador", function()
    if playerSelecionadoTeleport then
        TeleportarParaPlayer(playerSelecionadoTeleport)
    end
end)

-- 3. Toggle de Perseguição Contínua (Teleporta e fica seguindo via CFrame)
CreateToggle("Teleporte", "Perseguir Jogador (Loop)", false, function(state)
    tpPerseguicaoAtivo = state
    if state then
        if playerSelecionadoTeleport then
            IniciarPerseguicao()
        else
            tpPerseguicaoAtivo = false
        end
    else
        PararPerseguicao()
    end
end)

-- ============================
-- SEÇÃO: TELEPORT - MAP TELEPORT BUTTON
-- ============================

CreateButton("Teleporte", "Teleportar para o Mapa Atual", function()
    TeleportarParaSpawnDoMapa()
end)

