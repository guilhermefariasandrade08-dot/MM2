local Confirm = Create("Frame", {
    Name = "CloseConfirmation",
    Size = UDim2.fromOffset(255, 130),
    Position = UDim2.new(0.5, -127.5, 0.5, -65),
    BackgroundColor3 = C.Black,
    BorderSizePixel = 0,
    Visible = false,
    ZIndex = 50
}, GUI)

Round(Confirm, 9)
Outline(Confirm, C.White, 1)

local confirmTitle = Label(Confirm, "Script Aimbot Roblox", 13, UDim2.fromOffset(13, 8), UDim2.new(1, -26, 0, 25))
confirmTitle.ZIndex = 51

local confirmText = Label(Confirm, "Deseja fechar a interface completamente?", 10, UDim2.fromOffset(13, 36), UDim2.new(1, -26, 0, 32))
confirmText.TextColor3 = C.Gray
confirmText.TextWrapped = true
confirmText.ZIndex = 51

local function ConfirmButton(text, x, callback)
    local button = Create("TextButton", {
        Size = UDim2.fromOffset(104, 30),
        Position = UDim2.new(0, x, 1, -40),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = C.White,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        ZIndex = 51
    }, Confirm)

    Round(button, 6)
    Outline(button, C.Border, 1)
    button.Activated:Connect(callback)
    return button
end

ConfirmButton("Sim", 13, function() GUI:Destroy() end)
ConfirmButton("Não", 138, function() Confirm.Visible = false end)

Close.Activated:Connect(function() Confirm.Visible = true end)

local FloatingButton = Create("TextButton", {
    Name = "FloatingButton",
    Size = UDim2.fromOffset(43, 43),
    Position = UDim2.new(0, 16, 0.5, -21),
    BackgroundColor3 = C.Black,
    BorderSizePixel = 0,
    Text = "S",
    TextColor3 = C.White,
    TextSize = 20,
    Font = Enum.Font.GothamMedium,
    AutoButtonColor = false,
    ZIndex = 10
}, GUI)

Round(FloatingButton, 11)
Outline(FloatingButton, C.White, 1)

FloatingButton.MouseEnter:Connect(function() Tween(FloatingButton, { BackgroundColor3 = C.Element }) end)
FloatingButton.MouseLeave:Connect(function() Tween(FloatingButton, { BackgroundColor3 = C.Black }) end)
FloatingButton.Activated:Connect(function() Window.Visible = not Window.Visible end)

-- Arrastar Janela
local dragging = false
local dragStart = nil
local startPosition = nil
local activeInput = nil

Header.Active = true
Header.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if dragging then return end
    dragging = true
    activeInput = input
    dragStart = input.Position
    startPosition = Window.Position

    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End and activeInput == input then
            dragging = false
            activeInput = nil
        end
    end)
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging or not activeInput then return end
    local isMouseMove = activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
    local isTouchMove = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput
    if not isMouseMove and not isTouchMove then return end

    local delta = input.Position - dragStart
    Window.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
end)

UserInputService.InputEnded:Connect(function(input)
    if not activeInput then return end
    if input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        activeInput = nil
    end
end)

SelectPage("Informação")
print("Script Roblox carregado com sucesso!")
