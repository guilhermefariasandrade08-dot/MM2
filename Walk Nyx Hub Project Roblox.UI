--==============================================================--
-- 01. SERVIÇOS E VARIÁVEIS GLOBAIS
--==============================================================--

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local GUI_NAME = "ScriptAimbotRoblox"

--==============================================================--
-- 02. CORES DA INTERFACE
--==============================================================--

local C = {
    Black = Color3.fromRGB(5, 5, 5),
    Sidebar = Color3.fromRGB(8, 8, 8),
    Content = Color3.fromRGB(13, 13, 13),
    Element = Color3.fromRGB(19, 19, 19),
    Hover = Color3.fromRGB(30, 30, 30),
    White = Color3.fromRGB(245, 245, 245),
    Gray = Color3.fromRGB(130, 130, 130),
    Border = Color3.fromRGB(43, 43, 43),
    Blue = Color3.fromRGB(45, 125, 255),
}

--==============================================================--
-- 03. VARIÁVEIS DOS RECURSOS
--==============================================================--

local RecursoPrincipalAtivo = false
local Intensidade = 50
local ModoSelecionado = "Padrão"

--==============================================================--
-- 04. FUNÇÕES AUXILIARES DA INTERFACE
--==============================================================--

local function Create(class, props, parent)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function Round(obj, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 7)
    }, obj)
end

local function Outline(obj, color, thickness)
    return Create("UIStroke", {
        Color = color or C.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, obj)
end

local function Tween(obj, props, duration)
    local animation = TweenService:Create(
        obj,
        TweenInfo.new(
            duration or 0.18,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        props
    )

    animation:Play()
    return animation
end

local function Label(parent, text, size, position, dimensions)
    return Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = position,
        Size = dimensions,
        Text = text,
        TextSize = size or 12,
        TextColor3 = C.White,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, parent)
end

--==============================================================--
-- 05. REMOVER GUI ANTIGA E CRIAR SCREEN GUI
--==============================================================--

local previous = PlayerGui:FindFirstChild(GUI_NAME)

