    if not MostrarCirculoAura and ContornoVermelhoFolder then
        ContornoVermelhoFolder:Destroy()
        ContornoVermelhoFolder = nil
    end
end)

CreateSlider("Murderer", "Distância do Kill Aura", 5, 50, 15, function(value)
    RaioKillAura = value
end)

-- =========================================================================
-- 🗡️ SISTEMA DO KILL ALL LOOP AUTOMÁTICO
-- =========================================================================

task.spawn(function()
    while true do
        if killAllLoopAtivo then
            local Char = LocalPlayer and LocalPlayer.Character
            
            -- Checa se o jogador é realmente o Murderer (tem a faca)
            local knife = Char and (Char:FindFirstChild("Knife") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Knife")))
            
            if knife then
                -- Garante que a faca está equipada na mão para o ataque funcionar
                if knife.Parent ~= Char then
                    knife.Parent = Char
                    task.wait(0.02)
                end
                
                local eventos = knife:FindFirstChild("Events")
                if eventos and eventos:FindFirstChild("KnifeStabbed") and eventos:FindFirstChild("HandleTouched") then
                    -- Executa o ataque em loop para todos os alvos válidos na sessão
                    for _, target in ipairs(Players:GetPlayers()) do
                        if target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("Head") and target.Character:FindFirstChild("Humanoid") then
                            if target.Character.Humanoid.Health > 0 then
                                pcall(function()
                                    eventos.KnifeStabbed:FireServer()
                                    eventos.HandleTouched:FireServer(target.Character.Head)
                                end)
                            end
                        end
                    end
                end
            end
        end
        -- Intervalo de segurança do loop (ajustado para otimizar o desempenho no mobile)
        task.wait(0.3)
    end
end)

-- =========================================================================
-- 🗡️ SISTEMA COMPLETO: KILL AURA + CÍRCULO TRACEJADO
-- =========================================================================

local function PlayerTemFaca()
    local Char = LocalPlayer.Character
    if not Char then return false end
    if Char:FindFirstChild("Knife") then return true end
    if LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife") then return true end
    return false
end

local function ExecutarAtaque(Alvo)
    local Char = LocalPlayer.Character
    if not Char then return end
    
    local Faca = Char:FindFirstChild("Knife") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife"))
    if not Faca then return end
    
    if Faca.Parent ~= Char then 
        Faca.Parent = Char 
        task.wait(0.02) 
    end
    
    local Eventos = Faca:FindFirstChild("Events")
    if not Eventos then return end

    if Alvo and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
        pcall(function()
            Eventos.KnifeStabbed:FireServer()
            Eventos.HandleTouched:FireServer(Alvo.Character.Head)
        end)
    end
end

local function AtualizarCirculoAura()
    if not LocalPlayer then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not MostrarCirculoAura or not hrp then
        if ContornoVermelhoFolder then
            ContornoVermelhoFolder:Destroy()
            ContornoVermelhoFolder = nil
        end
        return
    end

    if not ContornoVermelhoFolder or not ContornoVermelhoFolder.Parent then
        ContornoVermelhoFolder = Instance.new("Folder")
        ContornoVermelhoFolder.Name = "KillAuraDashedBorderRed"
        ContornoVermelhoFolder.Parent = hrp
    else
        ContornoVermelhoFolder:ClearAllChildren()
    end

    ContornoVermelhoFolder.Parent = hrp

    local numTracos = math.clamp(math.floor(RaioKillAura * 1.5), 12, 48)
    for i = 1, numTracos do
        local angulo = (i / numTracos) * (math.pi * 2)
        local part = Instance.new("Part")
        part.Name = "Dash"
        part.Size = Vector3.new(0.6, 0.1, 1.2)
        part.Color = Color3.fromRGB(255, 0, 0)
        part.Material = Enum.Material.Neon
        part.Transparency = 0.1
        part.Anchored = false
        part.CanCollide = false
        part.CastShadow = false

        local highlight = Instance.new("Highlight")
        highlight.Adornee = part
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
        highlight.FillTransparency = 0
        highlight.OutlineTransparency = 0
        highlight.Parent = part

        local weld = Instance.new("WeldConstraint")
        part.Parent = ContornoVermelhoFolder
        
        local posX = math.cos(angulo) * RaioKillAura
        local posZ = math.sin(angulo) * RaioKillAura
        part.CFrame = hrp.CFrame * CFrame.new(posX, -2.5, posZ) * CFrame.Angles(0, -angulo, 0)

        weld.Part0 = hrp
        weld.Part1 = part
        weld.Parent = part
    end
end

-- Loop de Combate (Kill Aura) e Atualização do Círculo
task.spawn(function()
    while true do
        task.wait(0.1)

        if KillAuraAtivo and PlayerTemFaca() then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                for _, Alvo in ipairs(Players:GetPlayers()) do
                    if not KillAuraAtivo then break end
                    if Alvo ~= LocalPlayer and Alvo.Character then
                        local alvoHrp = Alvo.Character:FindFirstChild("HumanoidRootPart")
                        local alvoHum = Alvo.Character:FindFirstChildOfClass("Humanoid")
                        
                        if alvoHrp and alvoHum and alvoHum.Health > 0 then
                            local distancia = (hrp.Position - alvoHrp.Position).Magnitude
                            if distancia <= RaioKillAura then
                                ExecutarAtaque(Alvo)
                            end
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        AtualizarCirculoAura()
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    AtualizarCirculoAura()
end)



-- =========================================================================
-- 🎯 SISTEMA COMPLETO E DEFINITIVO: SILENT AIM FLUTUANTE
-- =========================================================================

local function GetPing()
    local ok, value = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and value or 100
end

local function GetMurderer()
    local DataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not DataRemote then return nil end
    local ok, Data = pcall(function() return DataRemote:InvokeServer() end)
    if not ok or not Data then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local Info = Data[p.Name]
            if Info and not Info.Killed and not Info.Dead then
                local isMurderer = false
                if Info.Role == "Murderer" or (Info.Role and string.lower(Info.Role) == "murderer") then
                    isMurderer = true
                end
                if isMurderer then return p end
            end
        end
    end
    return nil
end

local function ShootMurderer(TextoLabel)
    if SilentPressed then return end

    local Char = Player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end

    local Gun = Char:FindFirstChild("Gun") or (Player:FindFirstChild("Backpack") and Player.Backpack:FindFirstChild("Gun"))
    
    if not Gun then
        if TextoLabel and currentSilentBtnRef and currentSilentStrokeRef then
            TextoLabel.Text = "Not Gun"
            currentSilentBtnRef.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            currentSilentStrokeRef.Color = Color3.fromRGB(255, 60, 60)
            
            task.delay(1, function()
                if TextoLabel and TextoLabel.Parent and currentSilentBtnRef and currentSilentStrokeRef then
                    TextoLabel.Text = "Silent AIM"
                    currentSilentBtnRef.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    currentSilentStrokeRef.Color = Color3.fromRGB(39, 40, 48)
                end
            end)
        end
        return 
    end

    SilentPressed = true

    if Gun.Parent ~= Char then
        Gun.Parent = Char
        task.wait(0.05)
    end

    local Murderer = GetMurderer()
    if not Murderer or not Murderer.Character then 
        SilentPressed = false 
        return 
    end

    local TargetHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    local TargetTorso = Murderer.Character:FindFirstChild("Torso") or Murderer.Character:FindFirstChild("UpperTorso")
    if not TargetHRP or not TargetTorso then 
        SilentPressed = false 
        return 
    end

    local Ping = GetPing()
    local PredictionTime = (Ping / 1000) * (ShootPredictMultiplier or 1)
    local Velocity = TargetHRP.Velocity
    local PredictedPos = Velocity.Magnitude < 1 and TargetTorso.Position or TargetTorso.Position + (Velocity * PredictionTime)
    
    local MyPos = Char.HumanoidRootPart.Position
    local RayDirection = (PredictedPos - MyPos)
    
    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.FilterDescendantsInstances = {Char, Murderer.Character}
    RayParams.IgnoreWater = true

    local RayResult = workspace:Raycast(MyPos, RayDirection, RayParams)
    local OriginCFrame = RayResult and CFrame.new(RayResult.Position + (RayDirection.Unit * 1.5), PredictedPos) or CFrame.new(MyPos, PredictedPos)

    local ShootEvent = Gun:FindFirstChild("ShootEvent", true) or Gun:FindFirstChild("Shoot", true) or ReplicatedStorage:FindFirstChild("Shoot", true)
    if ShootEvent then
        if ShootEvent:IsA("RemoteEvent") then
            ShootEvent:FireServer(OriginCFrame, CFrame.new(PredictedPos))
        elseif ShootEvent:IsA("RemoteFunction") then
            ShootEvent:InvokeServer(OriginCFrame, CFrame.new(PredictedPos))
        end
    end

    if TextoLabel then TextoLabel.Text = "Fired!" end
    task.delay(1, function()
        if TextoLabel and TextoLabel.Parent then
            TextoLabel.Text = "Silent AIM"
        end
        SilentPressed = false
    end)
end

function CreateSilentButton()
    if SilentButtonGui then 
        SilentButtonGui.Enabled = true
        return 
    end
    
    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "Sheriff_SilentAimGui"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.IgnoreGuiInset = true
    GuiBtn.DisplayOrder = 999999 -- Fica por cima de tudo
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = PlayerGui
    
    local Btn = Instance.new("ImageButton")
    Btn.AnchorPoint = Vector2.new(0.5, 0.5)
    Btn.Position = UDim2.new(0.5, 0, 0.25, 0)
    Btn.Size = UDim2.new(0, tamanhoSilentBase, 0, tamanhoSilentBase / 2.5)
    Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Btn.BackgroundTransparency = 0.4
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.Parent = GuiBtn
    
    currentSilentBtnRef = Btn
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn
    currentSilentCornerRef = Corner
    
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(39, 40, 48)
    Borda.Thickness = 1.5
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn
    currentSilentStrokeRef = Borda
    
    local Texto = Instance.new("TextLabel")
    Texto.Name = "SilentText"
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.Text = "Silent AIM"
    Texto.TextColor3 = Color3.fromRGB(245, 245, 245)
    Texto.Font = Enum.Font.GothamBold
    Texto.TextSize = 14
    Texto.Parent = Btn
    
    task.spawn(function()
        while SilentButtonGui and SilentButtonGui.Enabled and Btn and Texto and currentSilentStrokeRef do
            if Texto.Text ~= "Not Gun" and Texto.Text ~= "Fired!" then
                local Char = Player.Character
                local temArma = Char and (Char:FindFirstChild("Gun") or (Player:FindFirstChild("Backpack") and Player.Backpack:FindFirstChild("Gun")))
                if temArma then
                    currentSilentStrokeRef.Color = Color3.fromRGB(60, 220, 100)
                else
                    currentSilentStrokeRef.Color = Color3.fromRGB(39, 40, 48)
                end
            end
            task.wait(0.4)
        end
    end)
    
    -- Lógica de Arrastar com Bloqueio de Multitoque e Proteção Contra Saltos
    local dragStart, startPos, dragInputConn, dragEndedConn, activeInput = nil, nil, nil, nil, nil
    
    Btn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not activeInput then
            activeInput = input
            isDraggingSilent = false
            dragStart = input.Position
            startPos = Btn.Position
            
            if dragInputConn then dragInputConn:Disconnect() end
            dragInputConn = game:GetService("UserInputService").InputChanged:Connect(function(moveInput)
                if moveInput == activeInput or (activeInput.UserInputType == Enum.UserInputType.MouseButton1 and moveInput.UserInputType == Enum.UserInputType.MouseMovement) then
                    local delta = moveInput.Position - dragStart
                    if delta.Magnitude > 5 then
                        isDraggingSilent = true
                        Btn.Position = UDim2.new(
                            startPos.X.Scale, 
                            startPos.X.Offset + delta.X, 
                            startPos.Y.Scale, 
                            startPos.Y.Offset + delta.Y
                        )
                    end
                end
            end)
            
            if dragEndedConn then dragEndedConn:Disconnect() end
            dragEndedConn = game:GetService("UserInputService").InputEnded:Connect(function(endInput)
                if endInput == activeInput or (activeInput.UserInputType == Enum.UserInputType.MouseButton1 and endInput.UserInputType == Enum.UserInputType.MouseButton1) then
                    if not isDraggingSilent then
                        ShootMurderer(Texto)
                    end
                    if dragInputConn then dragInputConn:Disconnect() dragInputConn = nil end
                    if dragEndedConn then dragEndedConn:Disconnect() dragEndedConn = nil end
                    isDraggingSilent = false
                    activeInput = nil
                end
            end)
        end
    end)
    
    SilentButtonGui = GuiBtn
end

local function RemoveSilentButton()
    if SilentButtonGui then
        SilentButtonGui.Enabled = false
    end
end

-- =========================================================================
-- 🔫 SISTEMA COMPLETO: GRAB & TELEPORT GUN FLUTUANTE
-- =========================================================================

local function GetGunDrop()
    local MapContainer = workspace:FindFirstChild("CoinContainer", true) and workspace:FindFirstChild("CoinContainer", true).Parent
    local mapToSearch = MapContainer or workspace
    local gunDrop = mapToSearch:FindFirstChild("GunDrop", true) or workspace:FindFirstChild("GunDrop", true)
    if gunDrop and gunDrop:IsA("BasePart") then
        return gunDrop
    end
    return nil
end

local function TriggerGrabGun(TextoLabel)
    if GrabPressed then return end
    
    local Char = Player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end
    
    local gunDrop = GetGunDrop()
    
    -- Se a arma não estiver caída no mapa: muda para vermelho e mostra "Not Gun" por 1 segundo
    if not gunDrop then
        if TextoLabel and currentGrabBtnRef and currentGrabStrokeRef then
            TextoLabel.Text = "Not Gun"
            currentGrabBtnRef.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            currentGrabStrokeRef.Color = Color3.fromRGB(255, 60, 60)
            
            task.delay(1, function()
                if TextoLabel and TextoLabel.Parent and currentGrabBtnRef and currentGrabStrokeRef then
                    if modoGrabAtual == "Grab" then
                        TextoLabel.Text = "Grab Gun"
                    else
                        TextoLabel.Text = "Teleport Gun"
                    end
                    currentGrabBtnRef.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    currentGrabStrokeRef.Color = Color3.fromRGB(39, 40, 48)
                end
            end)
        end
        return
    end
    
    GrabPressed = true
    
    if modoGrabAtual == "Grab" then
        gunDrop.CFrame = Char.HumanoidRootPart.CFrame
        if TextoLabel then TextoLabel.Text = "Grabbed!" end
        task.delay(1, function()
            if TextoLabel and TextoLabel.Parent then
                TextoLabel.Text = "Grab Gun"
            end
            GrabPressed = false
        end)
        
    elseif modoGrabAtual == "Teleport" then
        -- Teleporta até a arma, aguarda um instante mínimo e retorna voando para a posição original
        local posOriginal = Char.HumanoidRootPart.CFrame
        Char.HumanoidRootPart.CFrame = gunDrop.CFrame
        task.wait(0.08)
        
        if Char and Char:FindFirstChild("HumanoidRootPart") then
            Char.HumanoidRootPart.CFrame = posOriginal
        end
        
        if TextoLabel then TextoLabel.Text = "Teleported!" end
        task.delay(1, function()
            if TextoLabel and TextoLabel.Parent then
                TextoLabel.Text = "Teleport Gun"
            end
            GrabPressed = false
        end)
    end
end

function CreateGrabButton()
    if GrabButtonGui then 
        GrabButtonGui.Enabled = true
        return 
    end
    
    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "Sheriff_GrabGunGui"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = PlayerGui
    
    local Btn = Instance.new("ImageButton")
    Btn.AnchorPoint = Vector2.new(0.5, 0.5)
    Btn.Position = UDim2.new(0.5, 0, 0.45, 0)
    Btn.Size = UDim2.new(0, tamanhoGrabBase, 0, tamanhoGrabBase / 2.5)
    Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Btn.BackgroundTransparency = 0.4
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.Parent = GuiBtn
    
    currentGrabBtnRef = Btn
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn
    currentGrabCornerRef = Corner
    
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(39, 40, 48)
    Borda.Thickness = 1.5
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn
    currentGrabStrokeRef = Borda
    
    local Texto = Instance.new("TextLabel")
    Texto.Name = "GrabText"
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    if modoGrabAtual == "Grab" then
        Texto.Text = "Grab Gun"
    else
        Texto.Text = "Teleport Gun"
    end
    Texto.TextColor3 = Color3.fromRGB(245, 245, 245)
    Texto.Font = Enum.Font.GothamBold
    Texto.TextSize = 13
    Texto.Parent = Btn
    
    -- Loop para verificar em tempo real se a arma caiu e deixar a borda verde
    task.spawn(function()
        while GrabButtonGui and GrabButtonGui.Enabled and Btn and Texto and currentGrabStrokeRef do
            if Texto.Text ~= "Not Gun" and Texto.Text ~= "Grabbed!" and Texto.Text ~= "Teleported!" then
                local gunDrop = GetGunDrop()
                if gunDrop then
                    currentGrabStrokeRef.Color = Color3.fromRGB(60, 220, 100)
                else
                    currentGrabStrokeRef.Color = Color3.fromRGB(39, 40, 48)
                end
            end
            task.wait(0.4)
        end
    end)
    
    local dragStart, startPos
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingGrab = false
            dragStart = input.Position
            startPos = Btn.AbsolutePosition
        end
    end)
    
    Btn.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) and dragStart then
            local delta = input.Position - dragStart
            if delta.Magnitude > 10 then
                isDraggingGrab = true
                Btn.Position = UDim2.new(0, startPos.X + delta.X + (Btn.AbsoluteSize.X / 2), 0, startPos.Y + delta.Y + (Btn.AbsoluteSize.Y / 2))
            end
        end
    end)
    
    Btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not isDraggingGrab then
                TriggerGrabGun(Texto)
            end
            dragStart = nil
            isDraggingGrab = false
        end
    end)
    
    GrabButtonGui = GuiBtn
end

local function RemoveGrabButton()
    if GrabButtonGui then
        GrabButtonGui.Enabled = false
    end
end

-- =========================================================================
-- 🔄 SISTEMA: AUTO GRAB GUN LOOP INTELIGENTE
-- =========================================================================

local function StartAutoGrabLoop()
    if AutoGrabConnection then return end
    
    AutoGrabConnection = task.spawn(function()
        while AutoGrabEnabled do
            local Char = Player.Character
            local Backpack = Player:FindFirstChild("Backpack")
            
            -- Verifica se o jogador já tem a arma (equipada ou na mochila)
            local temArma = (Char and Char:FindFirstChild("Gun")) or (Backpack and Backpack:FindFirstChild("Gun"))
            
            -- Se NÃO tem a arma, tenta puxar automaticamente
            if not temArma then
                local gunDrop = GetGunDrop() -- Usa a mesma função de achar o GunDrop que já temos
                if gunDrop and Char and Char:FindFirstChild("HumanoidRootPart") then
                    -- Puxa a arma para a posição do jogador instantaneamente
                    gunDrop.CFrame = Char.HumanoidRootPart.CFrame
                end
            end
            
            task.wait(0.3) -- Intervalo de checagem para não pesar o jogo
        end
        
        if AutoGrabConnection then
            AutoGrabConnection = nil
        end
    end)
end

local function StopAutoGrabLoop()
    AutoGrabEnabled = false
    AutoGrabConnection = nil
end

-- =========================================================================
-- ⭕ SISTEMA COMPLETO: FOV CIRCLE INTELIGENTE E PERSONALIZADO
-- =========================================================================

local function AdicionarElementoCorFov(instancia, tipo)
    table.insert(elementosVisualFov, {obj = instancia, tipo = tipo})
end

local function GetMurdererFov()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local backpack = p:FindFirstChild("Backpack")
                local hasKnife = p.Character:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
                if hasKnife then return p end
            end
        end
    end
    return nil
end

local function AtualizarElementosFov()
    if not FovGui then return end
    for _, child in ipairs(FovGui:GetChildren()) do
        child:Destroy()
    end
    elementosVisualFov = {}
    local diametro = fovTamanhoRadius * 2
    local corAtual = fovRainbowAtivo and Color3.fromHSV(tick() % 5 / 5, 1, 1) or Color3.fromRGB(255, 255, 255)
    
    if fovEstiloAtual == "Simple" then
        local circle = Instance.new("Frame")
        circle.Name = "SimpleCircle"
        circle.AnchorPoint = Vector2.new(0.5, 0.5)
        circle.Position = UDim2.new(0.5, 0, 0.5, -GuiService:GetGuiInset().Y / 2)
        circle.Size = UDim2.new(0, diametro, 0, diametro)
        circle.BackgroundTransparency = 1
        circle.Parent = FovGui
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = circle
        
        local stroke = Instance.new("UIStroke")
        stroke.Color = corAtual
        stroke.Thickness = 2
        stroke.Transparency = 0.2
        stroke.Parent = circle
        AdicionarElementoCorFov(stroke, "Color")
        circleFrame = circle
        modOuterRing, modInnerRing, modOuterLinesHolder, modInnerLinesHolder = nil, nil, nil, nil
        
    elseif fovEstiloAtual == "Modified" then
        local container = Instance.new("Frame")
        container.Name = "ModContainer"
        container.AnchorPoint = Vector2.new(0.5, 0.5)
        container.Position = UDim2.new(0.5, 0, 0.5, -GuiService:GetGuiInset().Y / 2)
        container.Size = UDim2.new(0, diametro, 0, diametro)
        container.BackgroundTransparency = 1
        container.Parent = FovGui
        circleFrame = container
        
        -- Anel Externo
        local outer = Instance.new("Frame")
        outer.Size = UDim2.new(1, 0, 1, 0)
        outer.BackgroundTransparency = 1
        outer.AnchorPoint = Vector2.new(0.5, 0.5)
        outer.Position = UDim2.new(0.5, 0, 0.5, 0)
        outer.Parent = container
        
        local outCorner = Instance.new("UICorner")
        outCorner.CornerRadius = UDim.new(1, 0)
        outCorner.Parent = outer
        
        local outStroke = Instance.new("UIStroke")
        outStroke.Color = corAtual
        outStroke.Thickness = 2.5
        outStroke.Transparency = 0.1
        outStroke.Parent = outer
        AdicionarElementoCorFov(outStroke, "Color")
        modOuterRing = outer
        
        -- Linhas do Externo
        local outerLinesHolder = Instance.new("Frame")
        outerLinesHolder.Size = UDim2.new(1, 0, 1, 0)
        outerLinesHolder.BackgroundTransparency = 1
        outerLinesHolder.AnchorPoint = Vector2.new(0.5, 0.5)
        outerLinesHolder.Position = UDim2.new(0.5, 0, 0.5, 0)
        outerLinesHolder.Parent = container
        modOuterLinesHolder = outerLinesHolder
        
        for i = 1, 10 do
            local angle = (i / 10) * (math.pi * 2)
            local line = Instance.new("Frame")
            line.Size = UDim2.new(0, 10, 0, 2)
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.BackgroundColor3 = corAtual
            line.BorderSizePixel = 0
            line.Rotation = math.deg(angle)
            local radiusOffset = fovTamanhoRadius
            line.Position = UDim2.new(0.5, math.cos(angle) * radiusOffset, 0.5, math.sin(angle) * radiusOffset)
            line.Parent = outerLinesHolder
            AdicionarElementoCorFov(line, "BackgroundColor3")
        end
        
        -- Anel Interno
        local inner = Instance.new("Frame")
        inner.Size = UDim2.new(0.75, 0, 0.75, 0)
        inner.BackgroundTransparency = 1
        inner.AnchorPoint = Vector2.new(0.5, 0.5)
        inner.Position = UDim2.new(0.5, 0, 0.5, 0)
        inner.Parent = container
        
        local inCorner = Instance.new("UICorner")
        inCorner.CornerRadius = UDim.new(1, 0)
        inCorner.Parent = inner
        
        local inStroke = Instance.new("UIStroke")
        inStroke.Color = corAtual
        inStroke.Thickness = 1.5
        inStroke.Transparency = 0.3
        inStroke.Parent = inner
        AdicionarElementoCorFov(inStroke, "Color")
        modInnerRing = inner
        
        -- Linhas do Interno
        local innerLinesHolder = Instance.new("Frame")
        innerLinesHolder.Size = UDim2.new(1, 0, 1, 0)
        innerLinesHolder.BackgroundTransparency = 1
        innerLinesHolder.AnchorPoint = Vector2.new(0.5, 0.5)
        innerLinesHolder.Position = UDim2.new(0.5, 0, 0.5, 0)
        innerLinesHolder.Parent = container
        modInnerLinesHolder = innerLinesHolder
        
        for i = 1, 10 do
            local angle = (i / 10) * (math.pi * 2)
            local line = Instance.new("Frame")
            line.Size = UDim2.new(0, 8, 0, 2)
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.BackgroundColor3 = corAtual
            line.BorderSizePixel = 0
            line.Rotation = math.deg(angle)
            local radiusOffset = fovTamanhoRadius * 0.75
            line.Position = UDim2.new(0.5, math.cos(angle) * radiusOffset, 0.5, math.sin(angle) * radiusOffset)
            line.Parent = innerLinesHolder
            AdicionarElementoCorFov(line, "BackgroundColor3")
        end
    end
end

local function CriarFovGui()
    if FovGui then return end
    local ParentGui = CoreGui
    pcall(function() if not CoreGui then ParentGui = LocalPlayer:WaitForChild("PlayerGui") end end)
    FovGui = Instance.new("ScreenGui")
    FovGui.Name = "Sheriff_FovCircleGui"
    FovGui.ResetOnSpawn = false
    FovGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    FovGui.DisplayOrder = 999998
    FovGui.Enabled = fovMostrandoCirculo
    FovGui.Parent = ParentGui
    AtualizarElementosFov()
end

local function RemoverFovGui()
    if FovGui then
        FovGui:Destroy()
        FovGui = nil
        circleFrame = nil
    end
end

local function PlayerTemArmaFov()
    local Char = LocalPlayer.Character
    if not Char then return false end
    if Char:FindFirstChild("Gun") then return true end
    if LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun") then return true end
    return false
end

-- Loop de Renderização, Rotação com Velocidade Ajustável (0 a 10) e Mira
local anguloAtualGiro = 0
RunService.RenderStepped:Connect(function(dt)
    if fovRainbowAtivo and FovGui and FovGui.Enabled then
        local corFrameAtual = Color3.fromHSV((tick() % 4) / 4, 1, 1)
        for _, item in ipairs(elementosVisualFov) do
            if item.obj and item.obj.Parent then
                if item.tipo == "Color" then
                    item.obj.Color = corFrameAtual
                elseif item.tipo == "BackgroundColor3" then
                    item.obj.BackgroundColor3 = corFrameAtual
                end
            end
        end
    end
    
    -- Se a velocidade for maior que 0, gira; se for 0, fica parado
    if fovEstiloAtual == "Modified" and circleFrame and fovVelocidadeGiro > 0 then
        anguloAtualGiro = anguloAtualGiro + (fovVelocidadeGiro * dt * 25)
        if modInnerRing then modInnerRing.Rotation = anguloAtualGiro end
        if modInnerLinesHolder then modInnerLinesHolder.Rotation = anguloAtualGiro end
        if modOuterRing then modOuterRing.Rotation = -anguloAtualGiro end
        if modOuterLinesHolder then modOuterLinesHolder.Rotation = -anguloAtualGiro end
    end
    
    if not fovAtivo then return end
    if not PlayerTemArmaFov() then return end
    
    local Murderer = GetMurdererFov()
    if not Murderer or not Murderer.Character then return end
    local targetPart = Murderer.Character:FindFirstChild("HumanoidRootPart") or Murderer.Character:FindFirstChild("UpperTorso")
    if not targetPart then return end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
    if not onScreen then return end
    
    local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local targetPos2D = Vector2.new(screenPos.X, screenPos.Y)
    local distanciaDoCentro = (targetPos2D - centerScreen).Magnitude
    
    if distanciaDoCentro <= fovTamanhoRadius then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
    end
end)

-- =========================================================================
-- ⚡ SISTEMA COMPLETO: RAGE SHOOT FLUTUANTE
-- =========================================================================

local function TriggerRageShoot(TextoLabel)
    if RagePressed then return end

    local Char = Player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end

    local Gun = Char:FindFirstChild("Gun") or (Player:FindFirstChild("Backpack") and Player.Backpack:FindFirstChild("Gun"))
    
    -- Se não tiver a arma, avisa "Not Gun" em vermelho por 1 segundo
    if not Gun then
        if TextoLabel and currentRageBtnRef and currentRageStrokeRef then
            TextoLabel.Text = "Not Gun"
            currentRageBtnRef.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            currentRageStrokeRef.Color = Color3.fromRGB(255, 60, 60)
            
            task.delay(1, function()
                if TextoLabel and TextoLabel.Parent and currentRageBtnRef and currentRageStrokeRef then
                    TextoLabel.Text = "Rage Shoot"
                    currentRageBtnRef.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    currentRageStrokeRef.Color = Color3.fromRGB(39, 40, 48)
                end
            end)
        end
        return 
    end

    RagePressed = true

    -- Garante que a arma está equipada nas mãos
    if Gun.Parent ~= Char then
        Gun.Parent = Char
        task.wait(0.05)
    end

    local Murderer = GetMurderer() -- Usa a mesma função global que já criamos para achar o assassino
    if not Murderer or not Murderer.Character then 
        RagePressed = false 
        return 
    end

    local TargetHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    local TargetTorso = Murderer.Character:FindFirstChild("Torso") or Murderer.Character:FindFirstChild("UpperTorso")
    if not TargetHRP or not TargetTorso then 
        RagePressed = false 
        return 
    end

    -- Salva a posição original de onde o jogador estava antes de teleportar
    local PosicaoOriginal = Char.HumanoidRootPart.CFrame

    -- Calcula a posição exata atrás do assassino (cerca de 5 a 6 blocos de distância nas costas)
    local CFrameMurderer = TargetHRP.CFrame
    local PosicaoAtras = CFrameMurderer * CFrame.new(0, 0, 6) -- 6 studs atrás
    
    -- Teleporta o jogador para trás do assassino
    Char.HumanoidRootPart.CFrame = CFrame.new(PosicaoAtras.Position, TargetHRP.Position)
    task.wait(0.05) -- Pequeno respiro para o servidor registrar a posição

    -- Realiza o cálculo de predição do tiro igual ao Silent AIM
    local Ping = GetPing()
    local PredictionTime = (Ping / 1000) * (ShootPredictMultiplier or 1)
    local Velocity = TargetHRP.Velocity
    local PredictedPos = Velocity.Magnitude < 1 and TargetTorso.Position or TargetTorso.Position + (Velocity * PredictionTime)
    
    local MyPos = Char.HumanoidRootPart.Position
    local RayDirection = (PredictedPos - MyPos)
    
    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.FilterDescendantsInstances = {Char, Murderer.Character}
    RayParams.IgnoreWater = true

    local RayResult = workspace:Raycast(MyPos, RayDirection, RayParams)
    local OriginCFrame = RayResult and CFrame.new(RayResult.Position + (RayDirection.Unit * 1.5), PredictedPos) or CFrame.new(MyPos, PredictedPos)

    -- Dispara o evento da arma
    local ShootEvent = Gun:FindFirstChild("ShootEvent", true) or Gun:FindFirstChild("Shoot", true) or ReplicatedStorage:FindFirstChild("Shoot", true)
    if ShootEvent then
        if ShootEvent:IsA("RemoteEvent") then
            ShootEvent:FireServer(OriginCFrame, CFrame.new(PredictedPos))
        elseif ShootEvent:IsA("RemoteFunction") then
            ShootEvent:InvokeServer(OriginCFrame, CFrame.new(PredictedPos))
        end
    end

    if TextoLabel then TextoLabel.Text = "Raged!" end

    -- Retorna instantaneamente para a posição original onde estava
    task.wait(0.06)
    if Char and Char:FindFirstChild("HumanoidRootPart") then
        Char.HumanoidRootPart.CFrame = PosicaoOriginal
    end

    task.delay(1, function()
        if TextoLabel and TextoLabel.Parent then
            TextoLabel.Text = "Rage Shoot"
        end
        RagePressed = false
    end)
end

function CreateRageButton()
    if RageButtonGui then 
        RageButtonGui.Enabled = true
        return 
    end
    
    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "Sheriff_RageShootGui"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.IgnoreGuiInset = true
    GuiBtn.DisplayOrder = 999999 -- Fica por cima de absolutamente tudo na tela
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = PlayerGui
    
    local Btn = Instance.new("ImageButton")
    Btn.AnchorPoint = Vector2.new(0.5, 0.5)
    Btn.Position = UDim2.new(0.5, 0, 0.65, 0) -- Posição abaixo do Silent AIM para não sobrepor
    Btn.Size = UDim2.new(0, tamanhoRageBase, 0, tamanhoRageBase / 2.5)
    Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Btn.BackgroundTransparency = 0.4
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.Parent = GuiBtn
    
    currentRageBtnRef = Btn
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn
    currentRageCornerRef = Corner
    
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(39, 40, 48) -- Borda preta padrão
    Borda.Thickness = 1.5
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn
    currentRageStrokeRef = Borda
    
    local Texto = Instance.new("TextLabel")
    Texto.Name = "RageText"
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.Text = "Rage Shoot"
    Texto.TextColor3 = Color3.fromRGB(245, 245, 245)
    Texto.Font = Enum.Font.GothamBold
    Texto.TextSize = 14
    Texto.Parent = Btn
    
    -- Loop para deixar a bordinha verde caso tenha a arma equipada ou na mochila
    task.spawn(function()
        while RageButtonGui and RageButtonGui.Enabled and Btn and Texto and currentRageStrokeRef do
            if Texto.Text ~= "Not Gun" and Texto.Text ~= "Raged!" then
                local Char = Player.Character
                local temArma = Char and (Char:FindFirstChild("Gun") or (Player:FindFirstChild("Backpack") and Player.Backpack:FindFirstChild("Gun")))
                if temArma then
                    currentRageStrokeRef.Color = Color3.fromRGB(60, 220, 100) -- Verde se tiver arma
                else
                    currentRageStrokeRef.Color = Color3.fromRGB(39, 40, 48) -- Preto padrão se não tiver
                end
            end
            task.wait(0.4)
        end
    end)
    
    -- Lógica de Arrastar com Bloqueio de Multitoque (Evita saltos para outros dedos na tela)
    local dragStart, startPos, dragInputConn, dragEndedConn, activeInput = nil, nil, nil, nil, nil
    
    Btn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not activeInput then
            activeInput = input
            isDraggingRage = false
            dragStart = input.Position
            startPos = Btn.Position
            
            if dragInputConn then dragInputConn:Disconnect() end
            dragInputConn = game:GetService("UserInputService").InputChanged:Connect(function(moveInput)
                if moveInput == activeInput or (activeInput.UserInputType == Enum.UserInputType.MouseButton1 and moveInput.UserInputType == Enum.UserInputType.MouseMovement) then
                    local delta = moveInput.Position - dragStart
                    if delta.Magnitude > 5 then
                        isDraggingRage = true
                        Btn.Position = UDim2.new(
                            startPos.X.Scale, 
                            startPos.X.Offset + delta.X, 
                            startPos.Y.Scale, 
                            startPos.Y.Offset + delta.Y
                        )
                    end
                end
            end)
            
            if dragEndedConn then dragEndedConn:Disconnect() end
            dragEndedConn = game:GetService("UserInputService").InputEnded:Connect(function(endInput)
                if endInput == activeInput or (activeInput.UserInputType == Enum.UserInputType.MouseButton1 and endInput.UserInputType == Enum.UserInputType.MouseButton1) then
                    if not isDraggingRage then
                        TriggerRageShoot(Texto)
                    end
                    if dragInputConn then dragInputConn:Disconnect() dragInputConn = nil end
                    if dragEndedConn then dragEndedConn:Disconnect() dragEndedConn = nil end
                    isDraggingRage = false
                    activeInput = nil
                end
            end)
        end
    end)
    
    RageButtonGui = GuiBtn
end

local function RemoveRageButton()
    if RageButtonGui then
        RageButtonGui.Enabled = false
    end
end



 

