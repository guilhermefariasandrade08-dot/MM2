--==============================================================--
-- 09. ÁREA DE CONTEÚDO E PÁGINAS (DIREITA)
--==============================================================--

local Content = Create("Frame", {
    Name = "Content",
    Position = UDim2.fromOffset(155, 50),
    Size = UDim2.fromOffset(385, 310),
    BackgroundColor3 = C.Content,
    BorderSizePixel = 0,
    ClipsDescendants = true
}, Window)

Round(Content, 8)
Outline(Content, C.Border, 1)

local Pages = {}
local TabButtons = {}
local ActivePage

local function CreatePage(name)
    local page = Create("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        Visible = false
    }, Content)

    Create("UIPadding", {
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8)
    }, page)

    Create("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    Pages[name] = page
    return page
end

-- Criar as páginas
CreatePage("Informação")
CreatePage("Murderer")
CreatePage("Sheriff")
CreatePage("ESP")
CreatePage("Farm coin")
CreatePage("Jogador")
CreatePage("Teleporte")
CreatePage("Fling")

--==============================================================--
-- 10. SELECIONAR E CRIAR ABAS LATERAIS (PROTEGIDAS CONTRA TRADUÇÃO)
--==============================================================--

local function SelectPage(name)
    if not Pages[name] then
        return
    end

    ActivePage = name

    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for tabName, button in pairs(TabButtons) do
        local selected = tabName == name

        Tween(button, {
            BackgroundColor3 = selected and C.Hover or C.Black,
            TextColor3 = selected and C.White or C.Gray
        })
    end
end

local function CreateTab(name, order)
    local protectedName = "\226\128\139" .. name

    local button = Create("TextButton", {
        Name = name .. "Tab",
        Size = UDim2.fromOffset(135, 32),
        BackgroundColor3 = C.Black,
        BorderSizePixel = 0,
        Text = protectedName,
        TextSize = 12,
        TextColor3 = C.Gray,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        LayoutOrder = order
    }, TabBar)

    Round(button, 6)
    Outline(button, C.Border, 1)

    button.MouseEnter:Connect(function()
        if ActivePage ~= name then
            Tween(button, { BackgroundColor3 = C.Hover })
        end
    end)

    button.MouseLeave:Connect(function()
        if ActivePage ~= name then
            Tween(button, { BackgroundColor3 = C.Black })
        end
    end)

    button.Activated:Connect(function()
        SelectPage(name)
    end)

    TabButtons[name] = button
end

CreateTab("Informação", 1)
CreateTab("Murderer", 2)
CreateTab("Sheriff", 3)
CreateTab("ESP", 4)
CreateTab("Farm coin", 5)
CreateTab("Jogador", 6)
CreateTab("Teleporte", 7)
CreateTab("Fling", 8)

--==============================================================--
-- 11. SISTEMA DE BOTÕES
--==============================================================--

local function CreateButton(pageName, text, callback)
    local page = Pages[pageName]
    if not page then return end

    local button = Create("TextButton", {
        Name = "Button_" .. text,
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = C.White,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(button, 7)
    Outline(button, C.Border, 1)

    button.MouseEnter:Connect(function()
        Tween(button, { BackgroundColor3 = C.Hover })
    end)

    button.MouseLeave:Connect(function()
        Tween(button, { BackgroundColor3 = C.Element })
    end)

    button.Activated:Connect(function()
        if callback then
            callback()
        end
    end)

    return button
end

--==============================================================--
-- 12. SISTEMA DE TOGGLES
--==============================================================--

local function CreateToggle(pageName, text, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    local state = defaultValue == true

    local row = Create("Frame", {
        Name = "Toggle_" .. text,
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    Label(
        row,
        text,
        11,
        UDim2.fromOffset(10, 0),
        UDim2.new(1, -60, 1, 0)
    )

    local track = Create("Frame", {
        Size = UDim2.fromOffset(36, 20),
        Position = UDim2.new(1, -45, 0.5, -10),
        BackgroundColor3 = state and C.Blue or Color3.fromRGB(48, 48, 48),
        BorderSizePixel = 0
    }, row)

    Round(track, 20)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = state
            and UDim2.new(1, -17, 0.5, -7)
            or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0
    }, track)

    Round(knob, 20)

    local hitbox = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, row)

    local function SetState(value, fireCallback)
        state = value == true

        Tween(track, {
            BackgroundColor3 = state and C.Blue or Color3.fromRGB(48, 48, 48)
        })

        Tween(knob, {
            Position = state
                and UDim2.new(1, -17, 0.5, -7)
                or UDim2.new(0, 3, 0.5, -7)
        })

        if fireCallback and callback then
            callback(state)
        end
    end

    hitbox.Activated:Connect(function()
        SetState(not state, true)
    end)

    return {
        Get = function()
            return state
        end,

        Set = function(value)
            SetState(value, true)
        end
    }
end

--==============================================================--
-- 13. SISTEMA DE SLIDERS
--==============================================================--

local function CreateSlider(pageName, text, minValue, maxValue, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    minValue = tonumber(minValue) or 0
    maxValue = tonumber(maxValue) or 100

    if maxValue < minValue then
        minValue, maxValue = maxValue, minValue
    end

    local value = math.clamp(
        tonumber(defaultValue) or minValue,
        minValue,
        maxValue
    )

    local row = Create("Frame", {
        Name = "Slider_" .. text,
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    Label(
        row,
        text,
        11,
        UDim2.fromOffset(10, 2),
        UDim2.new(1, -65, 0, 23)
    )

    local valueLabel = Label(
        row,
        tostring(value),
        11,
        UDim2.new(1, -50, 0, 2),
        UDim2.fromOffset(40, 23)
    )

    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Create("Frame", {
        Position = UDim2.new(0, 10, 0, 39),
        Size = UDim2.new(1, -20, 0, 5),
        BackgroundColor3 = Color3.fromRGB(48, 48, 48),
        BorderSizePixel = 0
    }, row)

    Round(track, 10)

    local fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = C.Blue,
        BorderSizePixel = 0
    }, track)

    Round(fill, 10)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(13, 13),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0,
        ZIndex = 2
    }, track)

    Round(knob, 20)

    local dragging = false

    local function SetValue(newValue, fireCallback)
        value = math.clamp(
            math.floor((tonumber(newValue) or minValue) + 0.5),
            minValue,
            maxValue
        )

        local ratio = maxValue == minValue and 0
            or (value - minValue) / (maxValue - minValue)

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        if fireCallback and callback then
            callback(value)
        end
    end

    local function UpdateFromInput(input)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local ratio = math.clamp(
            (input.Position.X - track.AbsolutePosition.X) / width,
            0,
            1
        )

        SetValue(minValue + (maxValue - minValue) * ratio, true)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromInput(input)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromInput(input)
        end
    end)

    local moveConnection = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            UpdateFromInput(input)
        end
    end)

    local endConnection = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    row.Destroying:Connect(function()
        moveConnection:Disconnect()
        endConnection:Disconnect()
    end)

    SetValue(value, false)

    return {
        Get = function()
            return value
        end,

        Set = function(newValue)
            SetValue(newValue, true)
        end
    }
end

--==============================================================--
-- 14. SISTEMA DE DROPDOWNS
--==============================================================--

local function CreateDropdown(pageName, text, options, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    options = options or {}
    local selected = defaultValue or options[1]
    local expanded = false

    local row = Create("Frame", {
        Name = "Dropdown_" .. text,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    local header = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, row)

    Label(
        header,
        text,
        11,
        UDim2.fromOffset(10, 0),
        UDim2.new(0.52, -10, 1, 0)
    )

    local selectedLabel = Label(
        header,
        selected and tostring(selected) or "Selecionar",
        10,
        UDim2.new(0.52, 0, 0, 0),
        UDim2.new(0.48, -30, 1, 0)
    )

    selectedLabel.TextColor3 = selected and C.White or C.Gray
    selectedLabel.TextXAlignment = Enum.TextXAlignment.Right

    local arrow = Label(
        header,
        "⌄",
        15,
        UDim2.new(1, -27, 0, 0),
        UDim2.fromOffset(18, 35)
    )

    arrow.TextXAlignment = Enum.TextXAlignment.Center

    local optionButtons = {}

    local function SetExpanded(open)
        expanded = open

        row.Size = UDim2.new(
            1, 0,
            0, expanded and (38 + #options * 28) or 36
        )

        arrow.Text = expanded and "⌃" or "⌄"

        for _, button in ipairs(optionButtons) do
            button.Visible = expanded
        end
    end

    for index, option in ipairs(options) do
        local optionButton = Create("TextButton", {
            Name = "Option" .. index,
            Position = UDim2.new(0, 6, 0, 38 + (index - 1) * 28),
            Size = UDim2.new(1, -12, 0, 26),
            BackgroundColor3 = C.Content,
            BorderSizePixel = 0,
            Text = tostring(option),
            TextColor3 = C.White,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false,
            Visible = false
        }, row)

        Round(optionButton, 5)

        optionButton.Activated:Connect(function()
            selected = option
            selectedLabel.Text = tostring(option)
            selectedLabel.TextColor3 = C.White
            SetExpanded(false)

            if callback then
                callback(option)
            end
        end)

        table.insert(optionButtons, optionButton)
    end

    header.Activated:Connect(function()
        SetExpanded(not expanded)
    end)

    if selected and callback then
        task.spawn(function()
            callback(selected)
        end)
    end

    return {
        Get = function()
            return selected
        end,

        Set = function(option)
            for _, available in ipairs(options) do
                if available == option then
                    selected = option
                    selectedLabel.Text = tostring(option)
                    selectedLabel.TextColor3 = C.White

                    if callback then
                        callback(option)
                    end

                    return true
                end
            end

            return false
        end
    }
end

--==============================================================--
-- 15. SISTEMA DE TECLAS DE ATALHO (KEYBINDS)
--==============================================================--

local Keybinds = {}
local KeyCapture = nil

local function IsAllowedKey(keyCode)
    return keyCode
        and keyCode.EnumType == Enum.KeyCode
        and keyCode.Name:match("^[A-Z]$") ~= nil
end

local function CreateKeybind(pageName, text, defaultKey, callback)
    local page = Pages[pageName]
    if not page then return end

    local assignedKey

    if type(defaultKey) == "string" and #defaultKey == 1 then
        local candidate = Enum.KeyCode[string.upper(defaultKey)]

        if IsAllowedKey(candidate) then
            assignedKey = candidate
        end
    elseif typeof(defaultKey) == "EnumItem" and IsAllowedKey(defaultKey) then
        assignedKey = defaultKey
    end

    local row = Create("Frame", {
        Name = "Keybind_" .. text,
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    Label(
        row,
        text,
        11,
        UDim2.fromOffset(10, 0),
        UDim2.new(1, -85, 1, 0)
    )

    local keyButton = Create("TextButton", {
        Name = "KeyButton",
        Size = UDim2.fromOffset(49, 26),
        Position = UDim2.new(1, -57, 0.5, -13),
        BackgroundColor3 = C.Content,
        BorderSizePixel = 0,
        Text = assignedKey and assignedKey.Name or "...",
        TextColor3 = C.White,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false
    }, row)

    Round(keyButton, 6)
    Outline(keyButton, C.Border, 1)

    local mobilePanel = Create("Frame", {
        Name = "MobileKeyPicker",
        Size = UDim2.fromOffset(240, 190),
        Position = UDim2.new(0.5, -120, 0.5, -95),
        BackgroundColor3 = C.Black,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 30
    }, GUI)

    Round(mobilePanel, 9)
    Outline(mobilePanel, C.White, 1)

    local pickerTitle = Label(
        mobilePanel,
        "Escolher tecla",
        12,
        UDim2.fromOffset(10, 5),
        UDim2.new(1, -20, 0, 25)
    )
    pickerTitle.ZIndex = 31

    local letterGrid = Create("Frame", {
        Position = UDim2.fromOffset(8, 35),
        Size = UDim2.new(1, -16, 1, -43),
        BackgroundTransparency = 1,
        ZIndex = 31
    }, mobilePanel)

    Create("UIGridLayout", {
        CellSize = UDim2.fromOffset(29, 27),
        CellPadding = UDim2.fromOffset(3, 3),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, letterGrid)

    local function AssignKey(keyCode)
        assignedKey = keyCode
        keyButton.Text = keyCode.Name
        keyButton.BackgroundColor3 = C.Content

        if KeyCapture and KeyCapture.Button == keyButton then
            KeyCapture = nil
        end

        mobilePanel.Visible = false
    end

    for letterCode = string.byte("A"), string.byte("Z") do
        local letter = string.char(letterCode)

        local letterButton = Create("TextButton", {
            Name = "Key_" .. letter,
            BackgroundColor3 = C.Element,
            BorderSizePixel = 0,
            Text = letter,
            TextColor3 = C.White,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false,
            LayoutOrder = letterCode - string.byte("A") + 1,
            ZIndex = 32
        }, letterGrid)

        Round(letterButton, 5)

        letterButton.Activated:Connect(function()
            if KeyCapture and KeyCapture.Button == keyButton then
                KeyCapture.Assign(Enum.KeyCode[letter])
            end
        end)
    end

    keyButton.Activated:Connect(function()
        KeyCapture = {
            Button = keyButton,
            Assign = AssignKey
        }

        keyButton.Text = "..."

        if UserInputService.TouchEnabled then
            mobilePanel.Visible = true
        else
            keyButton.Text = "Pressione..."
        end

        Tween(keyButton, {
            BackgroundColor3 = C.Blue
        })
    end)

    table.insert(Keybinds, {
        GetKey = function()
            return assignedKey
        end,

        GetCallback = function()
            return callback
        end,

        Row = row
    })

    return {
        Get = function()
            return assignedKey
        end,

        Set = function(key)
            local candidate

            if type(key) == "string" and #key == 1 then
                candidate = Enum.KeyCode[string.upper(key)]
            elseif typeof(key) == "EnumItem" then
                candidate = key
            end

            if IsAllowedKey(candidate) then
                AssignKey(candidate)
                return true
            end

            return false
        end
    }
end

UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if KeyCapture then
        if IsAllowedKey(input.KeyCode) then
            local capture = KeyCapture
            capture.Assign(input.KeyCode)
        end

        return
    end

    if processed then return end

    for _, bind in ipairs(Keybinds) do
        if bind.Row.Parent
            and bind.GetKey()
            and input.KeyCode == bind.GetKey() then

            local callback = bind.GetCallback()

            if callback then
                callback(input.KeyCode)
            end
        end
    end
end)

--==============================================================--
-- SISTEMA DE TÍTULOS / SEÇÃO CENTRALIZADA
--==============================================================--

local function CreateSection(pageName, text)
    local page = Pages[pageName]
    if not page then return end

    local row = Create("Frame", {
        Name = "Section_" .. text,
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    local sectionLabel = Label(
        row,
        text,
        11,
        UDim2.new(0, 0, 0, 0),
        UDim2.new(1, 0, 1, 0)
    )

    sectionLabel.TextXAlignment = Enum.TextXAlignment.Center
    sectionLabel.TextColor3 = C.Gray -- Ou C.Blue se quiser que se destaque mais
    sectionLabel.Font = Enum.Font.GothamBold

    return row
end

--==============================================================--
-- 16. ABA ESP — CONTROLES E SISTEMA DE TRACERS
--==============================================================--

local ESPConfig = {
    Active = false,
    TargetType = "No my highlight", -- "My highlight" ou "No my highlight"
    Mode = "Highlight",            -- "Highlight" ou "Outline"
    Transparency = 0.5              -- De 0 a 1 (padrão 0.5)
}

CreateSection("ESP", "-- // ===== Highlight ===== \\ --")

-- 1. Dropdown para aplicar no próprio jogador ou não
CreateDropdown("ESP", "Aplicar em Mim", {"No my highlight", "My highlight"}, "No my highlight", function(option)
    ESPConfig.TargetType = option
end)

-- 2. Dropdown para escolher o modo visual (Highlight preenchido ou apenas Outline)
CreateDropdown("ESP", "Estilo do ESP", {"Highlight", "Outline"}, "Highlight", function(option)
    ESPConfig.Mode = option
end)

-- 3. Toggle para Ligar/Desligar o ESP
CreateToggle("ESP", "Ativar ESP Highlight", false, function(state)
    ESPConfig.Active = state
end)

-- 4. Slider de Transparência (0% a 100%)
CreateSlider("ESP", "Transparência ESP (%)", 0, 100, 50, function(value)
    ESPConfig.Transparency = value / 100
end)


--==============================================================--
-- SISTEMA DE CARGOS COMPARTILHADO (MM2 + LOBBY)
--==============================================================--

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DadosCargos = {}
local UltimaChecagemCargo = 0

local function PegarCargos()
    if tick() - UltimaChecagemCargo < 2 then return end
    UltimaChecagemCargo = tick()
    
    task.spawn(function()
        local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if not R then return end
        
        local ok, d = pcall(function() 
            return R:InvokeServer() 
        end)
        
        if ok and d then 
            DadosCargos = d 
        end
    end)
end

local function ObterCorCargo(nomeJogador)
    local Info = DadosCargos[nomeJogador]
    local Cor = Color3.fromRGB(255, 255, 255) -- Cor Branca padrão (Lobby / Sem cargo ativo)
    
    if Info and not Info.Killed and not Info.Dead then
        if Info.Role == "Murderer" then
            Cor = Color3.fromRGB(220, 50, 50) -- Vermelho
        elseif Info.Role == "Sheriff" then
            Cor = Color3.fromRGB(0, 85, 255) -- Azul
        elseif Info.Role == "Hero" then
            Cor = Color3.fromRGB(255, 215, 0) -- Dourado
        elseif Info.Role == "Innocent" then
            Cor = Color3.fromRGB(60, 200, 80) -- Verde
        end
    end
    
    return Cor
end

--==============================================================--
-- SISTEMA DE ESP HIGHLIGHT
--==============================================================--

local Highlights = {}

local function LimparEsp()
    for _, highlight in pairs(Highlights) do
        if highlight then 
            highlight:Destroy() 
        end
    end
    table.clear(Highlights)
end

RunService.RenderStepped:Connect(function()
    if not ESPConfig.Active then
        LimparEsp()
        return
    end

    PegarCargos()

    for _, p in ipairs(Players:GetPlayers()) do
        -- Se "No my highlight" estiver ativo, ignora o próprio jogador
        if ESPConfig.TargetType == "No my highlight" and p == Player then
            if Highlights[p] then
                Highlights[p]:Destroy()
                Highlights[p] = nil
            end
            continue
        end

        if p.Character then
            local highlight = Highlights[p]
            local cor = ObterCorCargo(p.Name)

            if not highlight or highlight.Parent ~= p.Character then
                if highlight then 
                    highlight:Destroy() 
                end

                local newHighlight = Instance.new("Highlight")
                newHighlight.Name = "WalkNyx_ESP"
                newHighlight.Adornee = p.Character
                newHighlight.FillColor = cor
                newHighlight.OutlineColor = cor
                newHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

                if ESPConfig.Mode == "Highlight" then
                    newHighlight.FillTransparency = ESPConfig.Transparency
                    newHighlight.OutlineTransparency = 0
                else
                    newHighlight.FillTransparency = 1
                    newHighlight.OutlineTransparency = ESPConfig.Transparency
                end

                newHighlight.Parent = p.Character
                Highlights[p] = newHighlight
            else
                highlight.FillColor = cor
                highlight.OutlineColor = cor

                if ESPConfig.Mode == "Highlight" then
                    highlight.FillTransparency = ESPConfig.Transparency
                    highlight.OutlineTransparency = 0
                else
                    highlight.FillTransparency = 1
                    highlight.OutlineTransparency = ESPConfig.Transparency
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if Highlights[p] then
        Highlights[p]:Destroy()
        Highlights[p] = nil
    end
end)




-- Título da Seção Linhas (Tracers)
CreateSection("ESP", "-- // ===== Tracers ===== \\ --")

-- Dropdown com a origem da linha em inglês
CreateDropdown("ESP", "Origem da Linha", {"Top", "Center", "Bottom"}, "Center", function(option)
    OrigemTracer = option
end)

-- Toggle para ativar/desativar as linhas
CreateToggle("ESP", "Ativar Tracers", false, function(state)
    TracerAtivo = state
end)

-- Slider para controlar a espessura da linha (1 a 10)
CreateSlider("ESP", "Espessura da Linha", 1, 10, 1, function(value)
    GrossuraTracer = value
end)

--==============================================================--
-- SISTEMA DE TRACERS (COM COR POR CARGO E SUPORTE A 600M)
--==============================================================--

local TracerAtivo = false
local OrigemTracer = "Center"
local GrossuraTracer = 1

local TracersCache = {}

local function CriarTracer(player)
    if player == Player then return end

    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = Color3.fromRGB(255, 255, 255)
    line.Thickness = GrossuraTracer or 1
    line.Transparency = 1

    TracersCache[player] = line
end

for _, p in ipairs(Players:GetPlayers()) do
    CriarTracer(p)
end

Players.PlayerAdded:Connect(CriarTracer)

Players.PlayerRemoving:Connect(function(player)
    if TracersCache[player] then
        TracersCache[player]:Remove()
        TracersCache[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    local meuPersonagem = Player.Character
    local meuRoot = meuPersonagem and meuPersonagem:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        local line = TracersCache[player]

        if line then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")

            if TracerAtivo and meuRoot and character and humanoid and rootPart and humanoid.Health > 0 then
                -- Oculta caso a opção "No my highlight/No ESP my player" esteja ativa para o próprio jogador
                if ESPConfig.TargetType == "No my highlight" and player == Player then
                    line.Visible = false
                    continue
                end

                local distancia = (meuRoot.Position - rootPart.Position).Magnitude

                if distancia <= DistanciaMaximaESP then
                    local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

                    if onScreen then
                        local viewportSize = Camera.ViewportSize
                        local originPoint

                        -- Ajusta o ponto de origem em inglês ("Top", "Center", "Bottom")
                        if OrigemTracer == "Top" then
                            originPoint = Vector2.new(viewportSize.X / 2, 0)
                        elseif OrigemTracer == "Bottom" then
                            originPoint = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                        else -- "Center"
                            originPoint = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                        end

                        -- Puxa a cor do cargo em tempo real (Murderer, Sheriff, Hero, Innocent, Lobby)
                        line.Color = ObterCorCargo(player.Name)
                        line.Thickness = GrossuraTracer or 1
                        line.From = originPoint
                        line.To = Vector2.new(vector.X, vector.Y)
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    end
end)

