-- ==============================================================--
-- SISTEMA DE LÓGICA DO INVISÍVEL E BOTÃO FLUTUANTE BLINDADO
-- ==============================================================--

local function AtualizarVisualBotaoFlutuante()
    if not InvisivelFloatBtn then return end
    
    -- Cores e transparências exatas (Preto/Cinza semi-transparente <-> Verde semi-transparente)
    local targetBg = InvisivelAtivo and Color3.fromRGB(40, 200, 80) or Color3.fromRGB(11, 12, 16)
    local targetStroke = InvisivelAtivo and Color3.fromRGB(60, 220, 100) or Color3.fromRGB(39, 40, 48)

    Tween(InvisivelFloatBtn, { 
        BackgroundColor3 = targetBg, 
        BackgroundTransparency = 0.3 
    }, 0.2)
    
    if InvisivelStroke then
        Tween(InvisivelStroke, { Color = targetStroke }, 0.2)
    end
end

function CreateInvisivelButton()
    if InvisivelButtonGui then return end

    InvisivelButtonGui = Create("ScreenGui", {
        Name = "WalkNyx_InvisivelGui",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Enabled = false
    }, PlayerGui)

    InvisivelFloatBtn = Create("TextButton", {
        Name = "InvisivelFloatBtn",
        Size = UDim2.fromOffset(110, 40),
        Position = UltimaPosicaoBotao,
        BackgroundColor3 = Color3.fromRGB(11, 12, 16),
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Text = "Invisível",
        TextColor3 = Color3.fromRGB(245, 245, 245),
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Active = true,
        ZIndex = 10
    }, InvisivelButtonGui)

    Round(InvisivelFloatBtn, 8)
    InvisivelStroke = Outline(InvisivelFloatBtn, Color3.fromRGB(39, 40, 48), 1.5)

    -- Sistema de arrastar e toque 100% isolado (Imede que pule para o dedo do joystick)
    local activeTouch = nil
    local dragStart = nil
    local startPos = nil
    local movedDistance = 0

    InvisivelFloatBtn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeTouch then
            activeTouch = input
            dragStart = input.Position
            startPos = InvisivelFloatBtn.Position
            movedDistance = 0
            
            local connection
            connection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    if input == activeTouch then
                        -- Se o dedo levantou e moveu muito pouco, é um CLIQUE limpo
                        if movedDistance < 8 then
                            InvisivelAtivo = not InvisivelAtivo
                            AtualizarVisualBotaoFlutuante()
                        end
                        activeTouch = nil
                        if connection then connection:Disconnect() end
                    end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == activeTouch then
            local delta = input.Position - dragStart
            movedDistance = math.abs(delta.X) + math.abs(delta.Y)
            
            -- Só começa a arrastar se o dedo realmente se mover mais de 6 pixels
            if movedDistance > 6 then
                InvisivelFloatBtn.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
                UltimaPosicaoBotao = InvisivelFloatBtn.Position
            end
        end
    end)

    AtualizarVisualBotaoFlutuante()
end

local function ConfigurarPersonagem()
    Personagem = Player.Character or Player.CharacterAdded:Wait()
    Humanoid = Personagem:WaitForChild("Humanoid")
    Raiz = Personagem:WaitForChild("HumanoidRootPart")
    
    PartesCorpo = {}
    for _, obj in ipairs(Personagem:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(PartesCorpo, obj)
        end
    end
end

Player.CharacterAdded:Connect(function(novoChar)
    task.wait(0.5)
    ConfigurarPersonagem()
end)

RunService.Heartbeat:Connect(function()
    if not InvisivelAtivo then return end
    
    if not Personagem or not Personagem.Parent or not Raiz or not Humanoid or Humanoid.Health <= 0 then
        ConfigurarPersonagem()
        return
    end

    for _, parte in ipairs(PartesCorpo) do
        if parte and parte.Parent then
            if parte.Name == "HumanoidRootPart" then
                parte.Transparency = 1
            else
                parte.Transparency = 0.5
            end
        end
    end

    local PosOriginal = Raiz.CFrame
    local CamOffset = Humanoid.CameraOffset
    
    Raiz.CFrame = PosOriginal * CFrame.new(0, -200000, 0)
    Humanoid.CameraOffset = Raiz.CFrame:ToObjectSpace(CFrame.new(PosOriginal.Position)).Position
    
    RunService.RenderStepped:Wait()
    
    if Raiz and Raiz.Parent then
        Raiz.CFrame = PosOriginal
        Humanoid.CameraOffset = CamOffset
    end
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if not InvisivelAtivo and Personagem and Humanoid and Humanoid.Health > 0 then
            for _, parte in ipairs(PartesCorpo) do
                if parte and parte.Parent and parte.Name ~= "HumanoidRootPart" then
                    parte.Transparency = 0
                end
            end
        end
    end
end)

if Player.Character then
    ConfigurarPersonagem()
end

