--==============================================================--
--                  SCRIPT AIMBOT INTERFACE                     --
--                INTERFACE VISUAL COM SCROLL                   --
--==============================================================--

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==============================================================--
-- CONFIGURAÇÕES GERAIS
--==============================================================--

local WINDOW_WIDTH = 375
local WINDOW_HEIGHT = 325

local BLACK = Color3.fromRGB(5, 5, 5)
local DARK = Color3.fromRGB(12, 12, 12)
local CONTENT_COLOR = Color3.fromRGB(16, 16, 16)
local WHITE = Color3.fromRGB(245, 245, 245)
local GRAY = Color3.fromRGB(145, 145, 145)
local BORDER = Color3.fromRGB(45, 45, 45)

--==============================================================--
-- SCREEN GUI
--==============================================================--

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ScriptAimbotInterface"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

--==============================================================--
-- FUNÇÕES VISUAIS
--==============================================================--

local function addCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = object
    return corner
end

local function addStroke(object, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness
    stroke.Parent = object
    return stroke
end

local function createText(parent, text, size, position, dimensions)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = WHITE
    label.Font = Enum.Font.Gotham
    label.TextSize = size
    label.Position = position
    label.Size = dimensions
    label.Parent = parent
    return label
end

--==============================================================--
-- JANELA PRINCIPAL
--==============================================================--

local window = Instance.new("Frame")
window.Name = "MainWindow"
window.Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT)
window.Position = UDim2.new(
    0.5, -WINDOW_WIDTH / 2,
    0.5, -WINDOW_HEIGHT / 2
)
window.BackgroundColor3 = BLACK
window.BorderSizePixel = 0
window.Visible = false
window.Active = true
window.ClipsDescendants = true
window.Parent = screenGui

addCorner(window, 12)
addStroke(window, BORDER, 1)

--==============================================================--
-- CABEÇALHO
--==============================================================--

local header = Instance.new("Frame")
header.Name = "Header"
header.Size = UDim2.new(1, 0, 0, 48)
header.BackgroundColor3 = BLACK
header.BorderSizePixel = 0
header.Active = true
header.Parent = window

addCorner(header, 12)

local headerCover = Instance.new("Frame")
headerCover.Size = UDim2.new(1, 0, 0, 12)
headerCover.Position = UDim2.new(0, 0, 1, -12)
headerCover.BackgroundColor3 = BLACK
headerCover.BorderSizePixel = 0
headerCover.Parent = header

local title = createText(
    header,
    "Script Aimbot Roblox",
    16,
    UDim2.fromOffset(12, 0),
    UDim2.new(1, -60, 1, 0)
)

title.TextXAlignment = Enum.TextXAlignment.Left
title.Font = Enum.Font.GothamMedium

local closeButton = Instance.new("TextButton")
closeButton.Name = "CloseButton"
closeButton.Size = UDim2.fromOffset(28, 28)
closeButton.Position = UDim2.new(1, -36, 0, 10)
closeButton.BackgroundColor3 = DARK
closeButton.Text = "×"
closeButton.TextColor3 = WHITE
closeButton.TextSize = 23
closeButton.Font = Enum.Font.Gotham
closeButton.BorderSizePixel = 0
closeButton.Parent = header

addCorner(closeButton, 7)
addStroke(closeButton, BORDER, 1)

--==============================================================--
-- BARRA DE ABAS NO TOPO
--==============================================================--

local tabBar = Instance.new("Frame")
tabBar.Name = "TabBar"
tabBar.Position = UDim2.fromOffset(8, 55)
tabBar.Size = UDim2.new(1, -16, 0, 40)
tabBar.BackgroundTransparency = 1
tabBar.BorderSizePixel = 0
tabBar.Parent = window

local tabList = Instance.new("UIListLayout")
tabList.FillDirection = Enum.FillDirection.Horizontal
tabList.HorizontalAlignment = Enum.HorizontalAlignment.Left
tabList.VerticalAlignment = Enum.VerticalAlignment.Center
tabList.SortOrder = Enum.SortOrder.LayoutOrder
tabList.Padding = UDim.new(0, 6)
tabList.Parent = tabBar

--==============================================================--
-- ÁREA DE CONTEÚDO
--==============================================================--

local content = Instance.new("Frame")
content.Name = "Content"
content.Position = UDim2.fromOffset(8, 102)
content.Size = UDim2.new(1, -16, 1, -110)
content.BackgroundColor3 = CONTENT_COLOR
content.BorderSizePixel = 0
content.ClipsDescendants = true
content.Parent = window

addCorner(content, 9)

--==============================================================--
-- CRIAR PÁGINAS COM SCROLL AUTOMÁTICO
--==============================================================--

local pages = {}
local tabButtons = {}

local function createPage(name)
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name = name .. "Page"
    scroll.Size = UDim2.fromScale(1, 1)
    scroll.Position = UDim2.fromOffset(0, 0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 0
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Active = true
    scroll.Visible = false
    scroll.Parent = content

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 10)
    padding.PaddingBottom = UDim.new(0, 10)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)
    padding.Parent = scroll

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = scroll

    pages[name] = scroll

    return scroll
end

createPage("Main")
createPage("ESP")
createPage("Player")

--==============================================================--
-- CRIAR BOTÕES DAS ABAS
--==============================================================--

local function createTab(name, order)
    local button = Instance.new("TextButton")
    button.Name = name .. "Tab"
    button.Size = UDim2.new(0, 112, 0, 36)
    button.BackgroundColor3 = DARK
    button.BorderSizePixel = 0
    button.Text = name
    button.TextColor3 = GRAY
    button.TextSize = 15
    button.Font = Enum.Font.GothamMedium
    button.LayoutOrder = order
    button.AutoButtonColor = false
    button.Parent = tabBar

    addCorner(button, 7)

    tabButtons[name] = button

    return button
end

createTab("Main", 1)
createTab("ESP", 2)
createTab("Player", 3)

--==============================================================--
-- TROCAR DE ABA
--==============================================================--

local function selectTab(name)
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end

    for tabName, button in pairs(tabButtons) do
        local selected = tabName == name

        TweenService:Create(
            button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = selected
                    and Color3.fromRGB(30, 30, 30)
                    or DARK,

                TextColor3 = selected and WHITE or GRAY
            }
        ):Play()
    end
end

for name, button in pairs(tabButtons) do
    button.Activated:Connect(function()
        selectTab(name)
    end)
end

selectTab("Main")

--==============================================================--
-- FUNÇÃO PARA CRIAR BOTÕES NAS PÁGINAS
--==============================================================--

local function addPageButton(pageName, buttonText, callback)
    local page = pages[pageName]

    if not page then
        warn("Aba não encontrada: " .. tostring(pageName))
        return nil
    end

    local button = Instance.new("TextButton")
    button.Name = "OptionButton"
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = DARK
    button.BorderSizePixel = 0
    button.Text = buttonText
    button.TextColor3 = WHITE
    button.TextSize = 14
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.AutoButtonColor = true
    button.Parent = page

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 12)
    padding.Parent = button

    addCorner(button, 7)
    addStroke(button, BORDER, 1)

    if callback then
        button.Activated:Connect(callback)
    end

    return button
end

--==============================================================--
--                 ABA MAIN — SEUS ELEMENTOS                   --
--==============================================================--

local mainPage = pages.Main

-- >>> INÍCIO DO CONTEÚDO DA ABA MAIN <<<

addPageButton("Main", "Opção Main")
addPageButton("Main", "Outra opção")

-- >>> FIM DO CONTEÚDO DA ABA MAIN <<<


