CreatePage("Murderer")
CreatePage("Sheriff")
CreatePage("ESP")
CreatePage("Farm coin")
CreatePage("Jogador")
CreatePage("Teleporte")
CreatePage("Fling")

--==============================================================--
-- 10. SELECIONAR E CRIAR ABAS LATERAIS
--==============================================================--

local function SelectPage(name)
    if not Pages[name] then
        return
    end

    ActivePage = name

    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for tabName, button in pairs(TabButtons) do
        local selected = tabName == name

        Tween(button, {
            BackgroundColor3 = selected and C.Hover or C.Black,
            TextColor3 = selected and C.White or C.Gray
        })
    end
end

local function CreateTab(name, order)
    local protectedName = "\226\128\139" .. name

    local button = Create("TextButton", {
        Name = name .. "Tab",
        Size = UDim2.fromOffset(135, 32),
        BackgroundColor3 = C.Black,
        BorderSizePixel = 0,
        Text = protectedName,
        TextSize = 12,
        TextColor3 = C.Gray,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        LayoutOrder = order
    }, TabBar)

    Round(button, 6)
    Outline(button, C.Border, 1)

    button.MouseEnter:Connect(function()
        if ActivePage ~= name then
            Tween(button, { BackgroundColor3 = C.Hover })
        end
    end)

    button.MouseLeave:Connect(function()
        if ActivePage ~= name then
            Tween(button, { BackgroundColor3 = C.Black })
        end
    end)

    button.Activated:Connect(function()
        SelectPage(name)
    end)

    TabButtons[name] = button
end

CreateTab("Informação", 1)
CreateTab("Murderer", 2)
CreateTab("Sheriff", 3)
CreateTab("ESP", 4)
CreateTab("Farm coin", 5)
CreateTab("Jogador", 6)
CreateTab("Teleporte", 7)
CreateTab("Fling", 8)

--==============================================================--
-- 11. SISTEMA DE ELEMENTOS DA UI
--==============================================================--

local function CreateSection(pageName, text)
    local page = Pages[pageName]
    if not page then return end

    local row = Create("Frame", {
        Name = "Section_" .. text,
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    local sectionLabel = Label(
        row,
        text,
        11,
        UDim2.new(0, 0, 0, 0),
        UDim2.new(1, 0, 1, 0)
    )

    sectionLabel.TextXAlignment = Enum.TextXAlignment.Center
    sectionLabel.TextColor3 = C.Gray
    sectionLabel.Font = Enum.Font.GothamBold

    return row
end

local function CreateButton(pageName, text, callback)
    local page = Pages[pageName]
    if not page then return end

    local button = Create("TextButton", {
        Name = "Button_" .. text,
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = C.White,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(button, 7)
    Outline(button, C.Border, 1)

    button.MouseEnter:Connect(function()
        Tween(button, { BackgroundColor3 = C.Hover })
    end)

    button.MouseLeave:Connect(function()
        Tween(button, { BackgroundColor3 = C.Element })
    end)

    button.Activated:Connect(function()
        if callback then callback() end
    end)

    return button
end

local function CreateToggle(pageName, text, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    local state = defaultValue == true

    local row = Create("Frame", {
        Name = "Toggle_" .. text,
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    Label(row, text, 11, UDim2.fromOffset(10, 0), UDim2.new(1, -60, 1, 0))

    local track = Create("Frame", {
        Size = UDim2.fromOffset(36, 20),
        Position = UDim2.new(1, -45, 0.5, -10),
        BackgroundColor3 = state and C.Blue or Color3.fromRGB(48, 48, 48),
        BorderSizePixel = 0
    }, row)

    Round(track, 20)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0
    }, track)

    Round(knob, 20)

    local hitbox = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, row)

    local function SetState(value, fireCallback)
        state = value == true
        Tween(track, { BackgroundColor3 = state and C.Blue or Color3.fromRGB(48, 48, 48) })
        Tween(knob, { Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) })
        if fireCallback and callback then callback(state) end
    end

    hitbox.Activated:Connect(function()
        SetState(not state, true)
    end)

    return {
        Get = function() return state end,
        Set = function(value) SetState(value, true) end
    }
end

local function CreateSlider(pageName, text, minValue, maxValue, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    minValue = tonumber(minValue) or 0
    maxValue = tonumber(maxValue) or 100
    if maxValue < minValue then minValue, maxValue = maxValue, minValue end

    local value = math.clamp(tonumber(defaultValue) or minValue, minValue, maxValue)

    local row = Create("Frame", {
        Name = "Slider_" .. text,
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    Label(row, text, 11, UDim2.fromOffset(10, 2), UDim2.new(1, -65, 0, 23))

    local valueLabel = Label(row, tostring(value), 11, UDim2.new(1, -50, 0, 2), UDim2.fromOffset(40, 23))
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Create("Frame", {
        Position = UDim2.new(0, 10, 0, 39),
        Size = UDim2.new(1, -20, 0, 5),
        BackgroundColor3 = Color3.fromRGB(48, 48, 48),
        BorderSizePixel = 0
    }, row)

    Round(track, 10)

    local fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = C.Blue,
        BorderSizePixel = 0
    }, track)

    Round(fill, 10)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(13, 13),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0,
        ZIndex = 2
    }, track)

    Round(knob, 20)

    local dragging = false

    local function SetValue(newValue, fireCallback)
        value = math.clamp(math.floor((tonumber(newValue) or minValue) + 0.5), minValue, maxValue)
        local ratio = maxValue == minValue and 0 or (value - minValue) / (maxValue - minValue)

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        if fireCallback and callback then callback(value) end
    end

    local function UpdateFromInput(input)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
        SetValue(minValue + (maxValue - minValue) * ratio, true)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromInput(input)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromInput(input)
        end
    end)

    local moveConnection = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            UpdateFromInput(input)
        end
    end)

    local endConnection = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    row.Destroying:Connect(function()
        moveConnection:Disconnect()
        endConnection:Disconnect()
    end)

    SetValue(value, false)

    return {
        Get = function() return value end,
        Set = function(newValue) SetValue(newValue, true) end
    }
end

local function CreateDropdown(pageName, text, options, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    options = options or {}
    local selected = defaultValue or options[1]
    local expanded = false

    local row = Create("Frame", {
        Name = "Dropdown_" .. text,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    local header = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, row)

    Label(header, text, 11, UDim2.fromOffset(10, 0), UDim2.new(0.52, -10, 1, 0))

    local selectedLabel = Label(header, selected and tostring(selected) or "Selecionar", 10, UDim2.new(0.52, 0, 0, 0), UDim2.new(0.48, -30, 1, 0))
    selectedLabel.TextColor3 = selected and C.White or C.Gray
    selectedLabel.TextXAlignment = Enum.TextXAlignment.Right

    local arrow = Label(header, "⌄", 15, UDim2.new(1, -27, 0, 0), UDim2.fromOffset(18, 35))
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    local optionButtons = {}

    local function SetExpanded(open)
        expanded = open
        row.Size = UDim2.new(1, 0, 0, expanded and (38 + #options * 28) or 36)
        arrow.Text = expanded and "⌃" or "⌄"
        for _, button in ipairs(optionButtons) do button.Visible = expanded end
    end

    for index, option in ipairs(options) do
        local optionButton = Create("TextButton", {
            Name = "Option" .. index,
            Position = UDim2.new(0, 6, 0, 38 + (index - 1) * 28),
            Size = UDim2.new(1, -12, 0, 26),
            BackgroundColor3 = C.Content,
            BorderSizePixel = 0,
            Text = tostring(option),
            TextColor3 = C.White,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false,
            Visible = false
        }, row)

        Round(optionButton, 5)

        optionButton.Activated:Connect(function()
            selected = option
            selectedLabel.Text = tostring(option)
            selectedLabel.TextColor3 = C.White
            SetExpanded(false)
            if callback then callback(option) end
        end)

        table.insert(optionButtons, optionButton)
    end

    header.Activated:Connect(function()
        SetExpanded(not expanded)
    end)

    if selected and callback then
        task.spawn(function() callback(selected) end)
    end

    return {
        Get = function() return selected end,
        Set = function(option)
            for _, available in ipairs(options) do
                if available == option then
                    selected = option
                    selectedLabel.Text = tostring(option)
                    selectedLabel.TextColor3 = C.White
                    if callback then callback(option) end
                    return true
                end
            end
            return false
        end
    }
end

-- =========================================================================
-- 🔪 SISTEMA BLINDADO: THROW KNIFE (INDEPENDENTE)
-- =========================================================================

-- Função para Criar e Executar o Throw Knife
function CreateThrowButton()
    if ThrowButtonGui then return end
    
    local ParentGui = CoreGui
    pcall(function() if not CoreGui then ParentGui = LocalPlayer:WaitForChild("PlayerGui") end end)
    
    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "Murderer_ThrowKnifeGui"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = ParentGui
    
    local Btn = Instance.new("ImageButton")
    Btn.AnchorPoint = Vector2.new(0.5, 0.5)
    Btn.Position = UDim2.new(0.5, 0, 0.35, 0)
    Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Btn.BackgroundTransparency = 0.4
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.Parent = GuiBtn
    
    currentThrowBtnRef = Btn
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn
    currentThrowCornerRef = Corner
    
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(39, 40, 48) -- Linha preta padrão
    Borda.Thickness = 1.5
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn
    currentThrowStrokeRef = Borda
    
    local Texto = Instance.new("TextLabel")
    Texto.Name = "ThrowText"
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.Text = "Throw Knife"
    Texto.TextColor3 = Color3.fromRGB(245, 245, 245)
    Texto.Font = Enum.Font.GothamBold
    Texto.TextSize = 13
    Texto.Parent = Btn
    
    -- Aplicar tamanho retangular
    Btn.Size = UDim2.new(0, tamanhoThrowBase or 150, 0, (tamanhoThrowBase or 150) / 2.5)
    
    -- Função interna para achar jogador mais próximo
    local function ObterAlvoProximo()
        local myChar = LocalPlayer and LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil, nil end
        local myHRP = myChar.HumanoidRootPart
        
        local menorDistancia = math.huge
        local melhorAlvo = nil
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                if p.Character.Humanoid.Health > 0 then
                    local targetHRP = p.Character.HumanoidRootPart
                    local dist = (myHRP.Position - targetHRP.Position).Magnitude
                    if dist < menorDistancia then
                        menorDistancia = dist
                        melhorAlvo = targetHRP
                    end
                end
            end
        end
        
        if melhorAlvo then
            return melhorAlvo.CFrame + Vector3.new(0, 0.5, 0), melhorAlvo.CFrame
        end
        return nil, nil
    end

    -- Função interna para executar o arremesso ao clicar
    local function LancarFaca()
        local Char = LocalPlayer and LocalPlayer.Character
        local knife = Char and (Char:FindFirstChild("Knife") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Knife")))
        
        -- Se NÃO tiver a faca equipada/mochila: Aviso em vermelho por 1s
        if not knife then
            Texto.Text = "Not Murderer"
            Btn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            Borda.Color = Color3.fromRGB(255, 60, 60)
            
            task.delay(1, function()
                if Texto and Texto.Parent and Btn and Borda then
                    Texto.Text = "Throw Knife"
                    Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    Borda.Color = Color3.fromRGB(39, 40, 48)
                end
            end)
            return
        end

        -- Se TIVER a faca: faz o equip e executa o evento
        if knife:FindFirstChild("Events") and knife.Events:FindFirstChild("KnifeThrown") then
            if knife.Parent ~= Char then
                knife.Parent = Char
                task.wait(0.02)
            end

            local posDirecao, posExata = ObterAlvoProximo()
            if posDirecao and posExata then
                pcall(function()
                    knife.Events.KnifeThrown:FireServer(posDirecao, posExata)
                end)
            end
        end
    end

    -- Loop de verificação de cor da borda (Verde se for Murderer)
    task.spawn(function()
        while ThrowButtonGui and Btn and Texto and Borda do
            if Texto.Text ~= "Not Murderer" then
                local Char = LocalPlayer and LocalPlayer.Character
                local temFaca = Char and (Char:FindFirstChild("Knife") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Knife")))
                if temFaca then
                    Borda.Color = Color3.fromRGB(60, 220, 100)
                else
                    Borda.Color = Color3.fromRGB(39, 40, 48)
                end
            end
            task.wait(0.4)
        end
    end)
    
    -- Arrastar e clicar no botão
    local dragStart, startPos
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingThrow = false
            dragStart = input.Position
            startPos = Btn.AbsolutePosition
        end
    end)
    
    Btn.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) and dragStart then
            local delta = input.Position - dragStart
            if delta.Magnitude > 10 then
                isDraggingThrow = true
                Btn.Position = UDim2.new(0, startPos.X + delta.X + (Btn.AbsoluteSize.X / 2), 0, startPos.Y + delta.Y + (Btn.AbsoluteSize.Y / 2))
            end
        end
    end)
    
    Btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not isDraggingThrow then
                LancarFaca()
            end
            dragStart = nil
            isDraggingThrow = false
        end
    end)
    
    ThrowButtonGui = GuiBtn
end

-- =========================================================================
-- 🗡️ SISTEMA COMPLETO DO BOTÃO FLUTUANTE KILL ALL
-- =========================================================================

-- Função para checar se o jogador tem a faca (é o Murderer)
local function PlayerTemFaca()
    local Char = LocalPlayer and LocalPlayer.Character
    if not Char then return false end
    if Char:FindFirstChild("Knife") then return true end
    if LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Knife") then return true end
    return false
end

-- ⚔️ EXECUTAR ATAQUE DE FACA
local function ExecutarAtaque(Alvo)
    local Char = LocalPlayer and LocalPlayer.Character
    if not Char then return end
    
    local Faca = Char:FindFirstChild("Knife") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Knife"))
    if not Faca then return end
    
    if Faca.Parent ~= Char then 
        Faca.Parent = Char 
        task.wait(0.02) 
    end
    
    local Eventos = Faca:FindFirstChild("Events")
    if not Eventos then return end

    if Alvo and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
        pcall(function()
            Eventos.KnifeStabbed:FireServer()
            Eventos.HandleTouched:FireServer(Alvo.Character.Head)
        end)
    end
end

-- Função do Botão Flutuante (Clique Instantâneo)
local function KillAllInstantaneo(TextoLabel)
    if not PlayerTemFaca() then
        if TextoLabel and currentKillAllBtnRef then
            TextoLabel.Text = "Not Murderer"
            currentKillAllBtnRef.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            if currentKillAllStrokeRef then
                currentKillAllStrokeRef.Color = Color3.fromRGB(255, 60, 60)
            end
            
            task.delay(1, function()
                if TextoLabel and TextoLabel.Parent and currentKillAllBtnRef and currentKillAllStrokeRef then
                    TextoLabel.Text = "Kill All"
                    currentKillAllBtnRef.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    currentKillAllStrokeRef.Color = Color3.fromRGB(39, 40, 48)
                end
            end)
        end
        return
    end

    for _, Alvo in ipairs(Players:GetPlayers()) do
        if Alvo ~= LocalPlayer and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
            ExecutarAtaque(Alvo)
        end
    end
end

-- Aplicar Formato do Botão Flutuante
local function AplicarFormatoKillAll()
    if not currentKillAllBtnRef or not currentKillAllCornerRef then return end
    local val = tamanhoKillAllBase
    if formatoKillAllAtual == "Retangulo" then
        currentKillAllBtnRef.Size = UDim2.new(0, val, 0, val / 2.5)
        currentKillAllCornerRef.CornerRadius = UDim.new(0, 8)
    end
end

-- Criar o Botão Flutuante Kill All (DECLARADA ANTES DE USAR NO TOGGLE)
function CreateKillAllButton()
