local function CopiarPosicaoAtualParaClipboard()
    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not hrp then
        -- Tenta notificar ou avisar que o personagem não foi encontrado
        return
    end

    -- Descobre o nome do mapa atual através do CoinContainer
    local mapName = "Desconhecido"
    local coinContainer = workspace:FindFirstChild("CoinContainer", true)
    if coinContainer and coinContainer.Parent then
        mapName = coinContainer.Parent.Name
    end

    local pos = hrp.Position
    -- Formata exatamente no padrão da tabela MAP_SAFE_POSITIONS
    local resultadoFormatado = string.format('["%s"] = Vector3.new(%.2f, %.2f, %.2f),', mapName, pos.X, pos.Y, pos.Z)

    -- Envia para a área de transferência do executor
    if setclipboard then
        setclipboard(resultadoFormatado)
        print("[NyxHub] Posição copiada para o clipboard: " .. resultadoFormatado)
    else
        warn("[NyxHub] O teu executor não suporta setclipboard().")
    end
end

