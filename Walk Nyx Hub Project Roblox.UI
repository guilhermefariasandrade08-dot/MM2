local function CreateSection(pageName, text)
    local page = Pages[pageName]
    if not page then return end

    local row = Create("Frame", {
        Name = "Section_" .. text,
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    local sectionLabel = Label(
        row,
        text,
        11,
        UDim2.new(0, 0, 0, 0),
        UDim2.new(1, 0, 1, 0)
    )

    sectionLabel.TextXAlignment = Enum.TextXAlignment.Center
    sectionLabel.TextColor3 = C.Gray
    sectionLabel.Font = Enum.Font.GothamBold

    return row
end

local function CreateButton(pageName, text, callback)
    local page = Pages[pageName]
    if not page then return end

    local button = Create("TextButton", {
        Name = "Button_" .. text,
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = C.White,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(button, 7)
    Outline(button, C.Border, 1)

    button.MouseEnter:Connect(function()
        Tween(button, { BackgroundColor3 = C.Hover })
    end)

    button.MouseLeave:Connect(function()
        Tween(button, { BackgroundColor3 = C.Element })
    end)

    button.Activated:Connect(function()
        if callback then callback() end
    end)

    return button
end

local function CreateToggle(pageName, text, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    local state = defaultValue == true

    local row = Create("Frame", {
        Name = "Toggle_" .. text,
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    Label(row, text, 11, UDim2.fromOffset(10, 0), UDim2.new(1, -60, 1, 0))

    local track = Create("Frame", {
        Size = UDim2.fromOffset(36, 20),
        Position = UDim2.new(1, -45, 0.5, -10),
        BackgroundColor3 = state and C.Blue or Color3.fromRGB(48, 48, 48),
        BorderSizePixel = 0
    }, row)

    Round(track, 20)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0
    }, track)

    Round(knob, 20)

    local hitbox = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, row)

    local function SetState(value, fireCallback)
        state = value == true
        Tween(track, { BackgroundColor3 = state and C.Blue or Color3.fromRGB(48, 48, 48) })
        Tween(knob, { Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) })
        if fireCallback and callback then callback(state) end
    end

    hitbox.Activated:Connect(function()
        SetState(not state, true)
    end)

    return {
        Get = function() return state end,
        Set = function(value) SetState(value, true) end
    }
end

local function CreateSlider(pageName, text, minValue, maxValue, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    minValue = tonumber(minValue) or 0
    maxValue = tonumber(maxValue) or 100
    if maxValue < minValue then minValue, maxValue = maxValue, minValue end

    local value = math.clamp(tonumber(defaultValue) or minValue, minValue, maxValue)

    local row = Create("Frame", {
        Name = "Slider_" .. text,
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    Label(row, text, 11, UDim2.fromOffset(10, 2), UDim2.new(1, -65, 0, 23))

    local valueLabel = Label(row, tostring(value), 11, UDim2.new(1, -50, 0, 2), UDim2.fromOffset(40, 23))
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Create("Frame", {
        Position = UDim2.new(0, 10, 0, 39),
        Size = UDim2.new(1, -20, 0, 5),
        BackgroundColor3 = Color3.fromRGB(48, 48, 48),
        BorderSizePixel = 0
    }, row)

    Round(track, 10)

    local fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = C.Blue,
        BorderSizePixel = 0
    }, track)

    Round(fill, 10)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(13, 13),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0,
        ZIndex = 2
    }, track)

    Round(knob, 20)

    local dragging = false

    local function SetValue(newValue, fireCallback)
        value = math.clamp(math.floor((tonumber(newValue) or minValue) + 0.5), minValue, maxValue)
        local ratio = maxValue == minValue and 0 or (value - minValue) / (maxValue - minValue)

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        if fireCallback and callback then callback(value) end
    end

    local function UpdateFromInput(input)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
        SetValue(minValue + (maxValue - minValue) * ratio, true)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromInput(input)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromInput(input)
        end
    end)

    local moveConnection = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            UpdateFromInput(input)
        end
    end)

    local endConnection = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    row.Destroying:Connect(function()
        moveConnection:Disconnect()
        endConnection:Disconnect()
    end)

    SetValue(value, false)

    return {
        Get = function() return value end,
        Set = function(newValue) SetValue(newValue, true) end
    }
end

local function CreateDropdown(pageName, text, options, defaultValue, callback)
    local page = Pages[pageName]
    if not page then return end

    options = options or {}
    local selected = defaultValue or options[1]
    local expanded = false

    local row = Create("Frame", {
        Name = "Dropdown_" .. text,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        LayoutOrder = #page:GetChildren()
    }, page)

    Round(row, 7)
    Outline(row, C.Border, 1)

    local header = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, row)

    Label(header, text, 11, UDim2.fromOffset(10, 0), UDim2.new(0.52, -10, 1, 0))

    local selectedLabel = Label(header, selected and tostring(selected) or "Selecionar", 10, UDim2.new(0.52, 0, 0, 0), UDim2.new(0.48, -30, 1, 0))
    selectedLabel.TextColor3 = selected and C.White or C.Gray
    selectedLabel.TextXAlignment = Enum.TextXAlignment.Right

    local arrow = Label(header, "⌄", 15, UDim2.new(1, -27, 0, 0), UDim2.fromOffset(18, 35))
    arrow.TextXAlignment = Enum.TextXAlignment.Center

    local optionButtons = {}

    local function SetExpanded(open)
        expanded = open
        row.Size = UDim2.new(1, 0, 0, expanded and (38 + #options * 28) or 36)
        arrow.Text = expanded and "⌃" or "⌄"
        for _, button in ipairs(optionButtons) do button.Visible = expanded end
    end

    for index, option in ipairs(options) do
        local optionButton = Create("TextButton", {
            Name = "Option" .. index,
            Position = UDim2.new(0, 6, 0, 38 + (index - 1) * 28),
            Size = UDim2.new(1, -12, 0, 26),
            BackgroundColor3 = C.Content,
            BorderSizePixel = 0,
            Text = tostring(option),
            TextColor3 = C.White,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false,
            Visible = false
        }, row)

        Round(optionButton, 5)

        optionButton.Activated:Connect(function()
            selected = option
            selectedLabel.Text = tostring(option)
            selectedLabel.TextColor3 = C.White
            SetExpanded(false)
            if callback then callback(option) end
        end)

        table.insert(optionButtons, optionButton)
    end

    header.Activated:Connect(function()
        SetExpanded(not expanded)
    end)

    if selected and callback then
        task.spawn(function() callback(selected) end)
    end

    return {
        Get = function() return selected end,
        Set = function(option)
            for _, available in ipairs(options) do
                if available == option then
                    selected = option
                    selectedLabel.Text = tostring(option)
                    selectedLabel.TextColor3 = C.White
                    if callback then callback(option) end
                    return true
                end
            end
            return false
        end
    }
end

--==============================================================--
-- 12. SISTEMA DE CARGOS COMPARTILHADO (MM2)
--==============================================================--

local DadosCargos = {}
local UltimaChecagemCargo = 0

local function PegarCargos()
    if tick() - UltimaChecagemCargo < 2 then return end
    UltimaChecagemCargo = tick()
    
    task.spawn(function()
        local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if not R then return end
        
        local ok, d = pcall(function() 
            return R:InvokeServer() 
        end)
        
        if ok and d then 
            DadosCargos = d 
        end
    end)
end

local function ObterCorCargo(nomeJogador)
    local Info = DadosCargos[nomeJogador]
    local Cor = Color3.fromRGB(255, 255, 255)
    
    if Info and not Info.Killed and not Info.Dead then
        if Info.Role == "Murderer" then
            Cor = Color3.fromRGB(220, 50, 50)
        elseif Info.Role == "Sheriff" then
            Cor = Color3.fromRGB(0, 85, 255)
        elseif Info.Role == "Hero" then
            Cor = Color3.fromRGB(255, 215, 0)
        elseif Info.Role == "Innocent" then
            Cor = Color3.fromRGB(60, 200, 80)
        end
    end
    
    return Cor
end

